<UserControl x:Class="DraftAssistant.Presentation.Pages.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Настройка" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="14" Margin="0,6,0,24"
                       Text="Почти всё работает само. Здесь — состояние распознавания и связь с Dota." />

            <!-- Распознавание экрана -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="РАСПОЗНАВАНИЕ ЭКРАНА" Style="{StaticResource Caps}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <Ellipse x:Name="ScreenDot" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ScreenTitle" Style="{StaticResource H2}" FontSize="20" />
                    </StackPanel>
                    <TextBlock x:Name="ScreenDetail" Style="{StaticResource MutedText}" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="ResetManualButton" Content="Вернуть автоматический режим" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="OnResetManual" />
                        <Button Content="Ручная калибровка (для нестандартных экранов)" Style="{StaticResource GhostButton}" Click="OnManualCalibration" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- GSI -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="СВЯЗЬ С DOTA (GSI)" Style="{StaticResource Caps}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <Ellipse x:Name="GsiDot" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="GsiTitle" Style="{StaticResource H2}" FontSize="20" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                               Text="Официальный канал Valve: Dota сама сообщает приложению, за какую команду вы играете и когда вы выбрали героя — после этого окошко подсказок скрывается." />
                    <Button x:Name="InstallGsiButton" Content="Настроить в один клик" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Click="OnInstallGsi" />
                    <TextBlock x:Name="GsiInstallResult" Style="{StaticResource MutedText}" Margin="0,8,0,0" />

                    <Border Height="1" Background="{StaticResource Line}" Margin="0,16" />
                    <TextBlock Text="Один раз добавьте параметр запуска в Steam:" FontSize="14" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                               Text="Библиотека → правой кнопкой по Dota 2 → Свойства → Общие → Параметры запуска" />
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,10,0" Background="{StaticResource Panel}">
                            <TextBlock Text="-gamestateintegration" FontFamily="Consolas" FontSize="14" />
                        </Border>
                        <Button Content="Скопировать" Style="{StaticResource GhostButton}" Click="OnCopyLaunchOption" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"
                               Text="После этого перезапустите Dota. Статус выше станет зелёным, когда Dota начнёт присылать данные (в лобби или матче)." />
                </StackPanel>
            </Border>

            <!-- Ник -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="ВАШ НИК В DOTA" Style="{StaticResource Caps}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,10"
                               Text="Нужен, только если GSI не настроен: по нику приложение находит ваш слот и вашу позицию в рейтинге." />
                    <Border Width="320" HorizontalAlignment="Left" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Background="{StaticResource Panel}" Padding="12,0">
                        <TextBox x:Name="NicknameBox" Style="{StaticResource SearchBox}" Height="36" LostFocus="OnNicknameChanged"
                                 AutomationProperties.Name="Ваш ник в Dota" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Отладка -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ЕСЛИ ЧТО-ТО РАСПОЗНАЁТСЯ НЕ ТАК" Style="{StaticResource Caps}" />
                    <CheckBox x:Name="DebugFramesBox" Foreground="{StaticResource Text}" Margin="0,10,0,10" Checked="OnDebugFramesChanged" Unchecked="OnDebugFramesChanged">
                        <TextBlock Text="Сохранять 2 кадра каждого драфта на компьютере (никуда не отправляются)" FontSize="14" TextWrapping="Wrap" />
                    </CheckBox>
                    <Button Content="Открыть папку с кадрами" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnOpenDebugFolder" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
