<UserControl x:Class="DraftAssistant.Presentation.Pages.OverlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Оверлей" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="14" Margin="0,6,0,24"
                       Text="Окошко с тремя лучшими героями появляется во время драфта поверх Dota. Положение можно задать здесь или перетащить прямо в игре." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="2*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- Превью экрана 16:9 -->
                <StackPanel>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Background="#101318" ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="1920" Height="1080">
                                <Border Canvas.Left="520" Canvas.Top="0" Width="880" Height="104" BorderBrush="#2A323D" BorderThickness="2">
                                    <TextBlock Text="Верхняя панель Dota" Foreground="#4A5562" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Canvas.Left="180" Canvas.Top="170" Width="1240" Height="700" BorderBrush="#2A323D" BorderThickness="2">
                                    <TextBlock Text="Сетка героев" Foreground="#4A5562" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Canvas.Left="{Binding PreviewLeft}" Canvas.Top="{Binding PreviewTop}" Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}"
                                        BorderBrush="{StaticResource Accent}" BorderThickness="3" CornerRadius="10" Background="#F009090B">
                                    <StackPanel Margin="20">
                                        <TextBlock Text="ТОП-3 · POS" FontFamily="{StaticResource HeadFont}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,0,0,16" />
                                        <Border Height="52" Background="#1A1A1F" CornerRadius="4" Margin="0,0,0,12" />
                                        <Border Height="52" Background="#1A1A1F" CornerRadius="4" Margin="0,0,0,12" />
                                        <Border Height="52" Background="#1A1A1F" CornerRadius="4" />
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <WrapPanel Margin="0,12,0,0">
                        <TextBlock Text="Быстро в угол:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="↖ слева сверху" Style="{StaticResource GhostButton}" Command="{Binding Corner}" CommandParameter="tl" Margin="0,0,8,0" />
                        <Button Content="↗ справа сверху" Style="{StaticResource GhostButton}" Command="{Binding Corner}" CommandParameter="tr" Margin="0,0,8,0" />
                        <Button Content="↙ слева снизу" Style="{StaticResource GhostButton}" Command="{Binding Corner}" CommandParameter="bl" Margin="0,0,8,0" />
                        <Button Content="↘ справа снизу" Style="{StaticResource GhostButton}" Command="{Binding Corner}" CommandParameter="br" />
                    </WrapPanel>
                    <Button Content="Двигать окошко в игре  ·  Ctrl+Shift+D" Style="{StaticResource AccentButton}" Command="{Binding ToggleMove}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>

                <!-- Настройки -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="КОГДА ПОКАЗЫВАТЬ" Style="{StaticResource Caps}" Margin="0,0,0,12" />
                            <RadioButton GroupName="When" IsChecked="{Binding UntilMyPick}" Foreground="{StaticResource Text}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Во время пиков, до выбора вашего героя" FontSize="14" />
                                    <TextBlock Text="Скрывается сразу после вашего пика" Style="{StaticResource MutedText}" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="When" IsChecked="{Binding WholeDraft}" Foreground="{StaticResource Text}">
                                <TextBlock Text="Весь драфт, включая баны" FontSize="14" />
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ВИД" Style="{StaticResource Caps}" Margin="0,0,0,12" />
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="Size" Content=" S " IsChecked="{Binding SizeS}" />
                                    <RadioButton Style="{StaticResource Chip}" GroupName="Size" Content=" M " IsChecked="{Binding SizeM}" />
                                    <RadioButton Style="{StaticResource Chip}" GroupName="Size" Content=" L " IsChecked="{Binding SizeL}" Margin="0" />
                                </StackPanel>
                                <TextBlock Text="Размер" FontSize="14" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding OpacityText}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="Непрозрачность фона" FontSize="14" />
                            </DockPanel>
                            <Slider Minimum="40" Maximum="100" Value="{Binding Opacity}" Margin="0,8,0,14" AutomationProperties.Name="Непрозрачность фона" />
                            <CheckBox IsChecked="{Binding ShowReasons}" Foreground="{StaticResource Text}">
                                <TextBlock Text="Показывать причины под героем" FontSize="14" />
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" Style="{StaticResource Caps}" Margin="0,0,0,12" />
                            <DockPanel Margin="0,0,0,8">
                                <Border DockPanel.Dock="Right" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="Ctrl+Shift+D" FontFamily="{StaticResource HeadFont}" />
                                </Border>
                                <TextBlock Text="Двигать окошко в игре" FontSize="14" />
                            </DockPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="Ctrl+Shift+O" FontFamily="{StaticResource HeadFont}" />
                                </Border>
                                <TextBlock Text="Скрыть / показать" FontSize="14" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="Сбросить положение" Style="{StaticResource GhostButton}" Command="{Binding Reset}" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
