<UserControl x:Class="DraftAssistant.Presentation.Pages.HeroesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DraftAssistant.Presentation.Pages"
             xmlns:common="clr-namespace:DraftAssistant.Presentation.Common"
             Focusable="True">
    <UserControl.Resources>
        <common:RatioConverter x:Key="Ratio" />
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:HeroTile}">
            <Grid x:Name="Root" Margin="2.5" Background="#16161A" ClipToBounds="True" Cursor="Hand"
                  Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource Ratio}, ConverterParameter=0.75}" MouseEnter="OnTileEnter"
                  ToolTip="{Binding Name}">
                <Image Source="{Binding Portrait}" Stretch="UniformToFill" />
                <Border VerticalAlignment="Bottom" Height="28">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0009090B" Offset="0" />
                            <GradientStop Color="#E609090B" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Bottom" Margin="5,0,5,4" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="#E6E6EA" TextTrimming="CharacterEllipsis" />
                <Border x:Name="Frame" BorderBrush="{StaticResource Line}" BorderThickness="1" />
                <!-- Подсветка найденного героя (мерцает) -->
                <Border x:Name="Glow" BorderBrush="{StaticResource Accent}" BorderThickness="2" Opacity="0" IsHitTestVisible="False">
                    <Border.Background>
                        <SolidColorBrush Color="#E5383B" Opacity="0.12" />
                    </Border.Background>
                </Border>

                <Border x:Name="MainBadge" Visibility="Collapsed" Width="16" Height="16" CornerRadius="3" Background="{StaticResource Accent}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4">
                    <Path Data="{StaticResource IconStar}" Fill="#09090B" Stretch="Uniform" Width="10" Height="10" />
                </Border>
                <Path x:Name="LikeBadge" Visibility="Collapsed" Data="{StaticResource IconHeart}" Fill="{StaticResource Accent}" Stretch="Uniform"
                      Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" />

                <!-- Затемнение не найденных при поиске: плавно, через анимацию прозрачности -->
                <Border x:Name="Shade" Background="#09090B" Opacity="0" IsHitTestVisible="False" />

                <Grid x:Name="HoverPanel" Visibility="Collapsed" Background="#B309090B">
                    <!-- Кнопки уменьшаются вместе с плиткой и не вылезают за её края -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="3">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Command="{Binding SetMain}" ToolTip="Основной" AutomationProperties.Name="Сделать основным">
                            <Path Data="{StaticResource IconStar}" Fill="{StaticResource Accent}" Stretch="Uniform" Width="12" Height="12" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding SetLike}" ToolTip="Нравится" AutomationProperties.Name="Нравится">
                            <Path Data="{StaticResource IconHeart}" Stroke="{StaticResource Text}" StrokeThickness="2" Stretch="Uniform" Width="12" Height="12" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding SetBan}" ToolTip="Не играю" AutomationProperties.Name="Не играю">
                            <Path Data="{StaticResource IconBan}" Stroke="{StaticResource Text}" StrokeThickness="2" Stretch="Uniform" Width="12" Height="12" />
                        </Button>
                    </StackPanel>
                    </Viewbox>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLike}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter TargetName="LikeBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMain}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                    <Setter TargetName="MainBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBan}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.28" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity"
                                                 To="0.84" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="1" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.35" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="HoverPanel" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Root" Property="Opacity" Value="1" />
                    <Setter TargetName="Shade" Property="Visibility" Value="Collapsed" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок и счётчики -->
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Border BorderBrush="#2A1517" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconStar}" Fill="{StaticResource Accent}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding MainName}" FontSize="13" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconHeart}" Stroke="{StaticResource Accent}" StrokeThickness="2" Stretch="Uniform" Width="13" Height="13" Margin="0,0,8,0" />
                        <TextBlock FontSize="13"><Run Text="Нравятся: " /><Run Text="{Binding LikeCount, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconBan}" Stroke="{StaticResource Muted}" StrokeThickness="2" Stretch="Uniform" Width="13" Height="13" Margin="0,0,8,0" />
                        <TextBlock FontSize="13" Foreground="{StaticResource Muted}"><Run Text="Не играю: " /><Run Text="{Binding BanCount, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Герои" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource MutedText}" FontSize="14" Margin="0,6,0,0"
                           Text="Отметьте 5–7 своих героев (★ основной, ♥ играю) — в драфте подсказка выберет лучшего из них против врагов и к союзникам. Ничего не отмечено — из всех героев. Поиск: просто печатайте имя." TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Поиск и фильтр по ролям -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
            <Border Width="300" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Background="{StaticResource Panel}" Padding="12,0" Margin="0,0,14,0">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Data="{StaticResource IconSearch}" Stroke="{StaticResource Muted}" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Height="36" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Поиск героя" />
                </DockPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding RoleFilters}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource Chip}" GroupName="RoleFilter" Content="{Binding Label}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="OnRoleChecked" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- Сетка 2×2 по атрибутам -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,14,18" VerticalAlignment="Top">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,8">
                                    <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Dot}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caps}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Heroes}" ItemTemplate="{StaticResource TileTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="8" VerticalAlignment="Top" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Карточка наведённого героя -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Border Height="140" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" ClipToBounds="True" Background="#16161A">
                        <Image Source="{Binding HoverPortrait}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{Binding HoverName}" Style="{StaticResource H2}" FontSize="24" Margin="0,14,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding HoverRoles}" Style="{StaticResource MutedText}" Margin="0,4,0,14" />
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14" />
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding HoverMark}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Ваша отметка" Style="{StaticResource MutedText}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding HoverFit}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding HoverFitLabel}" Style="{StaticResource MutedText}" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding HoverWinrate}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="WR в патче (Legend+)" Style="{StaticResource MutedText}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
