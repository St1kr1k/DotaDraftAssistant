<UserControl x:Class="DraftAssistant.Presentation.Pages.PositionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Позиция" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="14" Margin="0,6,0,24"
                       Text="Основная позиция определяет рекомендации. Запасная используется, если основную занял союзник." />

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,16,0">
                            <Border x:Name="Card" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" Background="Transparent">
                                <StackPanel>
                                    <DockPanel Height="24" Margin="0,0,0,14">
                                        <Border x:Name="Badge" DockPanel.Dock="Right" Visibility="Collapsed" CornerRadius="4" Padding="8,3" BorderThickness="1" BorderBrush="{StaticResource Accent}">
                                            <TextBlock x:Name="BadgeText" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource Caps}" FontSize="13" VerticalAlignment="Center"><Run Text="POS " /><Run Text="{Binding Number, Mode=OneWay}" /></TextBlock>
                                    </DockPanel>

                                    <Border CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}"
                                            AutomationProperties.Name="{Binding MapLabel}">
                                        <Viewbox Stretch="Uniform">
                                            <Canvas Width="160" Height="160">
                                                <Path Data="M6,6 L154,154" Stroke="#1B2330" StrokeThickness="10" />
                                                <Path Data="M22,138 L22,22 L138,22" Stroke="{Binding TopBrush}" StrokeThickness="{Binding TopWidth}" StrokeLineJoin="Round" />
                                                <Path Data="M22,138 L138,22" Stroke="{Binding MidBrush}" StrokeThickness="{Binding MidWidth}" />
                                                <Path Data="M22,138 L138,138 L138,22" Stroke="{Binding BotBrush}" StrokeThickness="{Binding BotWidth}" StrokeLineJoin="Round" />
                                                <Rectangle Canvas.Left="12" Canvas.Top="128" Width="20" Height="20" RadiusX="3" RadiusY="3" Fill="{StaticResource Text}" />
                                                <Rectangle Canvas.Left="128" Canvas.Top="12" Width="20" Height="20" RadiusX="3" RadiusY="3" Fill="#3A3A42" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>

                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="24" Margin="0,16,0,4" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Height="38" />

                                    <UniformGrid Columns="2" Margin="0,14,0,0">
                                        <Button x:Name="MainBtn" Content="Основная" Style="{StaticResource GhostButton}" BorderBrush="{StaticResource Accent}"
                                                Command="{Binding MakeMain}" Margin="0,0,4,0" Padding="0,10" />
                                        <Button x:Name="SecBtn" Content="Запасная" Style="{StaticResource GhostButton}"
                                                Command="{Binding MakeSecondary}" Margin="4,0,0,0" Padding="0,10" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <!-- Пунктирная рамка запасной позиции -->
                            <Rectangle x:Name="Dashed" Visibility="Collapsed" RadiusX="12" RadiusY="12" Stroke="{StaticResource Accent}"
                                       StrokeThickness="1" StrokeDashArray="4 3" IsHitTestVisible="False" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMain}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Card" Property="Background" Value="#120708" />
                                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Badge" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="BadgeText" Property="Text" Value="ОСНОВНАЯ" />
                                <Setter TargetName="BadgeText" Property="Foreground" Value="#09090B" />
                                <Setter TargetName="MainBtn" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="MainBtn" Property="Foreground" Value="#09090B" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSecondary}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Dashed" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                                <Setter TargetName="BadgeText" Property="Text" Value="ЗАПАСНАЯ" />
                                <Setter TargetName="SecBtn" Property="Background" Value="#1A1A1F" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <UniformGrid Columns="3" Margin="0,28,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="ВАШ ОСНОВНОЙ ГЕРОЙ" Style="{StaticResource Caps}" />
                        <TextBlock Text="{Binding MainHero}" Style="{StaticResource H2}" FontSize="20" Margin="0,6,0,4" />
                        <TextBlock Text="Меняется в разделе «Герои»" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="{Binding PoolTitle}" Style="{StaticResource Caps}" />
                        <TextBlock Text="{Binding PoolValue}" Style="{StaticResource H2}" FontSize="20" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding PoolHint}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ВЛИЯНИЕ НА ОЦЕНКУ" Style="{StaticResource Caps}" />
                        <TextBlock Text="Role fit · 15%" Style="{StaticResource H2}" FontSize="20" Margin="0,6,0,4" />
                        <TextBlock Text="Герои не под позицию опускаются в списке" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
