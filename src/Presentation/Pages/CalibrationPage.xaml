<UserControl x:Class="DraftAssistant.Presentation.Pages.CalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="Калибровка" Style="{StaticResource H1}" />
        <TextBlock Style="{StaticResource MutedText}" FontSize="14" Margin="0,6,0,24"
                   Text="Приложение должно знать, где на вашем экране находятся слоты героев. Калибровка делается один раз для вашего разрешения." />

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <DockPanel>
                <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="Открыть калибровку" Style="{StaticResource AccentButton}"
                        VerticalAlignment="Center" Click="OnOpen" />
                <StackPanel>
                    <TextBlock Text="СОСТОЯНИЕ" Style="{StaticResource Caps}" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource H2}" FontSize="20" Margin="0,6,0,4" />
                    <TextBlock x:Name="DetailText" Style="{StaticResource MutedText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="КАК ОТКАЛИБРОВАТЬ" Style="{StaticResource Caps}" Margin="0,0,0,12" />
                <TextBlock Style="{StaticResource MutedText}" FontSize="14" Foreground="{StaticResource Text}" Margin="0,0,0,8"
                           Text="1. Зайдите в драфт (лобби или матч) или подготовьте скриншот экрана выбора героев." />
                <TextBlock Style="{StaticResource MutedText}" FontSize="14" Foreground="{StaticResource Text}" Margin="0,0,0,8"
                           Text="2. Нажмите «Открыть калибровку» → «Захватить окно Dota 2» или «Открыть скриншот»." />
                <TextBlock Style="{StaticResource MutedText}" FontSize="14" Foreground="{StaticResource Text}" Margin="0,0,0,8"
                           Text="3. Обведите 1-й и 5-й слоты Radiant, затем 1-й и 5-й слоты Dire. Остальные рассчитаются сами." />
                <TextBlock Style="{StaticResource MutedText}" FontSize="14" Foreground="{StaticResource Text}"
                           Text="4. Обведите статичный элемент экрана драфта (без таймера) — так драфт будет замечен сразу." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
