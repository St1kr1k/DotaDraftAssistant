<Window x:Class="DraftAssistant.Presentation.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dota Draft Assistant"
        Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False"
        FontFamily="Segoe UI" FontSize="12" Foreground="#E8E8E8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8FA3B8" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="#33445566" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="BorderBrush" Value="#55778899" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="6" Padding="10" BorderBrush="#4A6B8A" BorderThickness="1"
            Opacity="{Binding PanelOpacity}">
        <Border.Background>
            <SolidColorBrush Color="#E0101820" />
        </Border.Background>
        <StackPanel>
            <!-- Заголовок -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding RoleText}" FontWeight="Bold" Foreground="#F2C14E" />
                <TextBlock FontWeight="Bold" FontSize="13">
                    <Run Text="DRAFT ASSISTANT" /><Run Text=" " /><Run Text="{Binding VersionText, Mode=OneWay}" FontSize="9" FontWeight="Normal" Foreground="#6F7C8A" />
                </TextBlock>
            </DockPanel>
            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#9AA5B1" TextWrapping="Wrap" />
            <TextBlock Text="{Binding UpdateText}" FontSize="10" Foreground="#7AD07A" TextWrapping="Wrap"
                       Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
            <TextBlock FontSize="10" Foreground="#9AA5B1">
                <Run Text="{Binding Phase, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SideText, Mode=OneWay}" />
            </TextBlock>

            <!-- Панель интерактивного режима -->
            <Border Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVis}}"
                    Margin="0,8,0,0" Padding="6" CornerRadius="4" Background="#22FFFFFF">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="Настройки" Click="OnSettings" />
                        <Button Content="Калибровка" Click="OnCalibrate" />
                        <Button Content="Выход" Click="OnExit" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Сторона:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="SideBox" Width="110" SelectionChanged="OnSideChanged">
                            <ComboBoxItem Content="Авто" IsSelected="True" />
                            <ComboBoxItem Content="Radiant" />
                            <ComboBoxItem Content="Dire" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox Content="Learn mode (подробные объяснения)" Margin="0,6,0,0"
                              Foreground="#E8E8E8" IsChecked="{Binding LearnMode}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Прозрачность" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider Width="140" Minimum="0.3" Maximum="1" Value="{Binding PanelOpacity}" />
                    </StackPanel>
                    <TextBlock FontSize="10" Foreground="#9AA5B1" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Ctrl+Shift+D — интерактивный режим вкл/выкл · Ctrl+Shift+O — скрыть/показать" />
                </StackPanel>
            </Border>

            <!-- Драфт -->
            <StackPanel Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Header}" Text="{Binding FirstGroupTitle}" />
                <ItemsControl ItemsSource="{Binding FirstGroup}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="#8FA3B8" FontSize="10" />
                                <TextBlock Text="{Binding Text}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                                                    <Setter Property="Foreground" Value="#C08080" />
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Header}" Text="{Binding SecondGroupTitle}" />
                <ItemsControl ItemsSource="{Binding SecondGroup}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Рекомендации -->
            <TextBlock Style="{StaticResource Header}" Text="РЕКОМЕНДАЦИИ" />
            <ItemsControl ItemsSource="{Binding Recommendations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Score}" FontWeight="Bold" FontSize="14" Foreground="#F2C14E" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DeltaText}" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Foreground" Value="#E07A7A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDelta}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DeltaPositive}" Value="True">
                                                    <Setter Property="Foreground" Value="#7AD07A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontWeight="SemiBold" FontSize="13">
                                    <Run Text="{Binding Rank, Mode=OneWay}" /><Run Text=". " /><Run Text="{Binding Name, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Components}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="10" Foreground="#9AA5B1" Margin="0,0,8,0">
                                            <Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Value, Mode=OneWay}" Foreground="#D0D8E0" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Reasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#E07A7A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Positive}" Value="True">
                                                            <Setter Property="Foreground" Value="#9BD39B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
