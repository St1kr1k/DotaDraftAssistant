<Window x:Class="DraftAssistant.Presentation.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Draft Assistant — ваш профиль" Width="560" Height="640"
        WindowStartupLocation="CenterScreen" Topmost="True" FontFamily="Segoe UI">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                   Text="Здесь вводятся только ваши предпочтения. Пики, баны и роли соперников приложение определяет само по экрану." />

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Моя позиция:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="PositionBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value" />
            <TextBlock Grid.Column="2" Text="Запасная:" VerticalAlignment="Center" Margin="12,0,6,0" />
            <ComboBox x:Name="SecondaryBox" Grid.Column="3" DisplayMemberPath="Label" SelectedValuePath="Value" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorText" Foreground="Firebrick" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="Сохранить" Width="100" Margin="0,0,8,0" IsDefault="True" Click="OnSave" />
            <Button Content="Отмена" Width="100" IsCancel="True" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <CheckBox x:Name="OnlyMarked" DockPanel.Dock="Right" Content="Только отмеченные" VerticalAlignment="Center"
                      Margin="12,0,0,0" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="FilterBox" TextChanged="OnFilterChanged" />
        </DockPanel>

        <DataGrid x:Name="HeroGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Герой" Binding="{Binding Name}" IsReadOnly="True" Width="160" />
                <DataGridTextColumn Header="Роли" Binding="{Binding Roles}" IsReadOnly="True" Width="*" />
                <DataGridComboBoxColumn x:Name="PreferenceColumn" Header="Отношение" Width="150"
                                        DisplayMemberPath="Label" SelectedValuePath="Value"
                                        SelectedValueBinding="{Binding Preference, UpdateSourceTrigger=PropertyChanged}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
