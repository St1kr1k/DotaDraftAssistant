<Project Sdk="Microsoft.NET.Sdk">
  <!-- Infrastructure: WinAPI-захват, OpenCV, GSI, хранилища. Реализует порты application/domain. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>DraftAssistant.Infrastructure</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Domain\DraftAssistant.Domain.csproj" />
    <ProjectReference Include="..\Application\DraftAssistant.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="$(OpenCvSharpVersion)" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="$(OpenCvSharpVersion)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DraftAssistant.Tests" />
  </ItemGroup>
</Project>
