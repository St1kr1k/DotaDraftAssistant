<Window x:Class="DraftAssistant.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dota Draft Assistant — установка" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" Icon="app.ico"
        FontFamily="Segoe UI" Foreground="{StaticResource Text}">
    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="10"
            MouseLeftButtonDown="OnDrag">
        <StackPanel Margin="28,22,28,26">
            <!-- Заголовок -->
            <DockPanel Margin="0,0,0,22">
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource Ghost}" Padding="10,4" BorderBrush="Transparent"
                        Foreground="{StaticResource Muted}" Click="OnClose" ToolTip="Закрыть" />
                <Image Source="app.ico" Width="30" Height="30" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="Bahnschrift" FontSize="17" FontWeight="Bold">
                        <Run Text="DOTA DRAFT" /><Run Text=" · " Foreground="{StaticResource Accent}" /><Run Text="ASSISTANT" />
                    </TextBlock>
                    <TextBlock Text="Установка" FontSize="12" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>

            <!-- Выбор папки -->
            <StackPanel x:Name="ChoosePanel">
                <TextBlock Text="ПАПКА УСТАНОВКИ" FontFamily="Bahnschrift" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Изменить…" Style="{StaticResource Ghost}" Margin="10,0,0,0" Click="OnBrowse" />
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Background="{StaticResource Panel}" Padding="12,9">
                        <TextBlock x:Name="PathText" FontSize="13" TextTrimming="CharacterEllipsis" />
                    </Border>
                </DockPanel>
                <TextBlock Text="Обновления будут скачиваться и ставиться в эту же папку автоматически." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="WarningText" FontSize="12" Foreground="{StaticResource Warn}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="AppsLink" Margin="0,4,0,0" Visibility="Collapsed" FontSize="12">
                    <Hyperlink Foreground="{StaticResource Accent}" Click="OnOpenApps">Открыть «Приложения» Windows, чтобы удалить старую копию</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Прогресс -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" FontSize="14" Margin="0,0,0,10" />
                <Border Height="6" CornerRadius="3" Background="{StaticResource Line}">
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{StaticResource Accent}" />
                </Border>
                <TextBlock x:Name="DetailText" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource Ghost}" Margin="0,0,10,0" Click="OnClose" />
                <Button x:Name="InstallButton" Content="Установить" Style="{StaticResource Primary}" MinWidth="130" Click="OnInstall" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
