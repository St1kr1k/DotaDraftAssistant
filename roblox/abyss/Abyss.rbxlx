<Item class="Script" referent="RBX00000000000000000000000000000006"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- Сервер «В Бездну»: экономика, ступени, стражи, раскопки, звания, перерождение, сохранение.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local World = require(script:WaitForChild("World"))

type Data = Config.Data

--------------------------------------------------------------------------------
-- Хранилища
--------------------------------------------------------------------------------
local store: DataStore? = nil
local topStore: OrderedDataStore? = nil
do
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore("Abyss_v1")
		topStore = DataStoreService:GetOrderedDataStore("Abyss_Top_v1")
	end)
	if not ok then
		warn("DataStore недоступен:", err)
	end
end

--------------------------------------------------------------------------------
-- Remotes
--------------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remote(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end
local R = {
	BuyStep = remote("BuyStep"),
	BuyUp = remote("BuyUp"),
	BuyRUp = remote("BuyRUp"),
	Roll = remote("Roll"),
	Rebirth = remote("Rebirth"),
	Toggle = remote("Toggle"),
	Teleport = remote("Teleport"),
	Fight = remote("Fight"),
	Dig = remote("Dig"),
	State = remote("State"),
	Event = remote("Event"),
}
remotes.Parent = ReplicatedStorage

local world = World.build()

--------------------------------------------------------------------------------
-- Сессии
--------------------------------------------------------------------------------
type Fight = { layer: number, hp: number, maxHp: number, timeLeft: number }

type Session = {
	player: Player,
	data: Data,
	income: number,
	fight: Fight?,
	lastAction: number,
	actions: number,
	autoStepTimer: number,
	autoDigTimer: number,
	loaded: boolean,
	ready: boolean,
}

local sessions: { [Player]: Session } = {}

local function num(v: any): number
	local n = tonumber(v)
	if n == nil or n ~= n or n == math.huge then
		return 0
	end
	return math.max(0, n)
end

local function sanitize(saved: any): Data
	local d = Config.newData()
	if type(saved) ~= "table" then
		return d
	end
	d.coins = num(saved.coins)
	d.totalCoins = num(saved.totalCoins)
	d.step = math.clamp(math.floor(num(saved.step)), 0, Config.MAX_STEP)
	d.bestStep = math.clamp(math.floor(num(saved.bestStep)), 0, Config.MAX_STEP)
	d.bosses = math.clamp(math.floor(num(saved.bosses)), 0, #Config.Layers)
	d.tokens = math.floor(num(saved.tokens))
	d.tokensEver = math.floor(num(saved.tokensEver))
	d.rebirths = math.floor(num(saved.rebirths))
	d.digs = math.floor(num(saved.digs))
	d.rolls = math.floor(num(saved.rolls))
	d.playTime = num(saved.playTime)
	d.autoStep = saved.autoStep ~= false
	d.autoDig = saved.autoDig ~= false
	d.lastOnline = tonumber(saved.lastOnline)
	if type(saved.title) == "string" and Config.TitleById[saved.title] then
		d.title = saved.title
	end
	if type(saved.ups) == "table" then
		for id, lvl in pairs(saved.ups) do
			local u = Config.UpById[id]
			if u then
				d.ups[id] = math.min(u.maxLevel, math.floor(num(lvl)))
			end
		end
	end
	if type(saved.rups) == "table" then
		for id, lvl in pairs(saved.rups) do
			local r = Config.RUpById[id]
			if r then
				d.rups[id] = math.min(r.maxLevel, math.floor(num(lvl)))
			end
		end
	end
	if type(saved.relics) == "table" then
		for id, e in pairs(saved.relics) do
			if Config.RelicById[id] and type(e) == "table" then
				d.relics[id] = { n = math.floor(num(e.n)), s = math.floor(num(e.s)) }
			end
		end
	end
	if type(saved.titles) == "table" then
		for id, n in pairs(saved.titles) do
			if Config.TitleById[id] then
				d.titles[id] = math.floor(num(n))
			end
		end
	end
	return d
end

local function recompute(s: Session)
	s.income = Config.income(s.data)
end

local function event(s: Session, kind: string, ...)
	R.Event:FireClient(s.player, kind, ...)
end

local function sendState(s: Session)
	local d = s.data
	local f = s.fight
	R.State:FireClient(s.player, {
		coins = d.coins,
		totalCoins = d.totalCoins,
		step = d.step,
		bestStep = d.bestStep,
		bosses = d.bosses,
		ups = d.ups,
		relics = d.relics,
		titles = d.titles,
		title = d.title,
		tokens = d.tokens,
		tokensEver = d.tokensEver,
		rebirths = d.rebirths,
		rups = d.rups,
		digs = d.digs,
		rolls = d.rolls,
		playTime = d.playTime,
		autoStep = d.autoStep,
		autoDig = d.autoDig,
		income = s.income,
		fight = f and { layer = f.layer, hp = f.hp, maxHp = f.maxHp, timeLeft = f.timeLeft } or nil,
	})
end

local function addCoins(s: Session, amount: number)
	if amount ~= amount or amount <= 0 then
		return
	end
	s.data.coins += amount
	s.data.totalCoins += amount
end

local function setLeaderstats(s: Session)
	local ls = s.player:FindFirstChild("leaderstats")
	if not ls then
		return
	end
	local st = ls:FindFirstChild("⬇ Глубина") :: IntValue?
	if st then
		st.Value = s.data.step
	end
	local rb = ls:FindFirstChild("🔁 Перерожд.") :: IntValue?
	if rb then
		rb.Value = s.data.rebirths
	end
end

-- Звание над головой
local function updateNameplate(s: Session)
	local char = s.player.Character
	local head = char and char:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local bb = head:FindFirstChild("TitleTag") :: BillboardGui?
	if not bb then
		local newBB = Instance.new("BillboardGui")
		newBB.Name = "TitleTag"
		newBB.Size = UDim2.fromOffset(220, 30)
		newBB.StudsOffset = Vector3.new(0, 2.6, 0)
		newBB.MaxDistance = 80
		newBB.LightInfluence = 0
		local t = Instance.new("TextLabel")
		t.Name = "Text"
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.TextScaled = true
		t.Font = Enum.Font.FredokaOne
		t.TextStrokeTransparency = 0.2
		t.Parent = newBB
		newBB.Parent = head
		bb = newBB
	end
	local label = (bb :: BillboardGui):FindFirstChild("Text") :: TextLabel
	local title = s.data.title and Config.TitleById[s.data.title]
	if title then
		label.Text = "🎖 " .. title.name
		label.TextColor3 = title.color
	else
		label.Text = ""
	end
end

--------------------------------------------------------------------------------
-- Сохранение и топ
--------------------------------------------------------------------------------
local function save(player: Player)
	local s = sessions[player]
	if not s or not s.loaded or not store then
		return
	end
	local d = s.data
	local payload = {
		coins = d.coins,
		totalCoins = d.totalCoins,
		step = d.step,
		bestStep = d.bestStep,
		bosses = d.bosses,
		ups = d.ups,
		relics = d.relics,
		titles = d.titles,
		title = d.title,
		tokens = d.tokens,
		tokensEver = d.tokensEver,
		rebirths = d.rebirths,
		rups = d.rups,
		digs = d.digs,
		rolls = d.rolls,
		playTime = d.playTime,
		autoStep = d.autoStep,
		autoDig = d.autoDig,
		lastOnline = os.time(),
	}
	local ok, err = pcall(function()
		(store :: DataStore):SetAsync("p_" .. player.UserId, payload)
	end)
	if not ok then
		warn("Не удалось сохранить", player.Name, err)
	end
	if topStore and d.bestStep > 0 then
		pcall(function()
			(topStore :: OrderedDataStore):SetAsync("u_" .. player.UserId, d.bestStep)
		end)
	end
end

local nameCache: { [number]: string } = {}
local function refreshLeaderboard()
	if not topStore then
		World.setLeaderboard({})
		return
	end
	local ok, pages = pcall(function()
		return (topStore :: OrderedDataStore):GetSortedAsync(false, 10)
	end)
	if not ok or not pages then
		return
	end
	local rows = {}
	for _, entry in ipairs((pages :: DataStorePages):GetCurrentPage()) do
		local uid = tonumber(string.sub(entry.key, 3))
		if uid then
			local name = nameCache[uid]
			if not name then
				local okName, n = pcall(function()
					return Players:GetNameFromUserIdAsync(uid)
				end)
				name = okName and n or ("Игрок " .. uid)
				nameCache[uid] = name
			end
			table.insert(rows, { name = name :: string, value = entry.value })
		end
	end
	World.setLeaderboard(rows)
end

--------------------------------------------------------------------------------
-- Вход / выход
--------------------------------------------------------------------------------
local function teleport(s: Session, where: string)
	local char = s.player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then
		return
	end
	if where == "edge" and s.data.step > 0 then
		char:PivotTo(World.standCFrame(s.data.step))
	elseif where == "boss" then
		local layer = s.data.bosses + 1
		if layer <= #Config.Layers and s.data.step >= Config.bossStep(layer) then
			char:PivotTo(World.standCFrame(Config.bossStep(layer)))
		end
	elseif where == "dig" then
		local layer = Config.layerOfStep(s.data.step)
		if s.data.step < Config.digSiteStep(layer) then
			layer -= 1
		end
		if layer >= 1 then
			char:PivotTo(World.standCFrame(Config.digSiteStep(layer) - 1))
		end
	else
		char:PivotTo(world.spawnCFrame)
	end
end

local function onPlayerAdded(player: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local depth = Instance.new("IntValue")
	depth.Name = "⬇ Глубина"
	depth.Parent = ls
	local reb = Instance.new("IntValue")
	reb.Name = "🔁 Перерожд."
	reb.Parent = ls
	ls.Parent = player

	local s: Session = {
		player = player,
		data = Config.newData(),
		income = 1,
		fight = nil,
		lastAction = 0,
		actions = 0,
		autoStepTimer = 0,
		autoDigTimer = 0,
		loaded = false,
		ready = false,
	}
	sessions[player] = s

	player.CharacterAdded:Connect(function(char)
		char:WaitForChild("Head", 10)
		updateNameplate(s)
	end)

	local saved = nil
	local loadedOk = true
	if store then
		local ok, result = pcall(function()
			return (store :: DataStore):GetAsync("p_" .. player.UserId)
		end)
		if ok then
			saved = result
		else
			loadedOk = false
			warn("Не удалось загрузить", player.Name, result)
		end
	end
	if not player.Parent then
		return
	end
	s.data = sanitize(saved)
	s.loaded = loadedOk
	recompute(s)
	s.ready = true
	setLeaderstats(s)
	updateNameplate(s)
	player:SetAttribute("Step", s.data.step)

	local d = s.data
	if d.lastOnline then
		local away = os.time() - d.lastOnline
		local earned = s.income * math.clamp(away, 0, Config.OFFLINE_MAX) * Config.OFFLINE_RATE
		if away >= 60 and earned >= 1 then
			addCoins(s, earned)
			task.delay(2, function()
				if player.Parent then
					event(s, "offline", earned, away)
				end
			end)
		end
	else
		task.delay(2, function()
			if player.Parent then
				event(s, "welcome")
			end
		end)
	end
	if not loadedOk then
		event(s, "message", "⚠ Не удалось загрузить сохранение. Прогресс этой сессии не сохранится — перезайди позже.")
	end
	sendState(s)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	save(player)
	sessions[player] = nil
end)

game:BindToClose(function()
	local pending = 0
	for _, player in ipairs(Players:GetPlayers()) do
		pending += 1
		task.spawn(function()
			save(player)
			pending -= 1
		end)
	end
	local t = os.clock()
	while pending > 0 and os.clock() - t < 25 do
		task.wait(0.1)
	end
end)

--------------------------------------------------------------------------------
-- Защита от спама
--------------------------------------------------------------------------------
local function allow(s: Session?): boolean
	if not s or not s.ready then
		return false
	end
	local now = os.clock()
	if now - s.lastAction > 1 then
		s.lastAction = now
		s.actions = 0
	end
	s.actions += 1
	return s.actions <= 25
end

--------------------------------------------------------------------------------
-- Ступени
--------------------------------------------------------------------------------
local function setStep(s: Session, n: number)
	s.data.step = n
	if n > s.data.bestStep then
		s.data.bestStep = n
	end
	s.player:SetAttribute("Step", n)
end

local function buySteps(s: Session, limit: number): number
	local bought = 0
	local d = s.data
	while bought < limit do
		local ok = Config.canBuyStep(d)
		if not ok then
			break
		end
		local cost = Config.stepCost(d, d.step + 1)
		if d.coins < cost then
			break
		end
		d.coins -= cost
		setStep(s, d.step + 1)
		bought += 1
		local n = d.step
		if n % Config.STEPS_PER_LAYER == 0 then
			event(s, "bossReached", Config.layerOfStep(n))
		elseif n % Config.STEPS_PER_LAYER == 1 and n > 1 then
			event(s, "newLayer", Config.layerOfStep(n))
		elseif n == Config.digSiteStep(Config.layerOfStep(n)) then
			event(s, "digUnlocked", Config.layerOfStep(n))
		end
	end
	if bought > 0 then
		recompute(s)
	end
	return bought
end

R.BuyStep.OnServerEvent:Connect(function(player, mode)
	local s = sessions[player]
	if not allow(s) then
		return
	end
	local ses = s :: Session
	if buySteps(ses, mode == "max" and 1000 or 1) > 0 then
		sendState(ses)
	end
end)

--------------------------------------------------------------------------------
-- Улучшения
--------------------------------------------------------------------------------
R.BuyUp.OnServerEvent:Connect(function(player, id, mode)
	local s = sessions[player]
	local u = type(id) == "string" and Config.UpById[id] or nil
	if not allow(s) or not u then
		return
	end
	local ses = s :: Session
	local d = ses.data
	if d.bosses < u.needBoss then
		return
	end
	local count = 0
	local limit = mode == "max" and 1000 or 1
	while count < limit do
		local lvl = Config.lvl(d, u.id)
		if lvl >= u.maxLevel then
			break
		end
		local cost = Config.upCost(u, lvl)
		if d.coins < cost then
			break
		end
		d.coins -= cost
		d.ups[u.id] = lvl + 1
		count += 1
	end
	if count > 0 then
		recompute(ses)
		event(ses, "upgraded", u.id, count)
		sendState(ses)
	end
end)

R.BuyRUp.OnServerEvent:Connect(function(player, id)
	local s = sessions[player]
	local r = type(id) == "string" and Config.RUpById[id] or nil
	if not allow(s) or not r then
		return
	end
	local ses = s :: Session
	local d = ses.data
	local lvl = Config.rlvl(d, r.id)
	if lvl >= r.maxLevel then
		return
	end
	local cost = Config.rupCost(r, lvl)
	if d.tokens < cost then
		return
	end
	d.tokens -= cost
	d.rups[r.id] = lvl + 1
	recompute(ses)
	event(ses, "message", string.format("💠 %s — уровень %d", r.name, lvl + 1))
	sendState(ses)
end)

R.Toggle.OnServerEvent:Connect(function(player, which)
	local s = sessions[player]
	if not allow(s) then
		return
	end
	local ses = s :: Session
	if which == "autoStep" then
		ses.data.autoStep = not ses.data.autoStep
	elseif which == "autoDig" then
		ses.data.autoDig = not ses.data.autoDig
	end
	sendState(ses)
end)

R.Teleport.OnServerEvent:Connect(function(player, where)
	local s = sessions[player]
	if allow(s) and type(where) == "string" then
		teleport(s :: Session, where)
	end
end)

--------------------------------------------------------------------------------
-- Звания
--------------------------------------------------------------------------------
local function roll(s: Session)
	local d = s.data
	local cost = Config.titleRollCost(d)
	if d.coins < cost then
		event(s, "message", "Не хватает монет на бросок: нужно 💰 " .. Config.format(cost))
		return
	end
	d.coins -= cost
	d.rolls += 1
	local t = Config.rollTitle(Config.luck(d), math.random)
	d.titles[t.id] = (d.titles[t.id] or 0) + 1
	local better = Config.titleMult(d) < t.mult
	if better then
		d.title = t.id
		updateNameplate(s)
		recompute(s)
	end
	event(s, "title", t.id, better)
	sendState(s)
end

local lastRoll: { [Player]: number } = {}
local function tryRoll(player: Player)
	local s = sessions[player]
	if not allow(s) then
		return
	end
	local now = os.clock()
	if now - (lastRoll[player] or 0) < 0.6 then
		return
	end
	lastRoll[player] = now
	roll(s :: Session)
end
R.Roll.OnServerEvent:Connect(tryRoll)
local altarPrompt = world.altar:FindFirstChildOfClass("ProximityPrompt")
if altarPrompt then
	altarPrompt.Triggered:Connect(tryRoll)
end

--------------------------------------------------------------------------------
-- Раскопки
--------------------------------------------------------------------------------
local function dig(s: Session, layer: number, auto: boolean): boolean
	local d = s.data
	if layer < 1 or layer > #Config.Layers or d.step < Config.digSiteStep(layer) then
		return false
	end
	local cost = Config.digCost(d, layer)
	if d.coins < cost then
		if not auto then
			event(s, "message", "Не хватает монет на раскопки: нужно 💰 " .. Config.format(cost))
		end
		return false
	end
	d.coins -= cost
	d.digs += 1
	local relic = Config.rollRelic(layer, Config.luck(d), math.random)
	local shiny = math.random() < Config.shinyChance(d)
	local entry = d.relics[relic.id]
	local isNew = entry == nil
	if not entry then
		entry = { n = 0, s = 0 }
		d.relics[relic.id] = entry
	end
	local e = entry :: { n: number, s: number }
	e.n += 1
	if shiny then
		e.s += 1
	end
	recompute(s)
	event(s, "relic", relic.id, shiny, isNew, auto)
	return true
end

local function deepestDigLayer(d: Data): number
	local layer = Config.layerOfStep(d.step)
	if d.step < Config.digSiteStep(layer) then
		layer -= 1
	end
	return layer
end

for _, site in ipairs(world.digs) do
	site.prompt.Triggered:Connect(function(player)
		local s = sessions[player]
		if not allow(s) then
			return
		end
		local ses = s :: Session
		if ses.data.step < Config.digSiteStep(site.layer) then
			event(ses, "message", "Этот раскоп откроется, когда дойдёшь до ступени " .. Config.digSiteStep(site.layer))
			return
		end
		if dig(ses, site.layer, false) then
			sendState(ses)
		end
	end)
end

R.Dig.OnServerEvent:Connect(function(player)
	local s = sessions[player]
	if not allow(s) then
		return
	end
	local ses = s :: Session
	local layer = deepestDigLayer(ses.data)
	if layer < 1 then
		event(ses, "message", "Первый раскоп — на ступени " .. Config.digSiteStep(1))
		return
	end
	if dig(ses, layer, false) then
		sendState(ses)
	end
end)

--------------------------------------------------------------------------------
-- Бои со стражами
--------------------------------------------------------------------------------
local function startFight(s: Session, layer: number)
	local d = s.data
	if s.fight then
		return
	end
	if d.bosses ~= layer - 1 or d.step < Config.bossStep(layer) then
		event(s, "message", "Сначала дойди до стража этого слоя")
		return
	end
	local hp = Config.bossHP(layer)
	s.fight = { layer = layer, hp = hp, maxHp = hp, timeLeft = Config.fightDuration(d) }
	event(s, "fightStart", layer)
	sendState(s)
end

for _, boss in ipairs(world.bosses) do
	boss.prompt.Triggered:Connect(function(player)
		local s = sessions[player]
		if allow(s) then
			startFight(s :: Session, boss.layer)
		end
	end)
end

R.Fight.OnServerEvent:Connect(function(player)
	local s = sessions[player]
	if not allow(s) then
		return
	end
	local ses = s :: Session
	startFight(ses, ses.data.bosses + 1)
end)

local function tickFight(s: Session, dt: number)
	local f = s.fight
	if not f then
		return
	end
	local d = s.data
	local dmg = Config.damagePerSec(d) * dt
	if math.random() < Config.critChance(d) then
		dmg *= 5
	end
	f.hp -= dmg
	f.timeLeft -= dt
	if f.hp <= 0 then
		s.fight = nil
		d.bosses = math.max(d.bosses, f.layer)
		local reward = Config.stepCost(d, Config.bossStep(f.layer)) * 3
		addCoins(s, reward)
		recompute(s)
		event(s, "fightWon", f.layer, reward)
		sendState(s)
	elseif f.timeLeft <= 0 then
		s.fight = nil
		event(s, "fightLost", f.layer, f.hp / f.maxHp)
		sendState(s)
	end
end

--------------------------------------------------------------------------------
-- Перерождение
--------------------------------------------------------------------------------
R.Rebirth.OnServerEvent:Connect(function(player)
	local s = sessions[player]
	if not allow(s) then
		return
	end
	local ses = s :: Session
	local d = ses.data
	local gain = Config.tokensOnRebirth(d)
	if gain < 1 then
		return
	end
	d.tokens += gain
	d.tokensEver += gain
	d.rebirths += 1
	d.coins = 0
	d.ups = {}
	d.bosses = 0
	ses.fight = nil
	setStep(ses, math.min(10 * Config.rlvl(d, "r_start"), Config.STEPS_PER_LAYER - 1))
	recompute(ses)
	setLeaderstats(ses)
	event(ses, "rebirth", gain)
	sendState(ses)
	teleport(ses, "edge")
	task.spawn(save, player)
end)

--------------------------------------------------------------------------------
-- Главный цикл
--------------------------------------------------------------------------------
local TICK = 0.2
local stateTimer, slowTimer = 0, 0

task.spawn(function()
	while true do
		local dt = task.wait(TICK)
		stateTimer += dt
		slowTimer += dt
		for _, s in pairs(sessions) do
			if s.ready then
				local d = s.data
				d.playTime += dt
				addCoins(s, s.income * dt)
				tickFight(s, dt)

				s.autoStepTimer += dt
				if s.autoStepTimer >= 1 then
					s.autoStepTimer = 0
					if Config.rlvl(d, "r_autostep") >= 1 and d.autoStep then
						buySteps(s, 50)
					end
				end
				s.autoDigTimer += dt
				if s.autoDigTimer >= 4 then
					s.autoDigTimer = 0
					if Config.rlvl(d, "r_autodig") >= 1 and d.autoDig then
						local layer = deepestDigLayer(d)
						if layer >= 1 and Config.digCost(d, layer) <= d.coins * 0.25 then
							dig(s, layer, true)
						end
					end
				end
			end
		end
		if stateTimer >= 0.5 then
			stateTimer = 0
			for _, s in pairs(sessions) do
				if s.ready then
					sendState(s)
					setLeaderstats(s)
				end
			end
		end
		if slowTimer >= 90 then
			slowTimer = 0
			for player in pairs(sessions) do
				task.spawn(save, player)
			end
			task.spawn(refreshLeaderboard)
		end
	end
end)

task.delay(5, refreshLeaderboard)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000005"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- Постройка мира «В Бездну»: поверхность, яма со спиральной лестницей, слои, стражи, раскопы, алтарь.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))

local World = {}

local SY = Config.SURFACE_Y
local WALL_R = 37.5
local SEGMENTS = 24

local function A(x: number, y: number, z: number): CFrame
	return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z))
end

local function part(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

local function billboard(adornee: BasePart, size: UDim2, offset: Vector3, maxDistance: number, alwaysOnTop: boolean?): BillboardGui
	local bb = Instance.new("BillboardGui")
	bb.Size = size
	bb.StudsOffsetWorldSpace = offset
	bb.AlwaysOnTop = alwaysOnTop == true
	bb.LightInfluence = 0
	bb.MaxDistance = maxDistance
	bb.Adornee = adornee
	bb.Parent = adornee
	return bb
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.3
	for k, v in pairs(props) do
		(t :: any)[k] = v
	end
	t.Parent = parent
	return t
end

-- CFrame ступени: ось X смотрит от центра наружу
local function stepCFrame(n: number): CFrame
	local pos = Config.stepPosition(n)
	return CFrame.new(pos - Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, -Config.stepAngle(n), 0)
end
World.stepCFrame = stepCFrame

-- Точка, куда ставить игрока на ступени n
function World.standCFrame(n: number): CFrame
	local pos = Config.stepPosition(n) + Vector3.new(0, 3.5, 0)
	-- смотрим вниз по лестнице
	local ahead = Config.stepPosition(n + 1) + Vector3.new(0, 3.5, 0)
	return CFrame.lookAt(pos, ahead)
end

--------------------------------------------------------------------------------
-- Поверхность
--------------------------------------------------------------------------------
local leaderRows: { TextLabel } = {}

local function buildSurface(root: Instance): (BasePart, CFrame)
	local surface = Instance.new("Model")
	surface.Name = "Surface"
	local grass = Color3.fromRGB(80, 130, 70)

	-- Кольцо вокруг ямы
	for i = 0, SEGMENTS - 1 do
		local a = i / SEGMENTS * math.pi * 2
		local r = (WALL_R + 62) / 2
		part(surface, {
			Name = "Ring",
			Size = Vector3.new(62 - WALL_R + 1, 4, 2 * math.pi * 62 / SEGMENTS + 1),
			CFrame = CFrame.new(math.cos(a) * r, SY - 2, math.sin(a) * r) * CFrame.Angles(0, -a, 0),
			Color = grass,
			Material = Enum.Material.Grass,
		})
	end
	-- Земля вокруг (квадрат с дырой)
	local H = 44 -- полуширина дыры (кольцо её перекрывает)
	local S = 400
	local function slab(cx: number, cz: number, sx: number, sz: number)
		part(surface, {
			Name = "Ground",
			Size = Vector3.new(sx, 4, sz),
			CFrame = CFrame.new(cx, SY - 2.02, cz),
			Color = grass,
			Material = Enum.Material.Grass,
		})
	end
	slab(0, (H + S) / 2, 2 * S, S - H)
	slab(0, -(H + S) / 2, 2 * S, S - H)
	slab((H + S) / 2, 0, S - H, 2 * H)
	slab(-(H + S) / 2, 0, S - H, 2 * H)

	-- Ограждение у края ямы с проходом к первой ступени
	for i = 0, SEGMENTS - 1 do
		local a = (i + 0.5) / SEGMENTS * math.pi * 2
		local deg = math.deg(a)
		if deg > 22 and deg < 345 then
			part(surface, {
				Name = "Fence",
				Size = Vector3.new(1, 3, 2 * math.pi * WALL_R / SEGMENTS + 0.6),
				CFrame = CFrame.new(math.cos(a) * (WALL_R + 0.5), SY + 1.5, math.sin(a) * (WALL_R + 0.5)) * CFrame.Angles(0, -a, 0),
				Color = Color3.fromRGB(110, 80, 50),
				Material = Enum.Material.WoodPlanks,
			})
		end
	end

	-- Вход: табличка
	local signPost = part(surface, {
		Name = "EntrySign",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(WALL_R + 6, SY + 9, -6),
		Transparency = 1,
		CanCollide = false,
	})
	local bb = billboard(signPost, UDim2.fromOffset(520, 100), Vector3.zero, 400)
	text(bb, { Size = UDim2.fromScale(1, 0.65), Text = "⬇ В БЕЗДНУ ⬇", TextColor3 = Color3.fromRGB(255, 220, 120) })
	text(bb, {
		Size = UDim2.fromScale(1, 0.35),
		Position = UDim2.fromScale(0, 0.65),
		Text = "Покупай ступени и спускайся глубже",
		Font = Enum.Font.GothamBold,
	})

	-- Деревья вокруг
	local rng = Random.new(11)
	for _ = 1, 60 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(80, 300)
		local pos = Vector3.new(math.cos(a) * r, SY, math.sin(a) * r)
		local h = rng:NextNumber(8, 16)
		part(surface, { Size = Vector3.new(1.6, h, 1.6), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color = Color3.fromRGB(100, 70, 45), Material = Enum.Material.Wood })
		local crown = part(surface, {
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(h * 0.8, h * 0.8, h * 0.8),
			CFrame = CFrame.new(pos + Vector3.new(0, h, 0)),
			Color = Color3.fromRGB(60 + rng:NextInteger(0, 40), 140 + rng:NextInteger(0, 40), 60),
			Material = Enum.Material.Grass,
		})
		crown.CastShadow = false
	end

	-- Алтарь званий
	local altarPos = Vector3.new(-62, SY, 30)
	part(surface, {
		Name = "AltarBase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 16, 16),
		CFrame = CFrame.new(altarPos + Vector3.new(0, 1, 0)) * A(0, 0, 90),
		Color = Color3.fromRGB(70, 60, 90),
		Material = Enum.Material.Marble,
	})
	local orb = part(surface, {
		Name = "AltarOrb",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(5, 5, 5),
		CFrame = CFrame.new(altarPos + Vector3.new(0, 7, 0)),
		Color = Color3.fromRGB(200, 120, 255),
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	local orbLight = Instance.new("PointLight")
	orbLight.Color = Color3.fromRGB(200, 120, 255)
	orbLight.Range = 20
	orbLight.Brightness = 2
	orbLight.Parent = orb
	part(surface, {
		Name = "AltarPillar",
		Size = Vector3.new(3, 3, 3),
		CFrame = CFrame.new(altarPos + Vector3.new(0, 3.5, 0)) * A(0, 45, 0),
		Color = Color3.fromRGB(90, 80, 110),
		Material = Enum.Material.Marble,
	})
	local altarBB = billboard(orb, UDim2.fromOffset(300, 70), Vector3.new(0, 5, 0), 150)
	text(altarBB, { Size = UDim2.fromScale(1, 0.6), Text = "🎖 Алтарь званий", TextColor3 = Color3.fromRGB(230, 180, 255) })
	text(altarBB, { Size = UDim2.fromScale(1, 0.4), Position = UDim2.fromScale(0, 0.6), Text = "Крути звания — они умножают доход", Font = Enum.Font.GothamBold })
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RollPrompt"
	prompt.ActionText = "Крутить звание"
	prompt.ObjectText = "Алтарь"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = orb

	-- Табло рекордов
	local board = part(surface, {
		Name = "Leaderboard",
		Size = Vector3.new(26, 22, 1),
		CFrame = CFrame.new(62, SY + 13, 40) * A(0, -120, 0),
		Color = Color3.fromRGB(25, 22, 35),
	})
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.LightInfluence = 0
	sg.Parent = board
	text(sg, { Size = UDim2.new(1, 0, 0, 90), Text = "🏆 Глубже всех", TextColor3 = Color3.fromRGB(255, 205, 60) })
	for i = 1, 10 do
		leaderRows[i] = text(sg, {
			Size = UDim2.new(1, -40, 0, 50),
			Position = UDim2.fromOffset(20, 95 + (i - 1) * 56),
			Text = "",
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Enum.Font.GothamBold,
		})
	end
	leaderRows[1].Text = "Загрузка…"

	local spawnCFrame = CFrame.new(0, SY + 4, 62) * CFrame.Angles(0, 0, 0)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(0, SY + 0.5, 62)
	spawn.Color = Color3.fromRGB(255, 200, 80)
	spawn.Material = Enum.Material.Neon
	spawn.Duration = 0
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = surface

	surface.Parent = root
	return orb, spawnCFrame
end

function World.setLeaderboard(rows: { { name: string, value: number } })
	for i = 1, 10 do
		local r = rows[i]
		if r then
			local medal = i == 1 and "🥇" or i == 2 and "🥈" or i == 3 and "🥉" or (i .. ".")
			local layer = Config.layerOfStep(r.value)
			leaderRows[i].Text = string.format("%s %s — ⬇ %d (%s)", medal, r.name, r.value, Config.Layers[layer].name)
		else
			leaderRows[i].Text = i == 1 and "Пока пусто — стань первым!" or ""
		end
	end
end

--------------------------------------------------------------------------------
-- Стражи
--------------------------------------------------------------------------------
export type Boss = { layer: number, model: Model, root: BasePart, prompt: ProximityPrompt }

local function buildBoss(layerInfo: Config.Layer, parent: Instance): Boss
	local L = layerInfo.index
	local stepN = Config.bossStep(L) + 2
	local base = stepCFrame(stepN) * CFrame.new(0, 0.6, 0)
	-- страж смотрит вверх по лестнице
	local up = Config.stepPosition(stepN - 3)
	local look = CFrame.lookAt(base.Position, Vector3.new(up.X, base.Position.Y, up.Z))
	local c = layerInfo.bossColor
	local model = Instance.new("Model")
	model.Name = "Boss" .. L
	local size = 1 + L * 0.08
	local function bp(sz: Vector3, off: CFrame, color: Color3?, mat: Enum.Material?, shape: Enum.PartType?): Part
		local p = part(model, {
			Size = sz * size,
			CFrame = look * CFrame.new(off.Position * size) * off.Rotation,
			Color = color or c,
			Material = mat or layerInfo.material,
			CanCollide = false,
		})
		if shape then
			p.Shape = shape
		end
		return p
	end
	local root = bp(Vector3.new(7, 7, 6), CFrame.new(0, 5.5, 0))
	bp(Vector3.new(5, 4, 4), CFrame.new(0, 10.5, -0.5))
	bp(Vector3.new(1.2, 1.2, 0.4), CFrame.new(-1.2, 11, -2.6), layerInfo.glow, Enum.Material.Neon)
	bp(Vector3.new(1.2, 1.2, 0.4), CFrame.new(1.2, 11, -2.6), layerInfo.glow, Enum.Material.Neon)
	bp(Vector3.new(2, 6, 2), CFrame.new(-5, 5, 0) * A(0, 0, -15))
	bp(Vector3.new(2, 6, 2), CFrame.new(5, 5, 0) * A(0, 0, 15))
	bp(Vector3.new(2.2, 3, 2.2), CFrame.new(-2, 1.5, 0))
	bp(Vector3.new(2.2, 3, 2.2), CFrame.new(2, 1.5, 0))
	bp(Vector3.new(1, 3, 1), CFrame.new(-1.8, 13.5, 0) * A(0, 0, 20), layerInfo.glow, Enum.Material.Neon)
	bp(Vector3.new(1, 3, 1), CFrame.new(1.8, 13.5, 0) * A(0, 0, -20), layerInfo.glow, Enum.Material.Neon)
	root.Name = "Root"
	local light = Instance.new("PointLight")
	light.Color = layerInfo.glow
	light.Range = 24
	light.Brightness = 2
	light.Parent = root
	local bb = billboard(root, UDim2.fromOffset(320, 70), Vector3.new(0, 14 * size, 0), 120)
	text(bb, { Size = UDim2.fromScale(1, 0.6), Text = "⚔ " .. layerInfo.boss, TextColor3 = layerInfo.glow })
	text(bb, {
		Size = UDim2.fromScale(1, 0.4),
		Position = UDim2.fromScale(0, 0.6),
		Text = "Страж слоя " .. L .. " · ❤ " .. Config.format(Config.bossHP(L)),
		Font = Enum.Font.GothamBold,
	})
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "FightPrompt"
	prompt.ActionText = "Сразиться"
	prompt.ObjectText = layerInfo.boss
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 22
	prompt.RequiresLineOfSight = false
	prompt.Parent = root
	model:SetAttribute("Layer", L)
	model.Parent = parent
	return { layer = L, model = model, root = root, prompt = prompt }
end

--------------------------------------------------------------------------------
-- Раскопы
--------------------------------------------------------------------------------
export type DigSite = { layer: number, root: BasePart, prompt: ProximityPrompt }

local function buildDigSite(layerInfo: Config.Layer, parent: Instance): DigSite
	local L = layerInfo.index
	local n = Config.digSiteStep(L)
	local cf = stepCFrame(n) * CFrame.new(5, 0.6, 0)
	local model = Instance.new("Model")
	model.Name = "Dig" .. L
	local mound = part(model, {
		Name = "Mound",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(5, 5, 5),
		CFrame = cf * CFrame.new(0, 0.3, 0),
		Color = layerInfo.wall,
		Material = layerInfo.material,
		CanCollide = false,
	})
	part(model, { Size = Vector3.new(0.3, 4, 0.3), CFrame = cf * CFrame.new(-1, 2.5, 1) * A(20, 0, 15), Color = Color3.fromRGB(120, 85, 50), Material = Enum.Material.Wood, CanCollide = false })
	part(model, { Size = Vector3.new(1.2, 1.4, 0.2), CFrame = cf * CFrame.new(-1.6, 0.6, 1.5) * A(20, 0, 15), Color = Color3.fromRGB(160, 160, 170), Material = Enum.Material.Metal, CanCollide = false })
	for i = 1, 3 do
		part(model, {
			Size = Vector3.new(0.6, 0.6, 0.6),
			CFrame = cf * CFrame.new(math.cos(i * 2) * 1.6, 2.4, math.sin(i * 2) * 1.6) * A(45, i * 30, 35),
			Color = layerInfo.glow,
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
	end
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(layerInfo.glow)
	sparkle.Size = NumberSequence.new(0.4, 0)
	sparkle.Rate = 3
	sparkle.Lifetime = NumberRange.new(1, 1.5)
	sparkle.Speed = NumberRange.new(1, 2)
	sparkle.SpreadAngle = Vector2.new(60, 60)
	sparkle.LightEmission = 1
	sparkle.Parent = mound
	local bb = billboard(mound, UDim2.fromOffset(240, 50), Vector3.new(0, 4.5, 0), 70)
	text(bb, { Size = UDim2.fromScale(1, 1), Text = "🦴 Раскоп: " .. layerInfo.name, TextColor3 = layerInfo.glow })
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "DigPrompt"
	prompt.ActionText = "Копать"
	prompt.ObjectText = "Раскоп"
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = mound
	model.Parent = parent
	return { layer = L, root = mound, prompt = prompt }
end

--------------------------------------------------------------------------------
-- Яма
--------------------------------------------------------------------------------
local function buildPit(root: Instance): ({ Boss }, { DigSite })
	local pit = Instance.new("Folder")
	pit.Name = "Pit"
	local stepsFolder = Instance.new("Folder")
	stepsFolder.Name = "Steps"
	stepsFolder.Parent = pit
	local bosses = {}
	local digs = {}
	local layerH = Config.STEPS_PER_LAYER * Config.STEP_DROP

	for _, layer in ipairs(Config.Layers) do
		local L = layer.index
		local topY = SY - (L - 1) * layerH
		local midY = topY - layerH / 2
		-- Стены
		for i = 0, SEGMENTS - 1 do
			local a = (i + 0.5) / SEGMENTS * math.pi * 2
			part(pit, {
				Name = "Wall",
				Size = Vector3.new(2, layerH + 0.2, 2 * math.pi * WALL_R / SEGMENTS + 0.8),
				CFrame = CFrame.new(math.cos(a) * (WALL_R + 1), midY, math.sin(a) * (WALL_R + 1)) * CFrame.Angles(0, -a, 0),
				Color = layer.wall,
				Material = layer.material,
			})
		end
		-- Центральный столб
		part(pit, {
			Name = "Pillar",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(layerH + 0.2, Config.PIT_INNER * 2, Config.PIT_INNER * 2),
			CFrame = CFrame.new(0, midY, 0) * A(0, 0, 90),
			Color = layer.wall:Lerp(Color3.new(0, 0, 0), 0.2),
			Material = layer.material,
		})
		-- Светящаяся полоса на границе слоёв
		part(pit, {
			Name = "LayerRing",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.6, Config.PIT_INNER * 2 + 0.4, Config.PIT_INNER * 2 + 0.4),
			CFrame = CFrame.new(0, topY - 0.5, 0) * A(0, 0, 90),
			Color = layer.glow,
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
		-- Надпись слоя на столбе
		local first = (L - 1) * Config.STEPS_PER_LAYER + 1
		local signPos = Config.stepPosition(first)
		local dir = Vector3.new(signPos.X, 0, signPos.Z).Unit
		local signAnchor = part(pit, {
			Name = "LayerSign",
			Size = Vector3.new(1, 1, 1),
			CFrame = CFrame.new(dir * (Config.PIT_INNER + 0.5) + Vector3.new(0, signPos.Y + 7, 0)),
			Transparency = 1,
			CanCollide = false,
		})
		local bb = billboard(signAnchor, UDim2.fromOffset(360, 70), Vector3.zero, 90)
		text(bb, { Size = UDim2.fromScale(1, 0.6), Text = string.format("Слой %d · %s", L, layer.name), TextColor3 = layer.glow })
		text(bb, {
			Size = UDim2.fromScale(1, 0.4),
			Position = UDim2.fromScale(0, 0.6),
			Text = string.format("ступени %d–%d", first, L * Config.STEPS_PER_LAYER),
			Font = Enum.Font.GothamBold,
		})

		table.insert(bosses, buildBoss(layer, pit))
		table.insert(digs, buildDigSite(layer, pit))
	end

	-- Ступени
	for n = 1, Config.MAX_STEP do
		local layer = Config.Layers[Config.layerOfStep(n)]
		local isBoss = n % Config.STEPS_PER_LAYER == 0
		local step = part(stepsFolder, {
			Name = tostring(n),
			Size = Vector3.new(Config.PIT_OUTER - Config.PIT_INNER + 1, 1.2, 6.4),
			CFrame = stepCFrame(n) * CFrame.new((Config.PIT_INNER + Config.PIT_OUTER) / 2 - Config.STEP_RADIUS, 0, 0),
			Color = isBoss and layer.glow or (n % 2 == 0 and layer.step or layer.step:Lerp(Color3.new(0, 0, 0), 0.12)),
			Material = isBoss and Enum.Material.Neon or layer.material,
		})
		if n % 10 == 0 then
			local bb = billboard(step, UDim2.fromOffset(90, 34), Vector3.new(4, 2.5, 0), 60)
			text(bb, { Size = UDim2.fromScale(1, 1), Text = "⬇ " .. n, TextColor3 = layer.glow })
		end
		if n % 6 == 0 then
			local lamp = part(stepsFolder, {
				Name = "Lamp",
				Size = Vector3.new(0.8, 0.8, 0.8),
				CFrame = stepCFrame(n) * CFrame.new(Config.PIT_INNER - Config.STEP_RADIUS + 0.4, 3, 0),
				Color = layer.glow,
				Material = Enum.Material.Neon,
				CanCollide = false,
				CastShadow = false,
			})
			local l = Instance.new("PointLight")
			l.Color = layer.glow
			l.Range = 18
			l.Brightness = 1.4
			l.Parent = lamp
		end
	end

	-- Площадка у входа (ступень 0, вровень с поверхностью)
	part(stepsFolder, {
		Name = "0",
		Size = Vector3.new(Config.PIT_OUTER - Config.PIT_INNER + 2, 1.2, 8),
		CFrame = stepCFrame(0),
		Color = Color3.fromRGB(120, 85, 55),
		Material = Enum.Material.WoodPlanks,
	})

	-- Дно
	local bottomY = SY - Config.MAX_STEP * Config.STEP_DROP - 2
	part(pit, {
		Name = "Bottom",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, WALL_R * 2 + 4, WALL_R * 2 + 4),
		CFrame = CFrame.new(0, bottomY, 0) * A(0, 0, 90),
		Color = Color3.fromRGB(10, 8, 18),
		Material = Enum.Material.Neon,
	})

	pit.Parent = root
	return bosses, digs
end

--------------------------------------------------------------------------------
function World.build(): { altar: BasePart, spawnCFrame: CFrame, bosses: { Boss }, digs: { DigSite } }
	Lighting.ClockTime = 16
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(60, 60, 70)
	Lighting.OutdoorAmbient = Color3.fromRGB(110, 110, 120)
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 24
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "DepthTint"
	cc.Saturation = 0.1
	cc.Parent = Lighting

	local root = Instance.new("Folder")
	root.Name = "Abyss"
	local altar, spawnCFrame = buildSurface(root)
	local bosses, digs = buildPit(root)
	root.Parent = workspace
	return { altar = altar, spawnCFrame = spawnCFrame, bosses = bosses, digs = digs }
end

return World
