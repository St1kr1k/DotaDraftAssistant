	label({ Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0.22, 0, 1, 0), Text = Config.formatChance(t.chance), TextSize = 13, Font = Enum.Font.Gotham, TextColor3 = MUTED, Parent = frame })
