<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX00000019"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item><Item class="Lighting" referent="RBX0000001A"><Properties><string name="Name">Lighting</string><token name="Technology">4</token></Properties></Item><Item class="ReplicatedStorage" referent="RBX0000001B"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000006"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Все настройки игры в одном месте: баланс, донат, тайминги.
-- Id = 0 значит «ещё не создано в Creator Dashboard»: в Studio такие покупки выдаются бесплатно для теста.

local Config = {}

-- ===== Мир =====
Config.PlotCount = 8
Config.WaterY = 0

-- ===== Заброс =====
-- Зоны: дальность (studs от края причала) и сила, с которой до неё добиваешь.
-- Между точками дальность растёт плавно (по логарифму силы).
Config.ZoneDist = { 0, 55, 120, 200, 300, 420, 560 }
Config.ZonePower = { 0, 40, 600, 6000, 50000, 400000, 2500000 }
-- Опорные точки кривой «сила -> дальность»
local CURVE = {
	{ 0, 25 },
	{ 40, 55 },
	{ 600, 120 },
	{ 6000, 200 },
	{ 50000, 300 },
	{ 400000, 420 },
	{ 2500000, 560 },
	{ 6000000, 660 },
}
Config.MaxCastDistance = 660
Config.ChargeTime = 1.1 -- секунд на полный заряд
Config.CastCooldown = 0.4
Config.CastSpotRadius = 16 -- насколько близко к краю своего причала нужно стоять

local function lg(p: number): number
	return math.log(1 + math.max(0, p))
end

function Config.MaxDistance(power: number): number
	for i = 1, #CURVE - 1 do
		local a, b = CURVE[i], CURVE[i + 1]
		if power < b[1] then
			local f = (lg(power) - lg(a[1])) / (lg(b[1]) - lg(a[1]))
			return a[2] + (b[2] - a[2]) * math.clamp(f, 0, 1)
		end
	end
	return Config.MaxCastDistance
end

-- Сколько силы нужно для дальности d (для подсказок в интерфейсе)
function Config.PowerForDistance(d: number): number
	for i = 1, #CURVE - 1 do
		local a, b = CURVE[i], CURVE[i + 1]
		if d <= b[2] then
			if d <= a[2] then
				return a[1]
			end
			local f = (d - a[2]) / (b[2] - a[2])
			return math.ceil(math.exp(lg(a[1]) + (lg(b[1]) - lg(a[1])) * f) - 1 - 1e-6)
		end
	end
	return CURVE[#CURVE][1]
end

-- ===== Тренировка (турник) =====
Config.AfkRepInterval = 1.5 -- без кликов: 1 повтор раз в 1.5 с
Config.ClickRepInterval = 0.18 -- кликами: не чаще ~5.5 повторов в секунду
Config.PowerPerRep = 1

-- ===== Аквариум =====
Config.BaseTankSlots = 8
-- Редкие большие улучшения аквариума: каждое +6 мест и полностью новый вид
Config.SlotsPerUpgrade = 6
Config.MaxTankUpgrades = 4
Config.TankUpgradeCosts = { 2500, 75000, 2500000, 90000000 }
Config.TankUpgradeNames = { "Wooden Tank", "Reef Tank", "Golden Tank", "Neon Tank", "Royal Tank" }
function Config.TankUpgradeCost(level: number): number
	return Config.TankUpgradeCosts[level + 1] or math.huge
end
Config.SellSeconds = 25 -- рыба продаётся за 25 секунд своего дохода

-- Доход, пока игрок не в игре
Config.OfflineMaxSeconds = 8 * 3600
Config.OfflineRate = 0.5

-- ===== Удача =====
-- Вес редкости t (1..7) умножается на Luck^((t-1)·LuckExponent)
Config.LuckExponent = 0.3
Config.DistanceLuckPer100 = 0.08 -- +8% удачи за каждые 100 studs дальности
Config.LuckyCastLuck = 10

-- ===== Монетизация =====
-- Лесенка тренировки: дёшево зайти, дальше дороже. Действует самый большой купленный множитель.
Config.TrainingPasses = {
	{ Key = "Train2", Id = 0, Price = 5, Mult = 2 },
	{ Key = "Train4", Id = 0, Price = 19, Mult = 4 },
	{ Key = "Train8", Id = 0, Price = 49, Mult = 8 },
	{ Key = "Train16", Id = 0, Price = 99, Mult = 16 },
	{ Key = "Train32", Id = 0, Price = 199, Mult = 32 },
}

Config.Passes = {
	Cash2 = { Id = 0, Price = 99, Name = "x2 Cash", Desc = "All fish earn double money forever" },
	Luck2 = { Id = 0, Price = 129, Name = "x2 Luck", Desc = "Double luck on every cast" },
	AutoCast = { Id = 0, Price = 149, Name = "Auto Cast", Desc = "Fish automatically while AFK on the pier" },
	BigTank = { Id = 0, Price = 79, Name = "+10 Tank Slots", Desc = "Your aquarium holds 10 more fish" },
}

Config.Products = {
	LuckyCast1 = { Id = 0, Price = 9, Name = "Lucky Cast", Desc = "x10 luck on your next cast", Order = 1 },
	LuckyCast10 = { Id = 0, Price = 69, Name = "10 Lucky Casts", Desc = "x10 luck on 10 casts", Order = 2 },
	TrainBoost = { Id = 0, Price = 15, Name = "Training Potion", Desc = "x3 training for 10 minutes", Order = 3 },
	ServerLuck2 = { Id = 0, Price = 19, Name = "Server Luck x2", Desc = "x2 luck for EVERYONE, 15 min", Order = 4 },
	ServerLuck4 = { Id = 0, Price = 49, Name = "Server Luck x4", Desc = "x4 luck for EVERYONE, 15 min", Order = 5 },
	ServerLuck8 = { Id = 0, Price = 99, Name = "Server Luck x8", Desc = "x8 luck for EVERYONE, 15 min", Order = 6 },
}

Config.ServerLuckSeconds = 15 * 60
Config.TrainBoostSeconds = 10 * 60
Config.TrainBoostMult = 3

-- ===== События =====
Config.EventMinGap = 6 * 60
Config.EventMaxGap = 10 * 60

-- ===== Сохранение =====
Config.DataStoreName = "ThrowBaitForFish_v1"
Config.AutosaveSeconds = 90

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">FishBuilder</string><ProtectedString name="Source"><![CDATA[-- Собирает 3D-модель рыбы из деталей (без загрузки мешей).
-- Модель длиной 1 «единица» вдоль оси Z, голова смотрит в -Z (как LookVector), потом масштабируется.
-- Body — заякоренная главная деталь, остальные приварены к ней: двигать можно одним Body.CFrame.

local CollectionService = game:GetService("CollectionService")

local GameData = require(script.Parent.GameData)

local FishBuilder = {}

local BLACK = Color3.fromRGB(20, 20, 25)
local WHITE = Color3.fromRGB(250, 250, 250)

type Ctx = {
	model: Model,
	s: number,
	def: any,
	parts: { BasePart },
}

local function newPart(ctx: Ctx, kind: string, name: string, size: Vector3, cf: CFrame, color: Color3, tag: string?): BasePart
	local p: BasePart
	if kind == "Wedge" then
		p = Instance.new("WedgePart")
	else
		local part = Instance.new("Part")
		if kind == "Ball" then
			part.Shape = Enum.PartType.Ball
		elseif kind == "Cylinder" then
			part.Shape = Enum.PartType.Cylinder
		end
		p = part
	end
	p.Name = name
	p.Size = Vector3.new(math.max(0.05, size.X * ctx.s), math.max(0.05, size.Y * ctx.s), math.max(0.05, size.Z * ctx.s))
	p.CFrame = CFrame.new(cf.Position * ctx.s) * cf.Rotation
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if kind == "Sphere" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	if tag then
		p:SetAttribute("Role", tag) -- "fixed" (глаза/зубы), "accent", "main", "belly"
	end
	p.Parent = ctx.model
	table.insert(ctx.parts, p)
	return p
end

local function at(x: number, y: number, z: number, rx: number?, ry: number?, rz: number?): CFrame
	return CFrame.new(x, y, z) * CFrame.Angles(rx or 0, ry or 0, rz or 0)
end

local function sphere(ctx: Ctx, name, sx, sy, sz, cf, color, tag)
	return newPart(ctx, "Sphere", name, Vector3.new(sx, sy, sz), cf, color, tag)
end

local function eyes(ctx: Ctx, x: number, y: number, z: number, size: number, cute: boolean?)
	for _, side in ipairs({ -1, 1 }) do
		if cute or size >= 0.1 then
			newPart(ctx, "Ball", "Eye", Vector3.new(size, size, size), at(side * x, y, z), WHITE, "fixed")
			local ps = size * 0.55
			newPart(ctx, "Ball", "Pupil", Vector3.new(ps, ps, ps), at(side * (x + size * 0.32), y + size * 0.05, z - size * 0.18), BLACK, "fixed")
		else
			newPart(ctx, "Ball", "Pupil", Vector3.new(size, size, size), at(side * x, y, z), BLACK, "fixed")
		end
	end
end

local function tailLobes(ctx: Ctx, z: number, spread: number, len: number, color: Color3, upperScale: number?, lowerScale: number?)
	local u = upperScale or 1
	local l = lowerScale or 1
	sphere(ctx, "Tail", 0.05, 0.13 * u, len * u, at(0, spread * u, z, -0.65, 0, 0), color, "accent")
	sphere(ctx, "Tail", 0.05, 0.13 * l, len * l, at(0, -spread * l, z, 0.65, 0, 0), color, "accent")
end

-- ===== Формы =====

local Shapes = {}

function Shapes.fish(ctx: Ctx)
	local d = ctx.def
	local t = d.Tall and 1.55 or 1
	sphere(ctx, "Body", 0.42, 0.5 * t, 1, at(0, 0, 0), d.C1, "main")
	sphere(ctx, "Belly", 0.38, 0.34 * t, 0.84, at(0, -0.09 * t, 0.02), d.C2, "belly")
	tailLobes(ctx, 0.6, 0.1 * t, 0.34, d.C3)
	sphere(ctx, "Fin", 0.04, 0.24 * t, 0.46, at(0, 0.22 * t, 0.06), d.C3, "accent")
	sphere(ctx, "Fin", 0.04, 0.14 * t, 0.3, at(0, -0.22 * t, 0.16), d.C3, "accent")
	for _, side in ipairs({ -1, 1 }) do
		sphere(ctx, "Fin", 0.2, 0.04, 0.14, at(side * 0.22, -0.06, -0.1, 0, side * 0.5, side * 0.3), d.C3, "accent")
	end
	eyes(ctx, 0.16, 0.06 * t, -0.3, d.Big and 0.13 or 0.16)
	if d.Stripes then
		for _, z in ipairs({ -0.17, 0.16 }) do
			local k = math.sqrt(1 - (z / 0.5) ^ 2)
			sphere(ctx, "Stripe", 0.43 * k + 0.02, 0.5 * t * k + 0.02, 0.08, at(0, 0, z), d.C2, "belly")
		end
	end
	if d.Spots then
		for _, side in ipairs({ -1, 1 }) do
			for _, p in ipairs({ { 0.15, 0.1, -0.03 }, { 0.17, 0.0, 0.15 }, { 0.12, 0.12, 0.27 } }) do
				newPart(ctx, "Ball", "Spot", Vector3.new(0.07, 0.07, 0.07), at(side * p[1], p[2] * t, p[3]), d.C3, "accent")
			end
		end
	end
	if d.Sword then
		newPart(ctx, "Block", "Sword", Vector3.new(0.035, 0.035, 0.6), at(0, 0.03, -0.78), d.C2, "accent")
	end
	if d.Spikes then
		for i = 0, 4 do
			newPart(ctx, "Block", "Spike", Vector3.new(0.025, 0.32, 0.025), at(0, 0.3 * t + 0.08, -0.15 + i * 0.1, 0.35, 0, 0), d.C2, "accent")
		end
	end
end

function Shapes.puffer(ctx: Ctx)
	local d = ctx.def
	sphere(ctx, "Body", 0.85, 0.8, 0.9, at(0, 0, 0), d.C1, "main")
	sphere(ctx, "Belly", 0.74, 0.58, 0.8, at(0, -0.13, 0.02), d.C2, "belly")
	tailLobes(ctx, 0.5, 0.07, 0.24, d.C3)
	for _, side in ipairs({ -1, 1 }) do
		sphere(ctx, "Fin", 0.18, 0.04, 0.12, at(side * 0.42, -0.02, -0.05, 0, side * 0.6, 0), d.C3, "accent")
	end
	eyes(ctx, 0.25, 0.1, -0.3, 0.2, true)
	newPart(ctx, "Ball", "Mouth", Vector3.new(0.09, 0.09, 0.09), at(0, -0.06, -0.44), BLACK, "fixed")
	if d.Spikes then
		local n = 22
		local golden = math.pi * (3 - math.sqrt(5))
		for i = 0, n - 1 do
			local y = 1 - (i / (n - 1)) * 2
			local r = math.sqrt(1 - y * y)
			local th = golden * i
			local dir = Vector3.new(math.cos(th) * r, y, math.sin(th) * r)
			if dir.Z > -0.6 and dir.Y > -0.85 then
				local pos = Vector3.new(dir.X * 0.42, dir.Y * 0.39, dir.Z * 0.44)
				local cf = CFrame.lookAt(pos, pos + dir)
				newPart(ctx, "Block", "Spike", Vector3.new(0.045, 0.045, 0.17), cf, d.C3, "accent")
			end
		end
	end
end

function Shapes.shark(ctx: Ctx)
	local d = ctx.def
	sphere(ctx, "Body", 0.3, 0.32, 1, at(0, 0, 0), d.C1, "main")
	sphere(ctx, "Belly", 0.26, 0.2, 0.88, at(0, -0.075, 0.01), d.C2, "belly")
	newPart(ctx, "Wedge", "Fin", Vector3.new(0.04, 0.3, 0.27), at(0, 0.28, 0.06), d.C1, "accent")
	newPart(ctx, "Wedge", "Fin", Vector3.new(0.03, 0.09, 0.1), at(0, 0.12, 0.38), d.C1, "accent")
	sphere(ctx, "Tail", 0.04, 0.12, 0.44, at(0, 0.15, 0.64, -0.85, 0, 0), d.C1, "accent")
	sphere(ctx, "Tail", 0.04, 0.1, 0.26, at(0, -0.07, 0.59, 0.75, 0, 0), d.C1, "accent")
	for _, side in ipairs({ -1, 1 }) do
		sphere(ctx, "Fin", 0.36, 0.03, 0.16, at(side * 0.2, -0.09, -0.08, 0, side * 0.45, side * -0.35), d.C1, "accent")
		for i = 0, 2 do
			newPart(ctx, "Block", "Gill", Vector3.new(0.01, 0.1, 0.014), at(side * 0.138, 0.0, -0.2 + i * 0.05), d.C3, "fixed")
		end
	end
	if d.Cute then
		eyes(ctx, 0.1, 0.06, -0.32, 0.12, true)
	else
		local eyeColor = d.Glow and Color3.fromRGB(255, 40, 30) or BLACK
		for _, side in ipairs({ -1, 1 }) do
			local e = newPart(ctx, "Ball", "Pupil", Vector3.new(0.065, 0.065, 0.065), at(side * 0.12, 0.06, -0.34), eyeColor, "fixed")
			if d.Glow then
				e.Material = Enum.Material.Neon
			end
		end
	end
	if d.Teeth then
		sphere(ctx, "Mouth", 0.16, 0.05, 0.12, at(0, -0.085, -0.37), BLACK, "fixed")
		for i = -3, 3 do
			local x = i * 0.022
			newPart(ctx, "Wedge", "Tooth", Vector3.new(0.018, 0.04, 0.02), at(x, -0.07, -0.425 + math.abs(i) * 0.012, math.pi, 0, 0), WHITE, "fixed")
		end
	end
	if d.Hammer then
		sphere(ctx, "Hammer", 0.64, 0.07, 0.17, at(0, 0.02, -0.46), d.C1, "main")
		for _, side in ipairs({ -1, 1 }) do
			newPart(ctx, "Ball", "Pupil", Vector3.new(0.06, 0.06, 0.06), at(side * 0.31, 0.03, -0.46), BLACK, "fixed")
		end
	end
end

function Shapes.ray(ctx: Ctx)
	local d = ctx.def
	sphere(ctx, "Body", 1, 0.1, 0.7, at(0, 0, 0), d.C1, "main")
	sphere(ctx, "Belly", 0.9, 0.07, 0.62, at(0, -0.022, 0.01), d.C2, "belly")
	sphere(ctx, "Back", 0.3, 0.12, 0.4, at(0, 0.02, 0.0), d.C1, "main")
	for _, side in ipairs({ -1, 1 }) do
		sphere(ctx, "Horn", 0.06, 0.05, 0.2, at(side * 0.12, 0, -0.38, 0, side * -0.2, 0), d.C1, "accent")
		newPart(ctx, "Ball", "Pupil", Vector3.new(0.05, 0.05, 0.05), at(side * 0.13, 0.04, -0.24), BLACK, "fixed")
	end
	newPart(ctx, "Block", "Tail", Vector3.new(0.03, 0.03, 0.75), at(0, 0, 0.68), d.C3, "accent")
end

function Shapes.jelly(ctx: Ctx)
	local d = ctx.def
	local dome = sphere(ctx, "Body", 0.72, 0.52, 0.72, at(0, 0.15, 0), d.C1, "main")
	dome.Material = Enum.Material.Glass
	dome.Transparency = 0.3
	local core = sphere(ctx, "Core", 0.38, 0.28, 0.38, at(0, 0.16, 0), d.C3, "accent")
	core.Material = Enum.Material.Neon
	sphere(ctx, "Rim", 0.74, 0.08, 0.74, at(0, -0.04, 0), d.C2, "belly")
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		newPart(ctx, "Block", "Tentacle", Vector3.new(0.03, 0.62, 0.03), at(math.cos(a) * 0.24, -0.36, math.sin(a) * 0.24, math.sin(a) * 0.15, 0, -math.cos(a) * 0.15), d.C3, "accent")
	end
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + 0.4
		sphere(ctx, "Arm", 0.08, 0.5, 0.08, at(math.cos(a) * 0.06, -0.27, math.sin(a) * 0.06), d.C2, "belly")
	end
	eyes(ctx, 0.14, 0.18, -0.3, 0.1, true)
end

function Shapes.squid(ctx: Ctx)
	local d = ctx.def
	sphere(ctx, "Body", 0.3, 0.3, 0.72, at(0, 0, 0.2), d.C1, "main")
	for _, side in ipairs({ -1, 1 }) do
		sphere(ctx, "Fin", 0.32, 0.03, 0.2, at(side * 0.12, 0, 0.47, 0, side * 0.5, 0), d.C3, "accent")
	end
	sphere(ctx, "Head", 0.25, 0.24, 0.24, at(0, 0, -0.2), d.C2, "belly")
	eyes(ctx, 0.11, 0.04, -0.22, 0.13, true)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local x, y = math.cos(a) * 0.07, math.sin(a) * 0.07
		newPart(ctx, "Block", "Tentacle", Vector3.new(0.04, 0.04, 0.45), at(x, y, -0.5, -y * 1.5, x * 1.5, 0), d.C1, "accent")
	end
	for _, side in ipairs({ -1, 1 }) do
		newPart(ctx, "Block", "Tentacle", Vector3.new(0.03, 0.03, 0.75), at(side * 0.03, -0.03, -0.62, 0.05, side * 0.1, 0), d.C3, "accent")
	end
end

function Shapes.octopus(ctx: Ctx)
	local d = ctx.def
	sphere(ctx, "Body", 0.56, 0.62, 0.6, at(0, 0.27, 0.06, -0.3, 0, 0), d.C1, "main")
	sphere(ctx, "Under", 0.44, 0.16, 0.44, at(0, -0.02, 0), d.C2, "belly")
	eyes(ctx, 0.15, 0.13, -0.2, 0.15, true)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2 + math.pi / 8
		local out = Vector3.new(math.cos(a), 0, math.sin(a))
		local p1 = out * 0.22 + Vector3.new(0, -0.08, 0)
		local p2 = out * 0.42 + Vector3.new(0, -0.14, 0)
		newPart(ctx, "Sphere", "Tentacle", Vector3.new(0.11, 0.11, 0.34), CFrame.lookAt(p1, p1 + out + Vector3.new(0, -0.4, 0)), d.C1, "main")
		newPart(ctx, "Sphere", "Tentacle", Vector3.new(0.08, 0.08, 0.26), CFrame.lookAt(p2, p2 + out + Vector3.new(0, 0.35, 0)), d.C3, "accent")
	end
end

function Shapes.eel(ctx: Ctx)
	local d = ctx.def
	local n = 8
	for i = 0, n - 1 do
		local f = i / (n - 1)
		local z = -0.42 + f * 0.92
		local r = 0.15 * (1 - f * 0.55)
		local x = math.sin(f * math.pi * 2) * 0.05
		local col = (d.Spots and i % 2 == 1) and d.C2 or d.C1
		local seg = sphere(ctx, i == 0 and "Body" or "Segment", r * 1.8, r * 2, 0.2, at(x, 0, z), col, i % 2 == 1 and d.Spots and "belly" or "main")
		if d.Spikes then
			newPart(ctx, "Wedge", "Spike", Vector3.new(0.03, r * 1.1, 0.09), at(x, r + r * 0.4, z), d.C3, "accent")
		end
		if i == 0 then
			seg.Size = seg.Size * Vector3.new(1.15, 1.05, 1.4)
		end
	end
	sphere(ctx, "Fin", 0.02, 0.1, 0.9, at(0, 0.13, 0.08), d.C3, "accent")
	sphere(ctx, "Jaw", 0.18, 0.08, 0.14, at(0, -0.07, -0.5), d.C2, "belly")
	eyes(ctx, 0.1, 0.06, -0.48, 0.07)
	if d.Glow then
		sphere(ctx, "Stripe", 0.03, 0.03, 0.85, at(0.0, 0.0, 0.05), d.C3, "accent")
	end
end

function Shapes.whale(ctx: Ctx)
	local d = ctx.def
	sphere(ctx, "Body", 0.45, 0.42, 1, at(0, 0, 0), d.C1, "main")
	sphere(ctx, "Belly", 0.4, 0.28, 0.9, at(0, -0.1, 0.0), d.C2, "belly")
	for _, side in ipairs({ -1, 1 }) do
		sphere(ctx, "Fluke", 0.42, 0.04, 0.18, at(side * 0.15, 0.02, 0.57, 0, side * -0.45, 0), d.C1, "accent")
		sphere(ctx, "Flipper", 0.3, 0.04, 0.12, at(side * 0.24, -0.11, -0.1, 0, side * 0.5, side * -0.4), d.C1, "accent")
		newPart(ctx, "Ball", "Pupil", Vector3.new(0.06, 0.06, 0.06), at(side * 0.19, -0.04, -0.3), BLACK, "fixed")
		if d.Orca then
			sphere(ctx, "Patch", 0.06, 0.09, 0.18, at(side * 0.18, 0.07, -0.26), WHITE, "fixed")
		end
	end
	if d.Orca then
		newPart(ctx, "Wedge", "Fin", Vector3.new(0.04, 0.36, 0.2), at(0, 0.36, 0.02), d.C1, "accent")
	else
		newPart(ctx, "Wedge", "Fin", Vector3.new(0.03, 0.1, 0.14), at(0, 0.22, 0.22), d.C1, "accent")
	end
	if d.Glow then
		for i = 0, 4 do
			newPart(ctx, "Ball", "Spot", Vector3.new(0.05, 0.05, 0.05), at(0.12 * math.sin(i * 1.7), 0.18, -0.2 + i * 0.12), d.C3, "accent")
		end
	end
end

function Shapes.turtle(ctx: Ctx)
	local d = ctx.def
	sphere(ctx, "Body", 0.7, 0.34, 0.86, at(0, 0.06, 0), d.C1, "main")
	sphere(ctx, "Belly", 0.66, 0.14, 0.8, at(0, -0.05, 0), d.C2, "belly")
	local plate = d.C1:Lerp(BLACK, 0.3)
	for _, p in ipairs({ { 0, 0.21, -0.05 }, { -0.16, 0.17, 0.05 }, { 0.16, 0.17, 0.05 }, { 0, 0.18, 0.2 }, { -0.14, 0.17, -0.18 }, { 0.14, 0.17, -0.18 } }) do
		sphere(ctx, "Plate", 0.17, 0.05, 0.17, at(p[1], p[2], p[3]), plate, "main")
	end
	sphere(ctx, "Head", 0.22, 0.2, 0.27, at(0, 0.03, -0.5), d.C3, "accent")
	for _, side in ipairs({ -1, 1 }) do
		newPart(ctx, "Ball", "Pupil", Vector3.new(0.05, 0.05, 0.05), at(side * 0.08, 0.07, -0.57), BLACK, "fixed")
		sphere(ctx, "Flipper", 0.44, 0.04, 0.14, at(side * 0.4, -0.02, -0.2, 0, side * 0.5, 0), d.C3, "accent")
		sphere(ctx, "Flipper", 0.2, 0.04, 0.12, at(side * 0.26, -0.02, 0.36, 0, side * -0.5, 0), d.C3, "accent")
	end
end

function Shapes.angler(ctx: Ctx)
	local d = ctx.def
	sphere(ctx, "Body", 0.6, 0.56, 0.82, at(0, 0, 0), d.C1, "main")
	sphere(ctx, "Belly", 0.52, 0.36, 0.7, at(0, -0.1, 0.03), d.C2, "belly")
	sphere(ctx, "Mouth", 0.46, 0.18, 0.12, at(0, -0.08, -0.37), BLACK, "fixed")
	for i = -3, 3 do
		newPart(ctx, "Wedge", "Tooth", Vector3.new(0.025, 0.07, 0.025), at(i * 0.055, -0.03, -0.42, math.pi, 0, 0), WHITE, "fixed")
		newPart(ctx, "Wedge", "Tooth", Vector3.new(0.025, 0.06, 0.025), at(i * 0.055 + 0.027, -0.14, -0.42), WHITE, "fixed")
	end
	tailLobes(ctx, 0.48, 0.08, 0.26, d.C1)
	eyes(ctx, 0.19, 0.12, -0.25, 0.1, true)
	local stalkFrom = Vector3.new(0, 0.27, -0.12)
	local stalkTo = Vector3.new(0, 0.5, -0.5)
	local mid = (stalkFrom + stalkTo) / 2
	newPart(ctx, "Block", "Stalk", Vector3.new(0.025, 0.025, (stalkTo - stalkFrom).Magnitude), CFrame.lookAt(mid, stalkTo), d.C1, "main")
	local lure = newPart(ctx, "Ball", "Lure", Vector3.new(0.13, 0.13, 0.13), CFrame.new(stalkTo), d.C3, "accent")
	lure.Material = Enum.Material.Neon
	local light = Instance.new("PointLight")
	light.Color = d.C3
	light.Range = 6
	light.Brightness = 2
	light.Parent = lure
end

-- ===== Мутации =====

local function sparkles(body: BasePart, color: Color3, rate: number)
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "MutationSparkles"
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(color)
	pe.LightEmission = 1
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.35), NumberSequenceKeypoint.new(1, 0) })
	pe.Lifetime = NumberRange.new(0.6, 1.2)
	pe.Rate = rate
	pe.Speed = NumberRange.new(0.5, 1.5)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Parent = body
end

local function applyBaseLook(ctx: Ctx)
	local d = ctx.def
	for _, p in ipairs(ctx.parts) do
		local role = p:GetAttribute("Role")
		if d.Glow and role == "accent" then
			p.Material = Enum.Material.Neon
		end
		if d.Ghost and role ~= "fixed" then
			p.Material = Enum.Material.Glass
			p.Transparency = 0.35
		end
	end
	if d.Glow then
		local body = ctx.model:FindFirstChild("Body") :: BasePart
		local light = Instance.new("PointLight")
		light.Color = d.C3
		light.Range = 5 + ctx.s * 1.5
		light.Brightness = 1.2
		light.Parent = body
	end
end

local GALAXY = { Color3.fromRGB(40, 15, 110), Color3.fromRGB(120, 40, 220), Color3.fromRGB(20, 40, 140), Color3.fromRGB(230, 90, 255) }

local function applyMutation(ctx: Ctx, mutation: string)
	local body = ctx.model:FindFirstChild("Body") :: BasePart
	if mutation == "None" then
		if ctx.def.Galaxy then
			mutation = "Galaxy"
		else
			return
		end
	end
	local mut = GameData.MutationById[mutation]
	for i, p in ipairs(ctx.parts) do
		local role = p:GetAttribute("Role")
		if role ~= "fixed" then
			if mutation == "Golden" then
				p.Color = p.Color:Lerp(Color3.fromRGB(255, 200, 40), 0.8)
				p.Material = Enum.Material.Foil
				p.Reflectance = 0.15
			elseif mutation == "Crystal" then
				p.Color = p.Color:Lerp(Color3.fromRGB(170, 240, 255), 0.65)
				p.Material = Enum.Material.Glass
				p.Transparency = 0.25
			elseif mutation == "Neon" then
				p.Color = p.Color:Lerp(Color3.fromRGB(60, 255, 150), 0.35)
				p.Material = Enum.Material.Neon
			elseif mutation == "Galaxy" then
				p.Color = GALAXY[(i % #GALAXY) + 1]
				p.Material = Enum.Material.Neon
			elseif mutation == "Rainbow" then
				p.Material = Enum.Material.SmoothPlastic
				p:SetAttribute("Hue", (i * 0.07) % 1)
				p.Color = Color3.fromHSV((i * 0.07) % 1, 0.75, 1)
				CollectionService:AddTag(p, "RainbowPart")
			end
		end
	end
	if mut then
		sparkles(body, mut.Color, mutation == "Golden" and 4 or 8)
	end
end

local function weldAll(ctx: Ctx, body: BasePart)
	for _, p in ipairs(ctx.parts) do
		if p ~= body then
			p.Anchored = false
			local w = Instance.new("WeldConstraint")
			w.Part0 = body
			w.Part1 = p
			w.Parent = p
		end
	end
end

-- Собрать модель. length — длина в studs. Возвращает Model с PrimaryPart = Body.
-- opts.static = true — все детали заякорены (для статуй), без сварки.
function FishBuilder.Build(fishId: string, mutation: string?, length: number, opts: { static: boolean? }?): Model
	local def = GameData.FishById[fishId] or GameData.Fish[1]
	local model = Instance.new("Model")
	model.Name = fishId
	local ctx: Ctx = { model = model, s = length, def = def, parts = {} }
	local builder = Shapes[def.Shape] or Shapes.fish
	builder(ctx)
	local body = model:FindFirstChild("Body") :: BasePart
	model.PrimaryPart = body
	applyBaseLook(ctx)
	applyMutation(ctx, mutation or "None")
	if not (opts and opts.static) then
		weldAll(ctx, body)
	end
	model:SetAttribute("FishId", fishId)
	model:SetAttribute("Mutation", mutation or "None")
	return model
end

-- Длина рыбы для показа (в аквариуме и в руках): зависит от редкости и размера
function FishBuilder.DisplayLength(fishId: string, sizeIndex: number): number
	local def = GameData.FishById[fishId]
	local base = ({ 1.6, 1.8, 2.0, 2.3, 2.7, 3.1, 3.6 })[def and def.Rarity or 1]
	if def and def.Big then
		base *= 1.25
	end
	if def and (def.Shape == "jelly" or def.Shape == "puffer" or def.Shape == "octopus") then
		base *= 0.8
	end
	local size = GameData.Sizes[sizeIndex] or GameData.Sizes[2]
	return base * size.Scale
end

return FishBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[-- Красивые числа: 1.25K, 3.4M, 12B ...

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local function trimZeros(s: string): string
	if string.find(s, "%.") then
		s = string.gsub(s, "0+$", "")
		s = string.gsub(s, "%.$", "")
	end
	return s
end

function Format.Number(n: number): string
	if n ~= n or n == math.huge or n == -math.huge then
		return "0"
	end
	local sign = n < 0 and "-" or ""
	n = math.abs(n)
	if n < 1000 then
		if n >= 100 or n == math.floor(n) then
			return sign .. tostring(math.floor(n))
		end
		return sign .. trimZeros(string.format("%.1f", math.floor(n * 10) / 10))
	end
	local i = 1
	while n >= 1000 and i < #SUFFIXES do
		n = n / 1000
		i += 1
	end
	local s
	if n >= 100 then
		s = tostring(math.floor(n))
	elseif n >= 10 then
		s = trimZeros(string.format("%.1f", math.floor(n * 10) / 10))
	else
		s = trimZeros(string.format("%.2f", math.floor(n * 100) / 100))
	end
	return sign .. s .. SUFFIXES[i]
end

function Format.Money(n: number): string
	return "$" .. Format.Number(n)
end

-- 1234567 -> "1,234,567"
function Format.Commas(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s
	while true do
		local k
		formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
		if k == 0 then
			break
		end
	end
	return formatted
end

function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

return Format
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">GameData</string><ProtectedString name="Source"><![CDATA[-- Справочник игры: редкости, зоны, рыбы, мутации, размеры, наживки, события.

local GameData = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- ===== Редкости =====
GameData.Rarities = {
	{ Name = "Common", Color = rgb(205, 210, 215), Weight = 60, Income = 1 },
	{ Name = "Uncommon", Color = rgb(95, 225, 95), Weight = 25, Income = 2.5 },
	{ Name = "Rare", Color = rgb(70, 160, 255), Weight = 10, Income = 6 },
	{ Name = "Epic", Color = rgb(185, 95, 255), Weight = 4, Income = 15 },
	{ Name = "Legendary", Color = rgb(255, 195, 40), Weight = 0.9, Income = 40 },
	{ Name = "Mythic", Color = rgb(255, 60, 95), Weight = 0.1, Income = 120 },
	{ Name = "Secret", Color = rgb(255, 255, 255), Weight = 0.012, Income = 600 },
}
GameData.RarityIndex = {}
for i, r in ipairs(GameData.Rarities) do
	GameData.RarityIndex[r.Name] = i
end

-- ===== Зоны (дальность от края причала) =====
GameData.Zones = {
	{ Name = "Shallows", Dist = 0, Color = rgb(120, 235, 220), Income = 1 },
	{ Name = "Coral Reef", Dist = 55, Color = rgb(255, 130, 170), Income = 4 },
	{ Name = "Kelp Forest", Dist = 120, Color = rgb(90, 200, 90), Income = 16 },
	{ Name = "Open Sea", Dist = 200, Color = rgb(60, 150, 255), Income = 70 },
	{ Name = "Deep Blue", Dist = 300, Color = rgb(40, 80, 220), Income = 320 },
	{ Name = "Abyss", Dist = 420, Color = rgb(140, 60, 220), Income = 1500 },
	{ Name = "Megalodon Trench", Dist = 560, Color = rgb(255, 80, 40), Income = 8000 },
}

function GameData.ZoneForDistance(d: number): number
	local z = 1
	for i, zone in ipairs(GameData.Zones) do
		if d >= zone.Dist then
			z = i
		end
	end
	return z
end

-- ===== Рыбы =====
-- Shape: fish, puffer, shark, ray, jelly, squid, octopus, eel, whale, turtle, angler
-- C1 — основной цвет, C2 — живот/второй, C3 — плавники/акцент.
-- Флаги: Stripes, Sword, Hammer, Teeth, Glow, Spikes, Tall, Spots, Big
local R = GameData.RarityIndex
GameData.Fish = {
	-- Shallows
	{ Id = "Guppy", Zone = 1, Rarity = R.Common, Shape = "fish", C1 = rgb(255, 150, 60), C2 = rgb(255, 225, 170), C3 = rgb(255, 205, 70) },
	{ Id = "Clownfish", Zone = 1, Rarity = R.Uncommon, Shape = "fish", C1 = rgb(255, 120, 30), C2 = rgb(255, 255, 255), C3 = rgb(30, 30, 30), Stripes = true },
	{ Id = "Pufferfish", Zone = 1, Rarity = R.Rare, Shape = "puffer", C1 = rgb(250, 215, 90), C2 = rgb(255, 250, 220), C3 = rgb(170, 130, 50), Spikes = true },
	{ Id = "Angelfish", Zone = 1, Rarity = R.Epic, Shape = "fish", C1 = rgb(60, 120, 255), C2 = rgb(255, 230, 60), C3 = rgb(255, 230, 60), Tall = true, Stripes = true },
	{ Id = "Golden Koi", Zone = 1, Rarity = R.Legendary, Shape = "fish", C1 = rgb(255, 200, 40), C2 = rgb(255, 255, 255), C3 = rgb(255, 120, 40), Spots = true },
	{ Id = "Baby Shark", Zone = 1, Rarity = R.Mythic, Shape = "shark", C1 = rgb(255, 215, 60), C2 = rgb(255, 250, 230), C3 = rgb(255, 170, 40), Cute = true },

	-- Coral Reef
	{ Id = "Blue Tang", Zone = 2, Rarity = R.Common, Shape = "fish", C1 = rgb(40, 110, 255), C2 = rgb(30, 60, 150), C3 = rgb(255, 225, 40) },
	{ Id = "Parrotfish", Zone = 2, Rarity = R.Uncommon, Shape = "fish", C1 = rgb(40, 210, 190), C2 = rgb(255, 130, 200), C3 = rgb(255, 130, 200) },
	{ Id = "Lionfish", Zone = 2, Rarity = R.Rare, Shape = "fish", C1 = rgb(220, 60, 50), C2 = rgb(255, 240, 230), C3 = rgb(255, 240, 230), Stripes = true, Spikes = true },
	{ Id = "Sea Turtle", Zone = 2, Rarity = R.Epic, Shape = "turtle", C1 = rgb(120, 85, 45), C2 = rgb(235, 220, 170), C3 = rgb(110, 180, 110) },
	{ Id = "Manta Ray", Zone = 2, Rarity = R.Legendary, Shape = "ray", C1 = rgb(35, 50, 90), C2 = rgb(240, 245, 255), C3 = rgb(35, 50, 90) },
	{ Id = "Rainbow Puffer", Zone = 2, Rarity = R.Mythic, Shape = "puffer", C1 = rgb(255, 80, 200), C2 = rgb(120, 230, 255), C3 = rgb(255, 230, 60), Spikes = true, Glow = true },

	-- Kelp Forest
	{ Id = "Kelp Bass", Zone = 3, Rarity = R.Common, Shape = "fish", C1 = rgb(90, 140, 70), C2 = rgb(210, 220, 170), C3 = rgb(70, 110, 50) },
	{ Id = "Moray Eel", Zone = 3, Rarity = R.Uncommon, Shape = "eel", C1 = rgb(120, 160, 40), C2 = rgb(200, 210, 80), C3 = rgb(60, 90, 20), Spots = true },
	{ Id = "Reef Squid", Zone = 3, Rarity = R.Rare, Shape = "squid", C1 = rgb(255, 150, 160), C2 = rgb(255, 210, 215), C3 = rgb(220, 90, 120) },
	{ Id = "Octopus", Zone = 3, Rarity = R.Epic, Shape = "octopus", C1 = rgb(230, 90, 70), C2 = rgb(255, 170, 150), C3 = rgb(200, 60, 50) },
	{ Id = "Hammerhead", Zone = 3, Rarity = R.Legendary, Shape = "shark", C1 = rgb(120, 135, 150), C2 = rgb(235, 240, 245), C3 = rgb(100, 115, 130), Hammer = true },
	{ Id = "Ghost Ray", Zone = 3, Rarity = R.Mythic, Shape = "ray", C1 = rgb(220, 245, 255), C2 = rgb(255, 255, 255), C3 = rgb(150, 220, 255), Glow = true, Ghost = true },

	-- Open Sea
	{ Id = "Tuna", Zone = 4, Rarity = R.Common, Shape = "fish", C1 = rgb(50, 70, 120), C2 = rgb(215, 225, 235), C3 = rgb(255, 215, 60) },
	{ Id = "Mahi-Mahi", Zone = 4, Rarity = R.Uncommon, Shape = "fish", C1 = rgb(40, 190, 120), C2 = rgb(255, 230, 60), C3 = rgb(40, 140, 220), Tall = true },
	{ Id = "Swordfish", Zone = 4, Rarity = R.Rare, Shape = "fish", C1 = rgb(60, 80, 140), C2 = rgb(205, 215, 230), C3 = rgb(60, 80, 140), Sword = true },
	{ Id = "Blue Shark", Zone = 4, Rarity = R.Epic, Shape = "shark", C1 = rgb(50, 110, 220), C2 = rgb(235, 240, 250), C3 = rgb(40, 90, 190) },
	{ Id = "Orca", Zone = 4, Rarity = R.Legendary, Shape = "whale", C1 = rgb(25, 25, 30), C2 = rgb(250, 250, 250), C3 = rgb(25, 25, 30), Orca = true },
	{ Id = "Ocean Sunfish", Zone = 4, Rarity = R.Mythic, Shape = "fish", C1 = rgb(170, 185, 200), C2 = rgb(235, 240, 245), C3 = rgb(140, 155, 170), Tall = true, Big = true },

	-- Deep Blue
	{ Id = "Lanternfish", Zone = 5, Rarity = R.Common, Shape = "fish", C1 = rgb(30, 50, 110), C2 = rgb(80, 120, 200), C3 = rgb(120, 255, 255), Spots = true, Glow = true },
	{ Id = "Giant Squid", Zone = 5, Rarity = R.Uncommon, Shape = "squid", C1 = rgb(200, 60, 50), C2 = rgb(240, 140, 120), C3 = rgb(160, 40, 40), Big = true },
	{ Id = "Electric Eel", Zone = 5, Rarity = R.Rare, Shape = "eel", C1 = rgb(40, 70, 160), C2 = rgb(90, 220, 255), C3 = rgb(140, 240, 255), Glow = true },
	{ Id = "Sea Dragon", Zone = 5, Rarity = R.Epic, Shape = "eel", C1 = rgb(60, 170, 110), C2 = rgb(255, 210, 80), C3 = rgb(255, 170, 60), Spikes = true },
	{ Id = "Blue Whale", Zone = 5, Rarity = R.Legendary, Shape = "whale", C1 = rgb(70, 110, 170), C2 = rgb(190, 210, 230), C3 = rgb(60, 95, 150), Big = true },
	{ Id = "Crystal Jelly", Zone = 5, Rarity = R.Mythic, Shape = "jelly", C1 = rgb(180, 240, 255), C2 = rgb(255, 255, 255), C3 = rgb(130, 220, 255), Glow = true },
	{ Id = "Leviathan", Zone = 5, Rarity = R.Secret, Shape = "eel", C1 = rgb(40, 30, 90), C2 = rgb(120, 70, 255), C3 = rgb(0, 255, 200), Glow = true, Spikes = true, Big = true },

	-- Abyss
	{ Id = "Gulper Eel", Zone = 6, Rarity = R.Common, Shape = "eel", C1 = rgb(30, 25, 35), C2 = rgb(70, 60, 80), C3 = rgb(255, 60, 120), Glow = true },
	{ Id = "Anglerfish", Zone = 6, Rarity = R.Uncommon, Shape = "angler", C1 = rgb(60, 45, 70), C2 = rgb(100, 80, 110), C3 = rgb(140, 255, 200), Teeth = true, Glow = true },
	{ Id = "Vampire Squid", Zone = 6, Rarity = R.Rare, Shape = "squid", C1 = rgb(120, 20, 40), C2 = rgb(60, 10, 20), C3 = rgb(80, 180, 255), Glow = true },
	{ Id = "Abyss Jelly", Zone = 6, Rarity = R.Epic, Shape = "jelly", C1 = rgb(170, 60, 255), C2 = rgb(255, 120, 255), C3 = rgb(200, 100, 255), Glow = true },
	{ Id = "Frilled Shark", Zone = 6, Rarity = R.Legendary, Shape = "shark", C1 = rgb(90, 70, 60), C2 = rgb(150, 130, 115), C3 = rgb(70, 55, 45), Teeth = true },
	{ Id = "Kraken", Zone = 6, Rarity = R.Mythic, Shape = "octopus", C1 = rgb(120, 30, 90), C2 = rgb(200, 80, 150), C3 = rgb(255, 230, 80), Big = true, Glow = true },
	{ Id = "Void Whale", Zone = 6, Rarity = R.Secret, Shape = "whale", C1 = rgb(15, 10, 30), C2 = rgb(60, 30, 120), C3 = rgb(180, 120, 255), Glow = true, Big = true },

	-- Megalodon Trench
	{ Id = "Bone Fish", Zone = 7, Rarity = R.Common, Shape = "fish", C1 = rgb(235, 230, 215), C2 = rgb(200, 195, 180), C3 = rgb(160, 150, 130), Stripes = true },
	{ Id = "Lava Puffer", Zone = 7, Rarity = R.Uncommon, Shape = "puffer", C1 = rgb(60, 30, 25), C2 = rgb(255, 120, 30), C3 = rgb(255, 80, 20), Spikes = true, Glow = true },
	{ Id = "Coelacanth", Zone = 7, Rarity = R.Rare, Shape = "fish", C1 = rgb(40, 60, 110), C2 = rgb(90, 110, 160), C3 = rgb(230, 230, 230), Spots = true, Big = true },
	{ Id = "Magma Eel", Zone = 7, Rarity = R.Epic, Shape = "eel", C1 = rgb(50, 20, 15), C2 = rgb(255, 100, 20), C3 = rgb(255, 200, 40), Glow = true, Spikes = true },
	{ Id = "Megalodon", Zone = 7, Rarity = R.Legendary, Shape = "shark", C1 = rgb(95, 105, 115), C2 = rgb(225, 230, 235), C3 = rgb(80, 90, 100), Teeth = true, Big = true },
	{ Id = "Ancient Megalodon", Zone = 7, Rarity = R.Mythic, Shape = "shark", C1 = rgb(40, 35, 40), C2 = rgb(120, 40, 30), C3 = rgb(255, 60, 30), Teeth = true, Big = true, Glow = true },
	{ Id = "Cosmic Whale", Zone = 7, Rarity = R.Secret, Shape = "whale", C1 = rgb(40, 20, 100), C2 = rgb(255, 120, 230), C3 = rgb(120, 220, 255), Glow = true, Big = true, Galaxy = true },
}

GameData.FishById = {}
GameData.FishByZone = {}
for _, f in ipairs(GameData.Fish) do
	f.Name = f.Id
	f.Income = GameData.Zones[f.Zone].Income * GameData.Rarities[f.Rarity].Income
	GameData.FishById[f.Id] = f
	GameData.FishByZone[f.Zone] = GameData.FishByZone[f.Zone] or {}
	table.insert(GameData.FishByZone[f.Zone], f)
end

-- ===== Мутации =====
-- Chance — базовый шанс (в долях), Mult — множитель дохода.
GameData.Mutations = {
	{ Id = "None", Name = "", Mult = 1, Chance = 0, Color = rgb(255, 255, 255) },
	{ Id = "Golden", Name = "Golden", Mult = 2, Chance = 0.04, Color = rgb(255, 205, 50) },
	{ Id = "Crystal", Name = "Crystal", Mult = 3, Chance = 0.02, Color = rgb(150, 235, 255) },
	{ Id = "Neon", Name = "Neon", Mult = 5, Chance = 0.008, Color = rgb(60, 255, 150) },
	{ Id = "Galaxy", Name = "Galaxy", Mult = 10, Chance = 0.003, Color = rgb(170, 90, 255) },
	{ Id = "Rainbow", Name = "Rainbow", Mult = 25, Chance = 0.001, Color = rgb(255, 120, 200) },
}
GameData.MutationById = {}
for i, m in ipairs(GameData.Mutations) do
	m.Index = i
	GameData.MutationById[m.Id] = m
end

-- ===== Размеры =====
GameData.Sizes = {
	{ Name = "Tiny", Mult = 0.8, Weight = 15, Scale = 0.8 },
	{ Name = "Normal", Mult = 1, Weight = 60, Scale = 1 },
	{ Name = "Big", Mult = 1.5, Weight = 18, Scale = 1.12 },
	{ Name = "Huge", Mult = 2.5, Weight = 6, Scale = 1.25 },
	{ Name = "Giant", Mult = 5, Weight = 1, Scale = 1.4 },
}

-- ===== Наживки (покупаются за игровые деньги, дают удачу) =====
GameData.Baits = {
	{ Id = "Worm", Name = "Worm", Price = 0, Luck = 1, Color = rgb(230, 130, 140) },
	{ Id = "Shrimp", Name = "Shrimp", Price = 400, Luck = 1.25, Color = rgb(255, 150, 110) },
	{ Id = "Squid Bait", Name = "Squid Bait", Price = 6000, Luck = 1.5, Color = rgb(240, 200, 220) },
	{ Id = "Glow Lure", Name = "Glow Lure", Price = 90000, Luck = 1.8, Color = rgb(120, 255, 200) },
	{ Id = "Golden Lure", Name = "Golden Lure", Price = 1500000, Luck = 2.1, Color = rgb(255, 210, 60) },
	{ Id = "Abyss Lure", Name = "Abyss Lure", Price = 25000000, Luck = 2.5, Color = rgb(170, 90, 255) },
	{ Id = "Cosmic Lure", Name = "Cosmic Lure", Price = 450000000, Luck = 3, Color = rgb(255, 120, 230) },
	{ Id = "Megalodon Chum", Name = "Megalodon Chum", Price = 9000000000, Luck = 3.6, Color = rgb(255, 70, 40) },
}
GameData.BaitById = {}
for i, b in ipairs(GameData.Baits) do
	b.Index = i
	GameData.BaitById[b.Id] = b
end

-- ===== Спортинвентарь (за игровые деньги, множитель силы за повтор) =====
GameData.Gear = {
	{ Id = "Rusty Bar", Price = 0, Mult = 1, Color = rgb(150, 110, 90) },
	{ Id = "Steel Bar", Price = 1500, Mult = 2, Color = rgb(200, 205, 215) },
	{ Id = "Gold Bar", Price = 40000, Mult = 4, Color = rgb(255, 205, 60) },
	{ Id = "Diamond Bar", Price = 500000, Mult = 8, Color = rgb(120, 230, 255) },
	{ Id = "Cosmic Bar", Price = 10000000, Mult = 16, Color = rgb(200, 110, 255) },
	{ Id = "Mega Bar", Price = 200000000, Mult = 32, Color = rgb(255, 90, 90) },
	{ Id = "Titan Bar", Price = 5000000000, Mult = 64, Color = rgb(60, 255, 170) },
}

-- ===== События сервера =====
GameData.Events = {
	Storm = { Name = "Storm", Icon = "⛈️", Desc = "Luck x2", Duration = 180, Weight = 30, Luck = 2, Mutation = 1, Income = 1, Bite = 1 },
	GoldenHour = { Name = "Golden Hour", Icon = "🌅", Desc = "Mutations x3", Duration = 180, Weight = 25, Luck = 1, Mutation = 3, Income = 1, Bite = 1 },
	Frenzy = { Name = "Feeding Frenzy", Icon = "🐟", Desc = "Instant bites + Cash x2", Duration = 150, Weight = 25, Luck = 1, Mutation = 1, Income = 2, Bite = 0.25 },
	BloodMoon = { Name = "Blood Moon", Icon = "🌕", Desc = "Luck x3 + Mutations x2", Duration = 150, Weight = 12, Luck = 3, Mutation = 2, Income = 1, Bite = 1 },
	MeteorShower = { Name = "Meteor Shower", Icon = "☄️", Desc = "Luck x5!", Duration = 120, Weight = 8, Luck = 5, Mutation = 2, Income = 1, Bite = 1 },
}

-- ===== Помощники =====
function GameData.FishIncome(fishId: string, mutation: string, sizeIndex: number): number
	local def = GameData.FishById[fishId]
	if not def then
		return 0
	end
	local mut = GameData.MutationById[mutation] or GameData.Mutations[1]
	local size = GameData.Sizes[sizeIndex] or GameData.Sizes[2]
	return def.Income * mut.Mult * size.Mult
end

function GameData.FullName(fishId: string, mutation: string, sizeIndex: number): string
	local mut = GameData.MutationById[mutation]
	local size = GameData.Sizes[sizeIndex]
	local parts = {}
	if size and size.Name ~= "Normal" then
		table.insert(parts, size.Name)
	end
	if mut and mut.Id ~= "None" then
		table.insert(parts, mut.Name)
	end
	table.insert(parts, fishId)
	return table.concat(parts, " ")
end

return GameData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- Все сетевые вызовы между клиентом и сервером. Сервер создаёт, клиент ждёт.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

-- RemoteFunction: клиент спрашивает — сервер отвечает
Remotes.Functions = {
	"Cast", -- (charge 0..1) -> результат заброса
	"Reel", -- () -> пойманная рыба
	"BuyBait", -- (baitId)
	"EquipBait", -- (baitId)
	"UpgradeTank", -- ()
	"BuyGear", -- () — следующий снаряд
	"SellFish", -- (uid)
	"SellBulk", -- (maxRarity)
	"StopTraining", -- ()
	"GoToPier", -- ()
	"GoToBase", -- ()
	"DevGrant", -- (key) — только в Studio, для теста доната без Id
	"GetState", -- () -> снимок данных игрока
}

-- RemoteEvent
Remotes.Events = {
	"State", -- сервер -> клиент: снимок данных игрока
	"Notify", -- сервер -> клиент: (text, color?)
	"CastFx", -- сервер -> всем: чужой заброс (userId, from, to, flight, total)
	"Rep", -- клиент -> сервер: клик на турнике; сервер -> клиент: (+power)
	"Offline", -- сервер -> клиент: (cash, seconds)
	"BigCatch", -- сервер -> всем: (playerName, fishId, mutation, size)
}

local folder: Folder? = nil

function Remotes.Init()
	assert(RunService:IsServer())
	local f = Instance.new("Folder")
	f.Name = "Remotes"
	for _, name in ipairs(Remotes.Functions) do
		local rf = Instance.new("RemoteFunction")
		rf.Name = name
		rf.Parent = f
	end
	for _, name in ipairs(Remotes.Events) do
		local re = Instance.new("RemoteEvent")
		re.Name = name
		re.Parent = f
	end
	f.Parent = ReplicatedStorage
	folder = f
end

function Remotes.Get(name: string): any
	if not folder then
		folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	end
	return (folder :: Folder):WaitForChild(name)
end

return Remotes
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000001C"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000011"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[-- Сохранение прогресса (DataStore) + временное состояние сессии.
-- Если DataStore недоступен (в Studio не включён доступ к API), игра работает, но НЕ сохраняет,
-- чтобы случайно не затереть настоящий прогресс пустым.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Data = {}
Data.Profiles = {} :: { [Player]: any }
Data.Session = {} :: { [Player]: any }

local loadedEvent = Instance.new("BindableEvent")
Data.ProfileLoaded = loadedEvent.Event -- (player, profile)

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Data] DataStore недоступен: " .. tostring(result))
	end
end

local function defaultProfile()
	return {
		Version = 1,
		Cash = 0,
		Power = 0,
		TotalCaught = 0,
		Baits = { Worm = true },
		Bait = "Worm",
		TankLevel = 0,
		Gear = 1,
		Fish = {},
		Index = {},
		LuckyCasts = 0,
		TrainBoostEnds = 0,
		NextUid = 1,
		LastOnline = 0,
		Receipts = {},
	}
end

local function reconcile(target, template)
	for k, v in pairs(template) do
		if target[k] == nil then
			if type(v) == "table" then
				local copy = {}
				for k2, v2 in pairs(v) do
					copy[k2] = v2
				end
				target[k] = copy
			else
				target[k] = v
			end
		end
	end
	return target
end

local function key(player: Player): string
	return "u_" .. player.UserId
end

function Data.Load(player: Player)
	local profile = nil
	local noSave = false
	if store then
		local ok, result
		for attempt = 1, 3 do
			ok, result = pcall(function()
				return (store :: DataStore):GetAsync(key(player))
			end)
			if ok then
				break
			end
			task.wait(attempt)
		end
		if ok then
			profile = type(result) == "table" and result or nil
		else
			warn("[Data] Не удалось загрузить " .. player.Name .. ": " .. tostring(result))
			noSave = true
		end
	else
		noSave = true
	end
	profile = reconcile(profile or defaultProfile(), defaultProfile())
	if not player.Parent then
		return nil
	end
	Data.Profiles[player] = profile
	Data.Session[player] = {
		NoSave = noSave,
		Busy = false,
		Pending = nil,
		LastCast = 0,
		Training = nil,
		LastClickRep = 0,
		JoinedAt = os.time(),
	}
	loadedEvent:Fire(player, profile)
	return profile
end

function Data.Save(player: Player)
	local profile = Data.Profiles[player]
	local session = Data.Session[player]
	if not profile or not session or session.NoSave or not store then
		return
	end
	profile.LastOnline = os.time()
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(key(player), function()
			return profile
		end)
	end)
	if not ok then
		warn("[Data] Ошибка сохранения " .. player.Name .. ": " .. tostring(err))
	end
end

function Data.Release(player: Player)
	Data.Save(player)
	Data.Profiles[player] = nil
	Data.Session[player] = nil
end

function Data.Get(player: Player)
	return Data.Profiles[player], Data.Session[player]
end

function Data.StartAutosave()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(Data.Save, player)
			end
		end
	end)
	game:BindToClose(function()
		local threads = 0
		for _, player in ipairs(Players:GetPlayers()) do
			threads += 1
			task.spawn(function()
				Data.Save(player)
				threads -= 1
			end)
		end
		local t = os.clock()
		while threads > 0 and os.clock() - t < 25 do
			task.wait(0.1)
		end
	end)
end

return Data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Events</string><ProtectedString name="Source"><![CDATA[-- Случайные события сервера: шторм, золотой час, кормёжка, кровавая луна, метеоритный дождь.
-- Освещение меняет сервер (видят все), дождь/метеоры рисует клиент по атрибуту workspace.Event.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local GameData = require(Shared.GameData)

local PlayerService = require(script.Parent.PlayerService)

local Events = {}

local rng = Random.new()
local defaults = nil
local running = false

local function lightingTargets(id: string?)
	local d = defaults
	if id == "Storm" then
		return { ClockTime = 15, Brightness = 1.1, OutdoorAmbient = Color3.fromRGB(95, 105, 125), Density = 0.45, AtmColor = Color3.fromRGB(150, 160, 175), Cover = 0.9, CloudColor = Color3.fromRGB(110, 115, 130), Saturation = -0.15 }
	elseif id == "GoldenHour" then
		return { ClockTime = 17.7, Brightness = 2.4, OutdoorAmbient = Color3.fromRGB(190, 150, 110), Density = 0.32, AtmColor = Color3.fromRGB(255, 200, 150), Cover = 0.5, CloudColor = Color3.fromRGB(255, 210, 170), Saturation = 0.3 }
	elseif id == "BloodMoon" then
		return { ClockTime = 0.5, Brightness = 1.5, OutdoorAmbient = Color3.fromRGB(150, 50, 60), Density = 0.35, AtmColor = Color3.fromRGB(150, 40, 50), Cover = 0.4, CloudColor = Color3.fromRGB(120, 40, 50), Saturation = 0.25 }
	elseif id == "MeteorShower" then
		return { ClockTime = 21.5, Brightness = 1.6, OutdoorAmbient = Color3.fromRGB(90, 90, 150), Density = 0.3, AtmColor = Color3.fromRGB(120, 110, 200), Cover = 0.3, CloudColor = Color3.fromRGB(150, 140, 220), Saturation = 0.25 }
	elseif id == "Frenzy" then
		return { ClockTime = 12.5, Brightness = 3, OutdoorAmbient = Color3.fromRGB(150, 165, 180), Density = 0.25, AtmColor = Color3.fromRGB(190, 235, 255), Cover = 0.4, CloudColor = Color3.fromRGB(255, 255, 255), Saturation = 0.3 }
	end
	return d
end

local function applyLighting(id: string?)
	local t = lightingTargets(id)
	local info = TweenInfo.new(4, Enum.EasingStyle.Sine)
	TweenService:Create(Lighting, info, { ClockTime = t.ClockTime, Brightness = t.Brightness, OutdoorAmbient = t.OutdoorAmbient }):Play()
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if atm then
		TweenService:Create(atm, info, { Density = t.Density, Color = t.AtmColor }):Play()
	end
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		TweenService:Create(clouds, info, { Cover = t.Cover, Color = t.CloudColor }):Play()
	end
	local cc = Lighting:FindFirstChild("MainColor")
	if cc then
		TweenService:Create(cc, info, { Saturation = t.Saturation }):Play()
	end
end

local function announce(text: string, color: Color3)
	for _, p in ipairs(Players:GetPlayers()) do
		PlayerService.Notify(p, text, color)
	end
end

function Events.Start(id: string)
	local ev = GameData.Events[id]
	if not ev or running then
		return false
	end
	running = true
	workspace:SetAttribute("Event", id)
	workspace:SetAttribute("EventEnds", os.time() + ev.Duration)
	applyLighting(id)
	announce(ev.Icon .. " " .. string.upper(ev.Name) .. "! " .. ev.Desc, Color3.fromRGB(255, 230, 120))
	task.delay(ev.Duration, function()
		workspace:SetAttribute("Event", "")
		applyLighting(nil)
		running = false
	end)
	return true
end

local function pickEvent(): string
	local total = 0
	for _, ev in pairs(GameData.Events) do
		total += ev.Weight
	end
	local r = rng:NextNumber() * total
	for id, ev in pairs(GameData.Events) do
		r -= ev.Weight
		if r <= 0 then
			return id
		end
	end
	return "Storm"
end

local function setupCommand()
	-- /event Storm — для теста в Studio (и для создателя игры)
	local cmd = Instance.new("TextChatCommand")
	cmd.Name = "EventCommand"
	cmd.PrimaryAlias = "/event"
	cmd.Parent = TextChatService
	cmd.Triggered:Connect(function(source, text)
		local player = Players:GetPlayerByUserId(source.UserId)
		if not player then
			return
		end
		local allowed = RunService:IsStudio() or player.UserId == game.CreatorId
		if not allowed then
			return
		end
		local arg = string.match(text, "^%S+%s+(%S+)")
		if arg and GameData.Events[arg] then
			Events.Start(arg)
		else
			local names = {}
			for k in pairs(GameData.Events) do
				table.insert(names, k)
			end
			PlayerService.Notify(player, "Events: " .. table.concat(names, ", "), Color3.fromRGB(200, 200, 255))
		end
	end)
end

function Events.Init()
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	local cc = Lighting:FindFirstChild("MainColor") :: ColorCorrectionEffect?
	defaults = {
		ClockTime = Lighting.ClockTime,
		Brightness = Lighting.Brightness,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		Density = atm and atm.Density or 0.3,
		AtmColor = atm and atm.Color or Color3.new(1, 1, 1),
		Cover = clouds and clouds.Cover or 0.5,
		CloudColor = clouds and clouds.Color or Color3.new(1, 1, 1),
		Saturation = cc and cc.Saturation or 0,
	}
	workspace:SetAttribute("Event", "")
	workspace:SetAttribute("ServerLuck", 1)
	workspace:SetAttribute("ServerLuckEnds", 0)
	pcall(setupCommand)
	task.spawn(function()
		while true do
			task.wait(rng:NextNumber(Config.EventMinGap, Config.EventMaxGap))
			if #Players:GetPlayers() > 0 then
				Events.Start(pickEvent())
			end
		end
	end)
end

return Events
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Fishing</string><ProtectedString name="Source"><![CDATA[-- Заброс и улов. Всё решает сервер: клиент присылает только силу заряда (0..1).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local GameData = require(Shared.GameData)
local Remotes = require(Shared.Remotes)

local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)
local World = require(script.Parent.World)
local PlayerService = require(script.Parent.PlayerService)

local Fishing = {}

local rng = Random.new()

local function weightedPick(weights: { number }): number
	local total = 0
	for _, w in ipairs(weights) do
		total += w
	end
	local r = rng:NextNumber() * total
	for i, w in ipairs(weights) do
		r -= w
		if r <= 0 then
			return i
		end
	end
	return #weights
end

-- Выбор рыбы в зоне с учётом удачи
local function rollFish(zone: number, luck: number)
	local list = GameData.FishByZone[zone]
	local weights = {}
	for i, f in ipairs(list) do
		local rarity = GameData.Rarities[f.Rarity]
		weights[i] = rarity.Weight * luck ^ ((f.Rarity - 1) * Config.LuckExponent)
	end
	return list[weightedPick(weights)]
end

local function rollMutation(mutLuck: number): string
	-- от самой редкой к обычной
	for i = #GameData.Mutations, 2, -1 do
		local m = GameData.Mutations[i]
		if rng:NextNumber() < math.min(0.5, m.Chance * mutLuck) then
			return m.Id
		end
	end
	return "None"
end

local function rollSize(luck: number): number
	local weights = {}
	for i, s in ipairs(GameData.Sizes) do
		weights[i] = s.Weight * (i >= 3 and luck ^ 0.25 or 1)
	end
	return weightedPick(weights)
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function onCast(player: Player, charge: any)
	local profile, session = Data.Get(player)
	if not profile or not session then
		return { ok = false, reason = "loading" }
	end
	if type(charge) ~= "number" or charge ~= charge then
		return { ok = false, reason = "bad" }
	end
	charge = math.clamp(charge, 0.05, 1)
	local now = os.clock()
	if session.Training then
		return { ok = false, reason = "training" }
	end
	if session.Pending and now < session.Pending.Expires then
		return { ok = false, reason = "busy" }
	end
	if now - session.LastCast < Config.CastCooldown then
		return { ok = false, reason = "cooldown" }
	end
	local plot = World.PlotOf(player)
	if not plot then
		return { ok = false, reason = "noplot" }
	end
	local root = rootOf(player)
	if not root or not World.InCastZone(root.Position) then
		return { ok = false, reason = "far" }
	end
	session.LastCast = now

	local maxD = Stats.MaxDistance(profile)
	local dist = math.max(8, maxD * charge)
	local zone = GameData.ZoneForDistance(dist)
	local luck = Stats.Luck(player, profile) * (1 + Config.DistanceLuckPer100 * dist / 100)
	local lucky = false
	if (profile.LuckyCasts or 0) > 0 then
		profile.LuckyCasts -= 1
		luck *= Config.LuckyCastLuck
		lucky = true
	end
	local ev = Stats.CurrentEvent()
	local mutLuck = math.sqrt(luck) * (ev and ev.Mutation or 1)

	local fish = rollFish(zone, luck)
	local mutation = rollMutation(mutLuck)
	local size = rollSize(luck)

	local flight = 0.55 + dist / 420
	local bite = rng:NextNumber(1.1, 2.6) * (ev and ev.Bite or 1)
	local reel = 0.9 + fish.Rarity * 0.22
	-- каждый бросает прямо перед собой, поплавки не накладываются
	local pier = World.Pier
	local lateral = math.clamp((root.Position - pier.Edge):Dot(pier.Right), -32, 32)
	local landing = pier.Edge + pier.Right * lateral * 1.6 + pier.Dir * dist
	landing = Vector3.new(landing.X, Config.WaterY, landing.Z)

	session.Pending = {
		Fish = fish.Id,
		Mutation = mutation,
		Size = size,
		ReadyAt = now + flight + bite + reel * 0.7,
		Expires = now + flight + bite + reel + 25,
	}

	-- показать заброс остальным игрокам
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			Remotes.Get("CastFx"):FireClient(other, player.UserId, landing, flight, flight + bite + reel)
		end
	end
	if lucky then
		PlayerService.Push(player)
	end

	return {
		ok = true,
		land = landing,
		dist = dist,
		zone = zone,
		flight = flight,
		bite = bite,
		reel = reel,
		rarity = fish.Rarity, -- для «подсказки» цветом поплавка во время клёва
		lucky = lucky,
	}
end

local function onReel(player: Player)
	local profile, session = Data.Get(player)
	if not profile or not session or not session.Pending then
		return { ok = false, reason = "nothing" }
	end
	local now = os.clock()
	local pending = session.Pending
	if now < pending.ReadyAt - 0.25 then
		return { ok = false, reason = "early", wait = pending.ReadyAt - now }
	end
	session.Pending = nil
	if now > pending.Expires then
		return { ok = false, reason = "expired" }
	end
	local outcome = PlayerService.AddFish(player, pending.Fish, pending.Mutation, pending.Size)
	local def = GameData.FishById[pending.Fish]
	if def.Rarity >= GameData.RarityIndex.Legendary or (GameData.MutationById[pending.Mutation].Index >= 5) then
		Remotes.Get("BigCatch"):FireAllClients(player.DisplayName, pending.Fish, pending.Mutation, pending.Size)
	end
	return {
		ok = true,
		fish = pending.Fish,
		mutation = pending.Mutation,
		size = pending.Size,
		outcome = outcome,
	}
end

function Fishing.Init()
	Remotes.Get("Cast").OnServerInvoke = onCast
	Remotes.Get("Reel").OnServerInvoke = onReel
	Remotes.Get("GoToBase").OnServerInvoke = function(player)
		local _, session = Data.Get(player)
		if session and session.Training then
			return false
		end
		PlayerService.TeleportToPlot(player)
		return true
	end
	Remotes.Get("GoToPier").OnServerInvoke = function(player)
		local _, session = Data.Get(player)
		if session and session.Training then
			return false
		end
		PlayerService.TeleportToPier(player)
		return true
	end
end

return Fishing
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX0000000A"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Точка входа сервера.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

Remotes.Init()

local World = require(script.Parent.World)
local Data = require(script.Parent.Data)
local PlayerService = require(script.Parent.PlayerService)
local Fishing = require(script.Parent.Fishing)
local Training = require(script.Parent.Training)
local Shop = require(script.Parent.Shop)
local Monetization = require(script.Parent.Monetization)
local Events = require(script.Parent.Events)

World.Build()
workspace:SetAttribute("WorldReady", true)

Fishing.Init()
Training.Init()
Shop.Init()
Monetization.Init()
Events.Init()

local function onJoin(player: Player)
	PlayerService.OnJoin(player, Monetization.ApplyPasses)
end

Players.PlayerAdded:Connect(onJoin)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onJoin, p)
end

Players.PlayerRemoving:Connect(function(player)
	Training.Stop(player)
	PlayerService.OnLeave(player)
end)

PlayerService.StartIncomeLoop()
Data.StartAutosave()
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Monetization</string><ProtectedString name="Source"><![CDATA[-- Донат: геймпассы (навсегда) и товары разработчика (расходники).
-- Id берутся из Config. Пока Id = 0, в Studio покупка выдаётся бесплатно через DevGrant (для теста).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Data = require(script.Parent.Data)
local PlayerService = require(script.Parent.PlayerService)

local Monetization = {}

-- все геймпассы одним списком: key -> id
local function allPasses(): { [string]: number }
	local list = {}
	for _, p in ipairs(Config.TrainingPasses) do
		list[p.Key] = p.Id
	end
	for key, p in pairs(Config.Passes) do
		list[key] = p.Id
	end
	return list
end

local function passKeyById(id: number): string?
	for key, pid in pairs(allPasses()) do
		if pid == id and pid ~= 0 then
			return key
		end
	end
	return nil
end

local function productKeyById(id: number): string?
	for key, p in pairs(Config.Products) do
		if p.Id == id and p.Id ~= 0 then
			return key
		end
	end
	return nil
end

local function grantPass(player: Player, key: string)
	player:SetAttribute("Pass_" .. key, true)
	PlayerService.UpdateAttributes(player)
	PlayerService.UpdateSign(player)
	PlayerService.Push(player)
end

-- Применить товар. Возвращает true, если выдан.
local function grantProduct(player: Player, key: string): boolean
	local profile = Data.Get(player)
	if not profile then
		return false
	end
	if key == "LuckyCast1" then
		profile.LuckyCasts += 1
	elseif key == "LuckyCast10" then
		profile.LuckyCasts += 10
	elseif key == "TrainBoost" then
		profile.TrainBoostEnds = math.max(os.time(), profile.TrainBoostEnds or 0) + Config.TrainBoostSeconds
	elseif key == "ServerLuck2" or key == "ServerLuck4" or key == "ServerLuck8" then
		local mult = tonumber(string.sub(key, -1)) or 2
		local now = os.time()
		local curMult = workspace:GetAttribute("ServerLuck") or 1
		local curEnds = workspace:GetAttribute("ServerLuckEnds") or 0
		if curEnds > now and curMult >= mult then
			workspace:SetAttribute("ServerLuckEnds", curEnds + Config.ServerLuckSeconds)
		else
			workspace:SetAttribute("ServerLuck", mult)
			workspace:SetAttribute("ServerLuckEnds", now + Config.ServerLuckSeconds)
		end
		local text = "🍀 " .. player.DisplayName .. " activated SERVER LUCK x" .. mult .. "!"
		for _, p in ipairs(Players:GetPlayers()) do
			PlayerService.Notify(p, text, Color3.fromRGB(120, 255, 120))
		end
	else
		return false
	end
	PlayerService.Push(player)
	return true
end

function Monetization.ApplyPasses(player: Player)
	for key, id in pairs(allPasses()) do
		if id ~= 0 then
			task.spawn(function()
				local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
				if ok and owns and player.Parent then
					grantPass(player, key)
				end
			end)
		end
	end
end

function Monetization.Init()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased then
			local key = passKeyById(passId)
			if key then
				grantPass(player, key)
				PlayerService.Notify(player, "✅ Thanks for the support!", Color3.fromRGB(120, 255, 120))
			end
		end
	end)

	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		local profile = player and Data.Get(player)
		if not player or not profile then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		profile.Receipts = profile.Receipts or {}
		for _, id in ipairs(profile.Receipts) do
			if id == receipt.PurchaseId then
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
		end
		local key = productKeyById(receipt.ProductId)
		if not key or not grantProduct(player, key) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		table.insert(profile.Receipts, receipt.PurchaseId)
		while #profile.Receipts > 50 do
			table.remove(profile.Receipts, 1)
		end
		task.spawn(Data.Save, player)
		PlayerService.Notify(player, "✅ Purchase received!", Color3.fromRGB(120, 255, 120))
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	-- Тест доната в Studio без настоящих Id
	Remotes.Get("DevGrant").OnServerInvoke = function(player, key)
		if not RunService:IsStudio() or type(key) ~= "string" then
			return false
		end
		if Config.Products[key] then
			grantProduct(player, key)
			return true
		end
		if allPasses()[key] ~= nil then
			grantPass(player, key)
			return true
		end
		return false
	end
end

return Monetization
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">PlayerService</string><ProtectedString name="Source"><![CDATA[-- Вход/выход игроков, участки, удочка в руке, доход каждую секунду, синхронизация аквариума.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local GameData = require(Shared.GameData)
local Format = require(Shared.Format)
local FishBuilder = require(Shared.FishBuilder)
local Remotes = require(Shared.Remotes)

local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)
local World = require(script.Parent.World)

local PlayerService = {}

local rng = Random.new()

function PlayerService.Notify(player: Player, text: string, color: Color3?)
	Remotes.Get("Notify"):FireClient(player, text, color)
end

-- ===== Снимок данных для клиента =====
function PlayerService.Snapshot(player: Player)
	local profile = Data.Profiles[player]
	if not profile then
		return nil
	end
	local plot = World.PlotOf(player)
	return {
		Cash = profile.Cash,
		Power = profile.Power,
		TotalCaught = profile.TotalCaught,
		Baits = profile.Baits,
		Bait = profile.Bait,
		TankLevel = profile.TankLevel,
		Gear = profile.Gear,
		Fish = profile.Fish,
		Index = profile.Index,
		LuckyCasts = profile.LuckyCasts,
		TrainBoostEnds = profile.TrainBoostEnds,
		Capacity = Stats.Capacity(player, profile),
		BaseIncome = Stats.BaseIncome(player, profile),
		MaxDist = Stats.MaxDistance(profile),
		TrainMult = Stats.TrainMult(player, profile),
		PlotIndex = plot and plot.Index or 0,
		NoSave = Data.Session[player] and Data.Session[player].NoSave or false,
	}
end

-- Отправить снимок (не чаще раза за кадр)
function PlayerService.Push(player: Player)
	local session = Data.Session[player]
	if not session or session.PushQueued then
		return
	end
	session.PushQueued = true
	task.defer(function()
		if Data.Session[player] then
			Data.Session[player].PushQueued = false
			local snap = PlayerService.Snapshot(player)
			if snap then
				Remotes.Get("State"):FireClient(player, snap)
			end
		end
	end)
end

function PlayerService.UpdateAttributes(player: Player)
	local profile = Data.Profiles[player]
	if not profile then
		return
	end
	player:SetAttribute("Cash", profile.Cash)
	player:SetAttribute("Power", profile.Power)
	player:SetAttribute("Income", Stats.Income(player, profile))
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		(ls :: any).Cash.Value = Format.Money(profile.Cash)
		;(ls :: any).Power.Value = Format.Number(profile.Power)
	end
end

function PlayerService.AddCash(player: Player, amount: number)
	local profile = Data.Profiles[player]
	if profile then
		profile.Cash = math.max(0, profile.Cash + amount)
		PlayerService.UpdateAttributes(player)
	end
end

-- ===== Аквариум: модели рыб =====
local function randomPointIn(water: BasePart, margin: number): Vector3
	local s = water.Size / 2 - Vector3.new(margin, margin * 0.6, margin * 0.6)
	s = Vector3.new(math.max(0.2, s.X), math.max(0.2, s.Y), math.max(0.2, s.Z))
	return (water.CFrame * CFrame.new(rng:NextNumber(-s.X, s.X), rng:NextNumber(-s.Y, s.Y), rng:NextNumber(-s.Z, s.Z))).Position
end

function PlayerService.SyncTank(player: Player)
	local plot = World.PlotOf(player)
	local profile = Data.Profiles[player]
	if not plot or not profile then
		return
	end
	local want = {}
	for _, f in ipairs(profile.Fish) do
		want[tostring(f.U)] = f
	end
	for _, m in ipairs(plot.FishFolder:GetChildren()) do
		local uid = m:GetAttribute("Uid")
		if not uid or not want[tostring(uid)] then
			m:Destroy()
		else
			want[tostring(uid)] = nil
		end
	end
	for uidStr, f in pairs(want) do
		local len = FishBuilder.DisplayLength(f.Id, f.S)
		local m = FishBuilder.Build(f.Id, f.M, len)
		m:SetAttribute("Uid", tonumber(uidStr))
		m:SetAttribute("Size", f.S)
		m:SetAttribute("Length", len)
		local pos = randomPointIn(plot.Water, len * 0.6)
		m:PivotTo(CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
		m.Parent = plot.FishFolder
	end
	PlayerService.UpdateSign(player)
end

function PlayerService.UpdateSign(player: Player)
	local plot = World.PlotOf(player)
	local profile = Data.Profiles[player]
	if plot and profile then
		plot.OwnerLabel.Text = #profile.Fish .. "/" .. Stats.Capacity(player, profile) .. " 🐟"
		plot.IncomeLabel.Text = Format.Money(Stats.Income(player, profile)) .. "/s"
	end
end

-- Вид базы: табличка на воротах, уровень аквариума и турника, цены на кнопках улучшения
function PlayerService.UpdateBase(player: Player)
	local plot = World.PlotOf(player)
	local profile = Data.Profiles[player]
	if not plot or not profile then
		return
	end
	for _, l in ipairs(plot.GateLabels) do
		l.Text = string.upper(player.DisplayName) .. "'S BASE"
		l.TextColor3 = plot.Color
	end
	local tier = math.min(4, profile.TankLevel or 0)
	if tier ~= plot.TankTier then
		World.RebuildTank(plot, tier)
	end
	World.SetBarTier(plot.BarModel, profile.Gear or 1)
	PlayerService.UpdateSign(player)
end

function PlayerService.ResetBase(plot)
	for _, l in ipairs(plot.GateLabels) do
		l.Text = "EMPTY BASE"
		l.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
	if plot.TankTier ~= 0 then
		World.RebuildTank(plot, 0)
	end
	World.SetBarTier(plot.BarModel, 1)
end

-- ===== Удочка в руке =====
local function giveRod(character: Model)
	local hand = character:WaitForChild("RightHand", 5) :: BasePart? or character:FindFirstChild("Right Arm") :: BasePart?
	if not hand then
		return
	end
	local old = character:FindFirstChild("Rod")
	if old then
		old:Destroy()
	end
	local rod = Instance.new("Model")
	rod.Name = "Rod"
	local isR15 = hand.Name == "RightHand"
	local handCf = hand.CFrame * (isR15 and CFrame.new(0, -0.15, 0) or CFrame.new(0, -0.9, 0))
	local dir = (handCf.RightVector * 0 + handCf.LookVector * 1 + handCf.UpVector * 0.65).Unit
	local base = CFrame.lookAt(handCf.Position, handCf.Position + dir)
	local function part(name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = base * offset
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.Anchored = false
		p.Parent = rod
		local w = Instance.new("WeldConstraint")
		w.Part0 = hand
		w.Part1 = p
		w.Parent = p
		return p
	end
	part("Handle", Vector3.new(0.32, 0.32, 1.6), CFrame.new(0, 0, 0.2), Color3.fromRGB(60, 40, 30), Enum.Material.Fabric)
	part("Reel", Vector3.new(0.5, 0.5, 0.35), CFrame.new(0, -0.3, -0.2), Color3.fromRGB(190, 190, 200), Enum.Material.Metal)
	local shaft = part("Shaft", Vector3.new(0.14, 0.14, 7), CFrame.new(0, 0, -3.8), Color3.fromRGB(230, 120, 50))
	part("Ring", Vector3.new(0.2, 0.2, 0.2), CFrame.new(0, 0.1, -5), Color3.fromRGB(240, 240, 240), Enum.Material.Metal)
	local tip = Instance.new("Attachment")
	tip.Name = "RodTip"
	tip.Position = Vector3.new(0, 0, -3.5)
	tip.Parent = shaft
	rod.PrimaryPart = shaft
	rod.Parent = character
end

function PlayerService.SetRodVisible(character: Model?, visible: boolean)
	local rod = character and character:FindFirstChild("Rod")
	if rod then
		for _, p in ipairs(rod:GetDescendants()) do
			if p:IsA("BasePart") then
				p.Transparency = visible and 0 or 1
			end
		end
	end
end

function PlayerService.TeleportToPlot(player: Player)
	local plot = World.PlotOf(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if plot and root then
		root.CFrame = plot.SpawnCf
	end
end

function PlayerService.TeleportToPier(player: Player)
	local pier = World.Pier
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if pier and root then
		-- свободное место (дальше всех от других игроков)
		local best, bestScore = pier.Spots[1], -1
		for _, spot in ipairs(pier.Spots) do
			local nearest = math.huge
			for _, other in ipairs(game:GetService("Players"):GetPlayers()) do
				local orRoot = other ~= player and other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if orRoot then
					nearest = math.min(nearest, (orRoot.Position - spot.Position).Magnitude)
				end
			end
			if nearest > bestScore then
				best, bestScore = spot, nearest
			end
		end
		local p = best.Position + Vector3.new(0, 3.2, 0)
		root.CFrame = CFrame.lookAt(p, p + pier.Dir)
	end
end

local function onCharacter(player: Player, character: Model)
	task.spawn(giveRod, character)
	task.defer(function()
		character:WaitForChild("HumanoidRootPart", 5)
		task.wait(0.1)
		PlayerService.TeleportToPlot(player)
	end)
end

-- ===== Вход / выход =====
local function assignPlot(player: Player)
	for _, plot in ipairs(World.Plots) do
		if plot.Owner == nil then
			plot.Owner = player
			player:SetAttribute("PlotIndex", plot.Index)
			plot.Model:SetAttribute("OwnerId", player.UserId)
			return plot
		end
	end
	return nil
end

local function makeLeaderstats(player: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Value = "$0"
	cash.Parent = ls
	local power = Instance.new("StringValue")
	power.Name = "Power"
	power.Value = "0"
	power.Parent = ls
	ls.Parent = player
end

function PlayerService.OnJoin(player: Player, applyPasses: (Player) -> ())
	makeLeaderstats(player)
	local plot = assignPlot(player)
	player.CharacterAdded:Connect(function(c)
		onCharacter(player, c)
	end)
	applyPasses(player)
	local profile = Data.Load(player)
	if not profile then
		return
	end
	-- старые уровни аквариума (было 16 мелких) -> новые 4 больших
	profile.TankLevel = math.clamp(profile.TankLevel or 0, 0, Config.MaxTankUpgrades)
	-- старые записи без Uid
	for _, f in ipairs(profile.Fish) do
		if not f.U then
			f.U = profile.NextUid
			profile.NextUid += 1
		end
	end
	-- доход оффлайн
	if (profile.LastOnline or 0) > 0 then
		local elapsed = math.min(os.time() - profile.LastOnline, Config.OfflineMaxSeconds)
		local earned = math.floor(Stats.BaseIncome(player, profile) * elapsed * Config.OfflineRate)
		if earned > 0 and elapsed > 60 then
			profile.Cash += earned
			task.delay(3, function()
				if player.Parent then
					Remotes.Get("Offline"):FireClient(player, earned, elapsed)
				end
			end)
		end
	end
	profile.LastOnline = os.time()
	if not plot then
		PlayerService.Notify(player, "Server is full of plots — rejoin another server!", Color3.fromRGB(255, 90, 90))
	end
	PlayerService.UpdateAttributes(player)
	PlayerService.UpdateBase(player)
	PlayerService.SyncTank(player)
	PlayerService.Push(player)
	if player.Character then
		onCharacter(player, player.Character)
	end
	if Data.Session[player] and Data.Session[player].NoSave then
		task.delay(4, function()
			if player.Parent then
				PlayerService.Notify(player, "⚠️ Saving is OFF (Studio: enable API Services in Game Settings)", Color3.fromRGB(255, 170, 60))
			end
		end)
	end
end

function PlayerService.OnLeave(player: Player)
	local plot = World.PlotOf(player)
	Data.Release(player)
	if plot then
		plot.Owner = nil
		plot.Model:SetAttribute("OwnerId", nil)
		plot.FishFolder:ClearAllChildren()
		plot.OwnerLabel.Text = ""
		plot.IncomeLabel.Text = ""
		PlayerService.ResetBase(plot)
	end
end

-- ===== Доход каждую секунду =====
function PlayerService.StartIncomeLoop()
	task.spawn(function()
		local signTimer = 0
		while true do
			task.wait(1)
			signTimer += 1
			for _, player in ipairs(Players:GetPlayers()) do
				local profile = Data.Profiles[player]
				if profile then
					local inc = Stats.Income(player, profile)
					if inc > 0 then
						profile.Cash += inc
					end
					PlayerService.UpdateAttributes(player)
					if signTimer % 5 == 0 then
						PlayerService.UpdateSign(player)
					end
				end
			end
		end
	end)
end

-- Добавить рыбу; если аквариум полон — заменить самую слабую (если новая лучше), иначе продать новую
function PlayerService.AddFish(player: Player, fishId: string, mutation: string, sizeIndex: number)
	local profile = Data.Profiles[player]
	local entry = { U = profile.NextUid, Id = fishId, M = mutation, S = sizeIndex }
	profile.NextUid += 1
	local isNew = not profile.Index[fishId]
	profile.Index[fishId] = true
	profile.TotalCaught += 1
	local cap = Stats.Capacity(player, profile)
	local newIncome = GameData.FishIncome(fishId, mutation, sizeIndex)
	local outcome = { Kind = "added", IsNew = isNew, Uid = entry.U }
	if #profile.Fish < cap then
		table.insert(profile.Fish, entry)
	else
		local worstIdx, worstIncome = nil, math.huge
		for i, f in ipairs(profile.Fish) do
			local inc = GameData.FishIncome(f.Id, f.M, f.S)
			if inc < worstIncome then
				worstIdx, worstIncome = i, inc
			end
		end
		if worstIdx and newIncome > worstIncome then
			local old = profile.Fish[worstIdx]
			local price = math.floor(worstIncome * Config.SellSeconds)
			profile.Cash += price
			profile.Fish[worstIdx] = entry
			outcome = { Kind = "swapped", IsNew = isNew, Uid = entry.U, Old = GameData.FullName(old.Id, old.M, old.S), Cash = price }
		else
			local price = math.floor(newIncome * Config.SellSeconds)
			profile.Cash += price
			outcome = { Kind = "sold", IsNew = isNew, Cash = price }
		end
	end
	PlayerService.SyncTank(player)
	PlayerService.UpdateAttributes(player)
	PlayerService.Push(player)
	return outcome
end

return PlayerService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[-- Покупки за игровые деньги: наживки, расширение аквариума, продажа рыбы.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local GameData = require(Shared.GameData)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local Data = require(script.Parent.Data)
local PlayerService = require(script.Parent.PlayerService)
local World = require(script.Parent.World)

local Shop = {}

local function fail(msg: string)
	return { ok = false, msg = msg }
end

local function sellPrice(f): number
	return math.floor(GameData.FishIncome(f.Id, f.M, f.S) * Config.SellSeconds)
end
Shop.SellPrice = sellPrice

function Shop.Init()
	Remotes.Get("BuyBait").OnServerInvoke = function(player, baitId)
		local profile = Data.Get(player)
		local bait = type(baitId) == "string" and GameData.BaitById[baitId]
		if not profile or not bait then
			return fail("Unknown bait")
		end
		if profile.Baits[bait.Id] then
			profile.Bait = bait.Id
			PlayerService.Push(player)
			return { ok = true }
		end
		-- покупать по порядку
		local prev = GameData.Baits[bait.Index - 1]
		if prev and not profile.Baits[prev.Id] then
			return fail("Buy " .. prev.Name .. " first!")
		end
		if profile.Cash < bait.Price then
			return fail("Need " .. Format.Money(bait.Price - profile.Cash) .. " more")
		end
		profile.Cash -= bait.Price
		profile.Baits[bait.Id] = true
		profile.Bait = bait.Id
		PlayerService.UpdateAttributes(player)
		PlayerService.Push(player)
		return { ok = true, bought = true }
	end

	Remotes.Get("EquipBait").OnServerInvoke = function(player, baitId)
		local profile = Data.Get(player)
		if profile and type(baitId) == "string" and profile.Baits[baitId] then
			profile.Bait = baitId
			PlayerService.Push(player)
			return { ok = true }
		end
		return fail("Not owned")
	end

	Remotes.Get("UpgradeTank").OnServerInvoke = function(player)
		return Shop.UpgradeTank(player)
	end
	Remotes.Get("BuyGear").OnServerInvoke = function(player)
		return Shop.BuyGear(player)
	end

	Shop.InitSelling()
end

function Shop.UpgradeTank(player: Player)
	do
		local profile = Data.Get(player)
		if not profile then
			return fail("Loading")
		end
		if profile.TankLevel >= Config.MaxTankUpgrades then
			return fail("Aquarium is maxed!")
		end
		local cost = Config.TankUpgradeCost(profile.TankLevel)
		if profile.Cash < cost then
			return fail("Need " .. Format.Money(cost - profile.Cash) .. " more")
		end
		profile.Cash -= cost
		profile.TankLevel += 1
		PlayerService.UpdateAttributes(player)
		PlayerService.UpdateBase(player)
		PlayerService.SyncTank(player)
		PlayerService.Push(player)
		return { ok = true }
	end
end

function Shop.BuyGear(player: Player)
	do
		local profile = Data.Get(player)
		if not profile then
			return fail("Loading")
		end
		local nextGear = GameData.Gear[(profile.Gear or 1) + 1]
		if not nextGear then
			return fail("You have the best gear!")
		end
		if profile.Cash < nextGear.Price then
			return fail("Need " .. Format.Money(nextGear.Price - profile.Cash) .. " more")
		end
		profile.Cash -= nextGear.Price
		profile.Gear = (profile.Gear or 1) + 1
		PlayerService.UpdateAttributes(player)
		PlayerService.UpdateBase(player)
		PlayerService.Push(player)
		return { ok = true, name = nextGear.Id }
	end
end

function Shop.InitSelling()
	Remotes.Get("SellFish").OnServerInvoke = function(player, uid)
		local profile = Data.Get(player)
		if not profile or type(uid) ~= "number" then
			return fail("Bad request")
		end
		for i, f in ipairs(profile.Fish) do
			if f.U == uid then
				local price = sellPrice(f)
				table.remove(profile.Fish, i)
				profile.Cash += price
				PlayerService.SyncTank(player)
				PlayerService.UpdateAttributes(player)
				PlayerService.Push(player)
				return { ok = true, cash = price }
			end
		end
		return fail("Fish not found")
	end

	-- Продать всех рыб редкости не выше maxRarity (Legendary+ никогда не продаём оптом)
	Remotes.Get("SellBulk").OnServerInvoke = function(player, maxRarity)
		local profile = Data.Get(player)
		if not profile or type(maxRarity) ~= "number" then
			return fail("Bad request")
		end
		maxRarity = math.clamp(math.floor(maxRarity), 1, GameData.RarityIndex.Epic)
		local keep, total, count = {}, 0, 0
		for _, f in ipairs(profile.Fish) do
			local def = GameData.FishById[f.Id]
			if def and def.Rarity <= maxRarity and f.M == "None" then
				total += sellPrice(f)
				count += 1
			else
				table.insert(keep, f)
			end
		end
		if count == 0 then
			return fail("Nothing to sell")
		end
		profile.Fish = keep
		profile.Cash += total
		PlayerService.SyncTank(player)
		PlayerService.UpdateAttributes(player)
		PlayerService.Push(player)
		return { ok = true, cash = total, count = count }
	end

	Remotes.Get("GetState").OnServerInvoke = function(player)
		return PlayerService.Snapshot(player)
	end
end

return Shop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Stats</string><ProtectedString name="Source"><![CDATA[-- Производные характеристики игрока: вместимость, доход, удача, множитель тренировки.
-- Покупки (геймпассы) лежат в атрибутах игрока: Pass_Cash2 = true и т.п.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local GameData = require(Shared.GameData)

local Stats = {}

-- Текущее событие и удача сервера (их выставляет Events)
function Stats.CurrentEvent()
	local id = workspace:GetAttribute("Event")
	local ends = workspace:GetAttribute("EventEnds") or 0
	if id and id ~= "" and os.time() < ends then
		return GameData.Events[id], id
	end
	return nil, nil
end

function Stats.ServerLuck(): number
	local mult = workspace:GetAttribute("ServerLuck") or 1
	local ends = workspace:GetAttribute("ServerLuckEnds") or 0
	if os.time() < ends then
		return mult
	end
	return 1
end

function Stats.HasPass(player: Player, key: string): boolean
	return player:GetAttribute("Pass_" .. key) == true
end

function Stats.Capacity(player: Player, profile): number
	local slots = Config.BaseTankSlots + Config.SlotsPerUpgrade * (profile.TankLevel or 0)
	if Stats.HasPass(player, "BigTank") then
		slots += 10
	end
	return slots
end

function Stats.IncomeMult(player: Player): number
	local m = 1
	if Stats.HasPass(player, "Cash2") then
		m *= 2
	end
	local ev = Stats.CurrentEvent()
	if ev then
		m *= ev.Income
	end
	return m
end

-- Базовый доход аквариума (без событий), за секунду
function Stats.BaseIncome(player: Player, profile): number
	local total = 0
	for _, f in ipairs(profile.Fish) do
		total += GameData.FishIncome(f.Id, f.M, f.S)
	end
	if Stats.HasPass(player, "Cash2") then
		total *= 2
	end
	return total
end

function Stats.Income(player: Player, profile): number
	local total = 0
	for _, f in ipairs(profile.Fish) do
		total += GameData.FishIncome(f.Id, f.M, f.S)
	end
	return total * Stats.IncomeMult(player)
end

function Stats.TrainPassMult(player: Player): number
	local best = 1
	for _, pass in ipairs(Config.TrainingPasses) do
		if Stats.HasPass(player, pass.Key) then
			best = math.max(best, pass.Mult)
		end
	end
	return best
end

function Stats.GearMult(profile): number
	local gear = GameData.Gear[profile.Gear or 1]
	return gear and gear.Mult or 1
end

function Stats.TrainMult(player: Player, profile): number
	local m = Stats.TrainPassMult(player) * Stats.GearMult(profile)
	if (profile.TrainBoostEnds or 0) > os.time() then
		m *= Config.TrainBoostMult
	end
	return m
end

function Stats.BaitLuck(profile): number
	local bait = GameData.BaitById[profile.Bait]
	return bait and bait.Luck or 1
end

-- Удача без учёта дальности и «счастливого заброса»
function Stats.Luck(player: Player, profile): number
	local luck = Stats.BaitLuck(profile) * Stats.ServerLuck()
	if Stats.HasPass(player, "Luck2") then
		luck *= 2
	end
	local ev = Stats.CurrentEvent()
	if ev then
		luck *= ev.Luck
	end
	return luck
end

function Stats.MaxDistance(profile): number
	return Config.MaxDistance(profile.Power)
end

return Stats
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Training</string><ProtectedString name="Source"><![CDATA[-- Турник: игрок висит, повторы идут сами (АФК) и быстрее — по кликам. Каждый повтор = +Power × множитель.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)
local World = require(script.Parent.World)
local PlayerService = require(script.Parent.PlayerService)

local Training = {}

local occupied = {} :: { [BasePart]: Player }

-- Суставы R15 для позы на турнике: имя части -> имя сустава
local JOINTS = {
	{ Part = "RightUpperLeg", Joint = "RightHip", Kind = "Hip", Side = 1 },
	{ Part = "LeftUpperLeg", Joint = "LeftHip", Kind = "Hip", Side = -1 },
	{ Part = "RightLowerLeg", Joint = "RightKnee", Kind = "Knee", Side = 1 },
	{ Part = "LeftLowerLeg", Joint = "LeftKnee", Kind = "Knee", Side = -1 },
}

-- Руки держатся за перекладину через IK: кисти прибиты к точкам на перекладине,
-- локти сгибаются сами, когда тело поднимается. Работает на любом R15-аватаре.
local function setupIK(character: Model, bar: BasePart)
	local created = {}
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return created
	end
	for _, side in ipairs({ "Right", "Left" }) do
		local upper = character:FindFirstChild(side .. "UpperArm")
		local hand = character:FindFirstChild(side .. "Hand")
		if upper and hand then
			local x = side == "Right" and 1.35 or -1.35
			local target = Instance.new("Attachment")
			target.Name = "IKTarget_" .. side
			-- ось цилиндра-перекладины = локальная X; игрок смотрит в -Z
			target.Position = Vector3.new(x, -0.25, 0)
			target.Parent = bar
			local pole = Instance.new("Attachment")
			pole.Name = "IKPole_" .. side
			-- локти уходят в стороны и назад
			pole.Position = Vector3.new(x * 2.6, -3.5, 2.5)
			pole.Parent = bar
			local ik = Instance.new("IKControl")
			ik.Name = "PullUpIK_" .. side
			ik.Type = Enum.IKControlType.Position
			ik.ChainRoot = upper
			ik.EndEffector = hand
			ik.Target = target
			ik.Pole = pole
			ik.Weight = 1
			ik.SmoothTime = 0.05
			ik.Parent = hum
			table.insert(created, ik)
			table.insert(created, target)
			table.insert(created, pole)
		end
	end
	return created
end

-- Поза: top = false — вис на прямых руках, true — подбородок над перекладиной
local function poseOffset(kind: string, side: number, top: boolean): CFrame
	local _ = side
	if kind == "Hip" then
		return top and CFrame.Angles(math.rad(40), 0, 0) or CFrame.Angles(math.rad(12), 0, 0)
	elseif kind == "Knee" then
		return top and CFrame.Angles(math.rad(-85), 0, 0) or CFrame.Angles(math.rad(-40), 0, 0)
	end
	return CFrame.identity
end

local function collectJoints(character: Model)
	local saved = {}
	for _, j in ipairs(JOINTS) do
		local part = character:FindFirstChild(j.Part)
		local joint = part and part:FindFirstChild(j.Joint)
		if joint and joint:IsA("Motor6D") then
			saved[joint] = { C0 = joint.C0, Kind = j.Kind, Side = j.Side }
		end
	end
	return saved
end

local function applyPose(saved, top: boolean, duration: number, style: Enum.EasingStyle?)
	for joint, info in pairs(saved) do
		if joint.Parent then
			local goal = info.C0 * poseOffset(info.Kind, info.Side, top)
			if duration <= 0 then
				joint.C0 = goal
			else
				TweenService:Create(joint, TweenInfo.new(duration, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = goal }):Play()
			end
		end
	end
end

local function stop(player: Player)
	local _, session = Data.Get(player)
	local state = session and session.Training
	if not state then
		return
	end
	session.Training = nil
	occupied[state.Bar] = nil
	player:SetAttribute("Training", false)
	local character = player.Character
	if character then
		for joint, info in pairs(state.SavedC0) do
			if joint.Parent then
				-- новый твин отменяет недоигранный твин позы
				TweenService:Create(joint, TweenInfo.new(0.08), { C0 = info.C0 }):Play()
			end
		end
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			root.Anchored = false
			root.CFrame = state.Bar.CFrame * CFrame.new(0, -6.5, 3.5)
		end
		PlayerService.SetRodVisible(character, true)
	end
	for _, inst in ipairs(state.IK or {}) do
		inst:Destroy()
	end
end

local function doRep(player: Player, fromClick: boolean)
	local profile, session = Data.Get(player)
	local state = session and session.Training
	if not profile or not state then
		return
	end
	local gain = Config.PowerPerRep * Stats.TrainMult(player, profile)
	profile.Power += gain
	PlayerService.UpdateAttributes(player)
	Remotes.Get("Rep"):FireClient(player, gain)
	-- анимация подтягивания (видят все)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root and not state.Animating then
		state.Animating = true
		-- рывок вверх: руки сгибаются, ноги поджимаются, тело поднимается
		local upTime = fromClick and 0.17 or 0.32
		local downTime = fromClick and 0.22 or 0.45
		applyPose(state.SavedC0, true, upTime)
		local up = TweenService:Create(root, TweenInfo.new(upTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = state.HangCf * CFrame.new(0, 1.9, 0) })
		up:Play()
		up.Completed:Connect(function()
			if not session.Training then
				return
			end
			applyPose(state.SavedC0, false, downTime, Enum.EasingStyle.Sine)
			local down = TweenService:Create(root, TweenInfo.new(downTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = state.HangCf })
			down:Play()
			down.Completed:Connect(function()
				state.Animating = false
			end)
		end)
	end
	local _ = fromClick
end

local function start(player: Player, bar: BasePart)
	local profile, session = Data.Get(player)
	if not profile or not session or session.Training then
		return
	end
	if occupied[bar] and occupied[bar].Parent then
		PlayerService.Notify(player, "This bar is taken!", Color3.fromRGB(255, 120, 90))
		return
	end
	if session.Pending and os.clock() < session.Pending.Expires then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	local hangCf = bar.CFrame * CFrame.new(0, -3.6, 0) -- ориентация турника: смотрим наружу
	hangCf = CFrame.lookAt(hangCf.Position, hangCf.Position + bar.CFrame.LookVector)
	local plot = World.PlotOf(player)
	if not plot or plot.Bars[1] ~= bar then
		PlayerService.Notify(player, "💪 Train on the bar at YOUR base!", Color3.fromRGB(255, 200, 90))
		return
	end
	local saved = collectJoints(character)
	applyPose(saved, false, 0.2)
	local ik = setupIK(character, bar)
	root.Anchored = true
	root.CFrame = hangCf
	PlayerService.SetRodVisible(character, false)
	occupied[bar] = player
	session.Training = { Bar = bar, HangCf = hangCf, SavedC0 = saved, IK = ik, NextAfk = os.clock() + Config.AfkRepInterval }
	player:SetAttribute("Training", true)
end

function Training.Init()
	local bars = {}
	for _, plot in ipairs(World.Plots) do
		for _, b in ipairs(plot.Bars) do
			table.insert(bars, b)
		end
	end
	for _, b in ipairs(World.GymBars or {}) do
		table.insert(bars, b)
	end
	for _, bar in ipairs(bars) do
		local prompt = bar:FindFirstChild("TrainPrompt", true)
		if prompt then
			prompt.Triggered:Connect(function(player)
				start(player, bar)
			end)
		end
	end

	Remotes.Get("StopTraining").OnServerInvoke = function(player)
		stop(player)
		return true
	end

	Remotes.Get("Rep").OnServerEvent:Connect(function(player)
		local _, session = Data.Get(player)
		if not session or not session.Training then
			return
		end
		local now = os.clock()
		if now - session.LastClickRep >= Config.ClickRepInterval then
			session.LastClickRep = now
			session.Training.NextAfk = now + Config.AfkRepInterval
			doRep(player, true)
		end
	end)

	-- АФК-повторы
	task.spawn(function()
		while true do
			task.wait(0.1)
			local now = os.clock()
			for _, player in ipairs(Players:GetPlayers()) do
				local _, session = Data.Get(player)
				local state = session and session.Training
				if state then
					local character = player.Character
					local humanoid = character and character:FindFirstChildOfClass("Humanoid")
					if not humanoid or humanoid.Health <= 0 then
						stop(player)
					elseif now >= state.NextAfk then
						state.NextAfk = now + Config.AfkRepInterval
						doRep(player, false)
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		for bar, p in pairs(occupied) do
			if p == player then
				occupied[bar] = nil
			end
		end
	end)
end

Training.Stop = stop

return Training
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- Строит весь мир скриптом при старте сервера: океан, остров, базы игроков
-- (забор, ворота, аквариум, турник), общий пирс для заброса, центр со статуей и магазинами, буи зон, вечернее освещение.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local GameData = require(Shared.GameData)
local FishBuilder = require(Shared.FishBuilder)

local World = {}
World.Plots = {} -- [index] = plot table
World.Pier = nil :: any

local terrain = workspace.Terrain

local GROUND_Y = 4
local DECK_Y = 4.6
local PLOT_R = 96
local PIER_START = 112
local PIER_END = 250
local PIER_W = 18
local END_W = 66
local END_DEPTH = 26

local rng = Random.new(1337)

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local WOOD = rgb(170, 120, 75)
local WOOD_DARK = rgb(120, 82, 52)
local PLOT_COLORS = {
	rgb(255, 90, 90),
	rgb(255, 170, 50),
	rgb(255, 230, 70),
	rgb(90, 220, 110),
	rgb(70, 200, 255),
	rgb(90, 120, 255),
	rgb(190, 100, 255),
	rgb(255, 110, 200),
}

local function P(props: { [string]: any }): BasePart
	local class = props.Class or "Part"
	local p = Instance.new(class) :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		if k ~= "Class" and k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	p.Parent = props.Parent
	return p
end

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function model(name: string, parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function billboard(parent: Instance, size: UDim2, offset: Vector3, maxDist: number): BillboardGui
	local bb = Instance.new("BillboardGui")
	bb.Size = size
	bb.StudsOffset = offset
	bb.MaxDistance = maxDist
	bb.LightInfluence = 0
	bb.AlwaysOnTop = false
	bb.Parent = parent
	return bb
end

local function label(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3, font: Enum.Font?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = size
	t.Position = pos
	t.Text = text
	t.TextColor3 = color
	t.TextScaled = true
	t.Font = font or Enum.Font.LuckiestGuy
	t.TextStrokeTransparency = 0
	t.TextStrokeColor3 = rgb(15, 15, 25)
	t.Parent = parent
	return t
end

local function surfaceSign(part: BasePart, face: Enum.NormalId, text: string, color: Color3): TextLabel
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.CanvasSize = Vector2.new(500, 100)
	sg.LightInfluence = 0
	sg.Parent = part
	return label(sg, text, UDim2.fromScale(0.94, 0.86), UDim2.fromScale(0.03, 0.07), color)
end

-- ===== Освещение: вечер =====
local function setupLighting()
	Lighting.ClockTime = 17.55
	Lighting.Brightness = 2.2
	Lighting.Ambient = rgb(80, 70, 90)
	Lighting.OutdoorAmbient = rgb(160, 125, 135)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.35
	Lighting.GeographicLatitude = 25
	Lighting.ColorShift_Top = rgb(255, 200, 150)

	local atm = Instance.new("Atmosphere")
	atm.Density = 0.32
	atm.Offset = 0.15
	atm.Color = rgb(255, 205, 175)
	atm.Decay = rgb(130, 95, 160)
	atm.Glare = 0.6
	atm.Haze = 1.6
	atm.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.4
	bloom.Size = 24
	bloom.Threshold = 2
	bloom.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "MainColor"
	cc.Saturation = 0.22
	cc.Contrast = 0.08
	cc.Brightness = 0.02
	cc.TintColor = rgb(255, 242, 232)
	cc.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.12
	rays.Spread = 0.7
	rays.Parent = Lighting

	local sky = Instance.new("Sky")
	sky.SunAngularSize = 18
	sky.MoonAngularSize = 9
	sky.StarCount = 3000
	sky.Parent = Lighting

	local clouds = Instance.new("Clouds")
	clouds.Cover = 0.5
	clouds.Density = 0.6
	clouds.Color = rgb(255, 215, 200)
	clouds.Parent = terrain

	terrain.WaterColor = rgb(20, 130, 170)
	terrain.WaterTransparency = 0.5
	terrain.WaterReflectance = 0.6
	terrain.WaterWaveSize = 0.22
	terrain.WaterWaveSpeed = 10
	terrain:SetMaterialColor(Enum.Material.Grass, rgb(95, 175, 75))
	terrain:SetMaterialColor(Enum.Material.Sand, rgb(240, 215, 160))
	terrain:SetMaterialColor(Enum.Material.Rock, rgb(130, 120, 120))
end

-- ===== Рельеф =====
local function buildTerrain()
	terrain:FillBlock(CFrame.new(0, -54, 0), Vector3.new(2000, 12, 2000), Enum.Material.Sand)
	terrain:FillBlock(CFrame.new(0, -24, 0), Vector3.new(2000, 48, 2000), Enum.Material.Water)
	terrain:FillCylinder(CFrame.new(0, -26, 0), 44, 192, Enum.Material.Sand)
	terrain:FillCylinder(CFrame.new(0, -24.5, 0), 47, 178, Enum.Material.Sand)
	terrain:FillCylinder(CFrame.new(0, -23, 0), 50, 166, Enum.Material.Sand)
	terrain:FillCylinder(CFrame.new(0, 0.5, 0), 7, 130, Enum.Material.Grass)
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2 + rng:NextNumber(-0.08, 0.08)
		-- у пирса (угол 0) камней нет
		if i % 3 ~= 0 and math.abs(math.sin(a)) > 0.2 then
			local r = rng:NextNumber(150, 172)
			terrain:FillBall(Vector3.new(math.cos(a) * r, rng:NextNumber(-1, 1), math.sin(a) * r), rng:NextNumber(3, 6), Enum.Material.Rock)
		end
	end
	for _ = 1, 60 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(300, 900)
		terrain:FillBall(Vector3.new(math.cos(a) * r, -46, math.sin(a) * r), rng:NextNumber(6, 16), Enum.Material.Rock)
	end
end

-- ===== Декор =====
local function palm(parent: Instance, pos: Vector3, height: number)
	local m = model("Palm", parent)
	local lean = rng:NextNumber(-0.25, 0.25)
	local leanZ = rng:NextNumber(-0.25, 0.25)
	local segs = 6
	local top = pos
	for i = 0, segs - 1 do
		local f = i / segs
		local a = pos + Vector3.new(lean * height * f * f, height * f, leanZ * height * f * f)
		local f2 = (i + 1) / segs
		local b = pos + Vector3.new(lean * height * f2 * f2, height * f2, leanZ * height * f2 * f2)
		local mid = (a + b) / 2
		P({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new((b - a).Magnitude + 0.3, 1.6 - f * 0.5, 1.6 - f * 0.5),
			CFrame = CFrame.lookAt(mid, b) * CFrame.Angles(0, math.pi / 2, 0),
			Color = i % 2 == 0 and rgb(150, 110, 70) or rgb(130, 95, 60),
			Material = Enum.Material.Wood,
			Parent = m,
		})
		top = b
	end
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local leafLen = height * 0.55
		local mid = top + dir * (leafLen * 0.45) + Vector3.new(0, -leafLen * 0.12, 0)
		local p = P({
			Size = Vector3.new(leafLen * 0.32, 0.25, leafLen),
			CFrame = CFrame.lookAt(mid, mid + dir + Vector3.new(0, -0.35, 0)),
			Color = (i % 2 == 0) and rgb(70, 160, 70) or rgb(55, 135, 60),
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = m,
		})
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	for i = 0, 2 do
		local a = i / 3 * math.pi * 2
		P({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.1, 1.1, 1.1), Position = top + Vector3.new(math.cos(a) * 0.7, -0.8, math.sin(a) * 0.7), Color = rgb(110, 75, 40), Parent = m })
	end
end

local GREENS = { rgb(70, 160, 70), rgb(90, 180, 75), rgb(55, 140, 60), rgb(110, 190, 80) }

-- Куст: плотная шапка из перекрывающихся шаров разных оттенков
local function bush(parent: Instance, pos: Vector3, size: number?)
	local s0 = size or rng:NextNumber(3, 4.5)
	local m = model("Bush", parent)
	for i = 1, 7 do
		local a = i / 7 * math.pi * 2
		local r = (i == 7) and 0 or s0 * 0.35
		local s = s0 * rng:NextNumber(0.55, 0.8)
		P({ Shape = Enum.PartType.Ball, Size = Vector3.new(s, s, s), Position = pos + Vector3.new(math.cos(a) * r, s * 0.38 + (i == 7 and s0 * 0.25 or 0), math.sin(a) * r), Color = GREENS[rng:NextInteger(1, #GREENS)], CanCollide = i == 7, Parent = m })
	end
end

-- Пучок травы: несколько тонких наклонённых травинок
local function grassTuft(parent: Instance, pos: Vector3)
	local base = GREENS[rng:NextInteger(1, #GREENS)]
	for _ = 1, rng:NextInteger(4, 7) do
		local h = rng:NextNumber(1, 2.2)
		local yaw = rng:NextNumber(0, math.pi * 2)
		local tilt = rng:NextNumber(0.1, 0.45)
		local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(tilt, 0, 0) * CFrame.new(0, h / 2, 0)
		P({ Class = "WedgePart", Size = Vector3.new(0.12, h, 0.45), CFrame = cf, Color = base:Lerp(rgb(170, 220, 90), rng:NextNumber(0, 0.35)), CanCollide = false, CanQuery = false, CastShadow = false, Parent = parent })
	end
end

-- Цветок: стебель, 5 лепестков, серединка
local function flower(parent: Instance, pos: Vector3, color: Color3)
	local h = rng:NextNumber(1.2, 2)
	P({ Size = Vector3.new(0.12, h, 0.12), Position = pos + Vector3.new(0, h / 2, 0), Color = rgb(60, 140, 55), CanCollide = false, CastShadow = false, Parent = parent })
	local top = pos + Vector3.new(0, h, 0)
	local yaw = rng:NextNumber(0, math.pi * 2)
	for i = 0, 4 do
		local a = yaw + i / 5 * math.pi * 2
		local cf = CFrame.new(top) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -0.32) * CFrame.Angles(-0.3, 0, 0)
		local petal = P({ Size = Vector3.new(0.42, 0.1, 0.55), CFrame = cf, Color = color, CanCollide = false, CastShadow = false, Parent = parent })
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = petal
	end
	P({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.32, 0.32, 0.32), Position = top + Vector3.new(0, 0.06, 0), Color = rgb(255, 210, 60), CanCollide = false, CastShadow = false, Parent = parent })
end

local FLOWER_COLORS = { rgb(255, 110, 150), rgb(255, 225, 80), rgb(255, 255, 255), rgb(180, 120, 255), rgb(255, 140, 70) }

local function flowerPatch(parent: Instance, center: Vector3, count: number)
	local color = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)]
	for _ = 1, count do
		flower(parent, center + Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3)), color)
	end
end

-- Камни: 2-4 гранёных блока под разными углами
local function rocks(parent: Instance, pos: Vector3, scale: number?)
	local k = scale or 1
	for i = 1, rng:NextInteger(2, 4) do
		local s = Vector3.new(rng:NextNumber(1.5, 3.5), rng:NextNumber(1.2, 2.6), rng:NextNumber(1.5, 3.2)) * k
		local c = rgb(125, 125, 130):Lerp(rgb(165, 160, 150), rng:NextNumber())
		P({ Size = s, CFrame = CFrame.new(pos + Vector3.new(rng:NextNumber(-1.5, 1.5) * k, s.Y * 0.3, rng:NextNumber(-1.5, 1.5) * k)) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6), rng:NextNumber(-0.4, 0.4)), Color = c, Material = Enum.Material.Slate, Parent = parent })
		local _ = i
	end
end

-- Морская звезда на песке
local function starfish(parent: Instance, pos: Vector3)
	local color = ({ rgb(255, 120, 70), rgb(255, 90, 120), rgb(255, 200, 80) })[rng:NextInteger(1, 3)]
	local yaw = rng:NextNumber(0, math.pi * 2)
	for i = 0, 4 do
		local a = yaw + i / 5 * math.pi * 2
		local arm = P({ Size = Vector3.new(0.45, 0.2, 1), CFrame = CFrame.new(pos + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -0.45), Color = color, CanCollide = false, Parent = parent })
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = arm
	end
end

-- Пляжный зонт с двумя шезлонгами
local function beachSet(parent: Instance, pos: Vector3, facing: Vector3)
	local m = model("BeachSet", parent)
	local colors = { rgb(255, 90, 90), rgb(255, 255, 255) }
	P({ Size = Vector3.new(0.3, 8, 0.3), Position = pos + Vector3.new(0, 4, 0), Color = rgb(240, 240, 240), Parent = m })
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		P({ Class = "WedgePart", Size = Vector3.new(2.1, 1.3, 3.6), CFrame = CFrame.new(pos + Vector3.new(0, 8, 0)) * CFrame.Angles(0, a, 0) * CFrame.new(0, -0.45, -1.8), Color = colors[i % 2 + 1], CanCollide = false, Parent = m })
	end
	local cf = CFrame.lookAt(pos, pos + facing)
	for _, x in ipairs({ -2.2, 2.2 }) do
		P({ Size = Vector3.new(1.8, 0.3, 4.5), CFrame = cf * CFrame.new(x, 0.9, 1.5), Color = rgb(80, 170, 255), Parent = m })
		P({ Size = Vector3.new(1.8, 0.3, 1.8), CFrame = cf * CFrame.new(x, 1.5, 3.9) * CFrame.Angles(-0.7, 0, 0), Color = rgb(80, 170, 255), Parent = m })
		for _, z in ipairs({ -0.4, 3.4 }) do
			P({ Size = Vector3.new(1.6, 0.8, 0.2), CFrame = cf * CFrame.new(x, 0.4, z), Color = rgb(240, 240, 240), Parent = m })
		end
	end
end

local function barrel(parent: Instance, pos: Vector3)
	P({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.6, 2, 2), CFrame = CFrame.new(pos + Vector3.new(0, 1.3, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(150, 100, 60), Material = Enum.Material.Wood, Parent = parent })
	for _, y in ipairs({ 0.4, 2.2 }) do
		P({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, 2.1, 2.1), CFrame = CFrame.new(pos + Vector3.new(0, y, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(80, 80, 90), Material = Enum.Material.Metal, Parent = parent })
	end
end

local function crate(parent: Instance, pos: Vector3, size: number?)
	local s = size or 2.4
	local cf = CFrame.new(pos + Vector3.new(0, s / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 1.5), 0)
	P({ Size = Vector3.new(s, s, s), CFrame = cf, Color = rgb(190, 140, 85), Material = Enum.Material.WoodPlanks, Parent = parent })
	for _, e in ipairs({ { 1, 1 }, { -1, 1 }, { 1, -1 }, { -1, -1 } }) do
		P({ Size = Vector3.new(0.3, s + 0.05, 0.3), CFrame = cf * CFrame.new(e[1] * (s / 2 - 0.1), 0, e[2] * (s / 2 - 0.1)), Color = rgb(120, 82, 52), Material = Enum.Material.Wood, Parent = parent })
	end
end

local function rowboat(parent: Instance, cf: CFrame)
	local m = model("Rowboat", parent)
	local hull = rgb(235, 235, 240)
	local trim = rgb(60, 130, 220)
	P({ Size = Vector3.new(4, 0.5, 9), CFrame = cf * CFrame.new(0, 0, 0), Color = hull, Parent = m })
	for _, x in ipairs({ -2, 2 }) do
		P({ Size = Vector3.new(0.4, 1.6, 9), CFrame = cf * CFrame.new(x, 0.8, 0), Color = trim, Parent = m })
	end
	P({ Class = "WedgePart", Size = Vector3.new(4.4, 1.6, 2.6), CFrame = cf * CFrame.new(0, 0.8, -5.7), Color = hull, Parent = m })
	P({ Size = Vector3.new(4.4, 1.6, 0.4), CFrame = cf * CFrame.new(0, 0.8, 4.6), Color = trim, Parent = m })
	P({ Size = Vector3.new(3.6, 0.3, 1.2), CFrame = cf * CFrame.new(0, 1, 0.5), Color = WOOD, Material = Enum.Material.Wood, Parent = m })
	for _, x in ipairs({ -1, 1 }) do
		P({ Size = Vector3.new(0.25, 0.25, 5), CFrame = cf * CFrame.new(x * 2.6, 1.2, 0.5) * CFrame.Angles(0.3, x * 0.5, 0), Color = WOOD_DARK, Material = Enum.Material.Wood, Parent = m })
	end
end

-- Фонарь: тёмный столб с кронштейном и застеклённым плафоном (мягкий свет, без «каши»)
local function lantern(parent: Instance, pos: Vector3, height: number?)
	local h = height or 6
	local dark = rgb(45, 40, 40)
	P({ Size = Vector3.new(0.45, h, 0.45), Position = pos + Vector3.new(0, h / 2, 0), Color = dark, Material = Enum.Material.Metal, Parent = parent })
	P({ Size = Vector3.new(1, 0.5, 1), Position = pos + Vector3.new(0, 0.25, 0), Color = dark, Material = Enum.Material.Metal, Parent = parent })
	P({ Size = Vector3.new(1.3, 0.25, 1.3), Position = pos + Vector3.new(0, h + 1.5, 0), Color = dark, Material = Enum.Material.Metal, Parent = parent })
	P({ Size = Vector3.new(1.05, 1.3, 1.05), Position = pos + Vector3.new(0, h + 0.75, 0), Color = rgb(255, 230, 180), Material = Enum.Material.Glass, Transparency = 0.45, CanCollide = false, Parent = parent })
	local bulb = P({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.45, 0.45, 0.45), Position = pos + Vector3.new(0, h + 0.75, 0), Color = rgb(255, 200, 120), Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
	local light = Instance.new("PointLight")
	light.Color = rgb(255, 185, 110)
	light.Range = 14
	light.Brightness = 1.1
	light.Shadows = false
	light.Parent = bulb
end

-- Деревянный забор по отрезку: столбики + две доски
local function fence(parent: Instance, a: Vector3, b: Vector3, height: number?)
	local h = height or 3.6
	local len = (b - a).Magnitude
	if len < 0.5 then
		return
	end
	local dir = (b - a).Unit
	local n = math.max(1, math.floor(len / 5))
	for i = 0, n do
		local p = a + dir * (len * i / n)
		P({ Size = Vector3.new(0.7, h + 0.4, 0.7), CFrame = CFrame.lookAt(p, p + dir) * CFrame.new(0, (h + 0.4) / 2, 0), Color = WOOD_DARK, Material = Enum.Material.Wood, Parent = parent })
	end
	local mid = (a + b) / 2
	for _, y in ipairs({ h * 0.38, h * 0.82 }) do
		P({ Size = Vector3.new(0.35, 0.75, len), CFrame = CFrame.lookAt(mid, mid + dir) * CFrame.new(0, y, 0), Color = WOOD, Material = Enum.Material.WoodPlanks, Parent = parent })
	end
end

-- ===== Турник (вид зависит от снаряда владельца) =====
local BAR_LOOKS = {
	{ Post = rgb(120, 80, 60), PostMat = Enum.Material.CorrodedMetal, Bar = rgb(150, 100, 70), BarMat = Enum.Material.CorrodedMetal },
	{ Post = rgb(70, 80, 95), PostMat = Enum.Material.Metal, Bar = rgb(220, 225, 235), BarMat = Enum.Material.Metal },
	{ Post = rgb(90, 70, 30), PostMat = Enum.Material.Metal, Bar = rgb(255, 205, 60), BarMat = Enum.Material.Foil },
	{ Post = rgb(60, 90, 120), PostMat = Enum.Material.Metal, Bar = rgb(140, 235, 255), BarMat = Enum.Material.Glass },
	{ Post = rgb(50, 30, 80), PostMat = Enum.Material.Metal, Bar = rgb(200, 110, 255), BarMat = Enum.Material.Neon },
	{ Post = rgb(70, 20, 20), PostMat = Enum.Material.Metal, Bar = rgb(255, 80, 80), BarMat = Enum.Material.Neon },
	{ Post = rgb(20, 60, 45), PostMat = Enum.Material.Metal, Bar = rgb(60, 255, 170), BarMat = Enum.Material.Neon },
}

function World.SetBarTier(barModel: Model, tier: number)
	local look = BAR_LOOKS[math.clamp(tier, 1, #BAR_LOOKS)]
	for _, p in ipairs(barModel:GetChildren()) do
		if p:IsA("BasePart") then
			if p.Name == "Bar" then
				p.Color = look.Bar
				p.Material = look.BarMat
			elseif p.Name == "Post" then
				p.Color = look.Post
				p.Material = look.PostMat
			end
		end
	end
	local bar = barModel:FindFirstChild("Bar")
	local sparkle = bar and bar:FindFirstChild("TierSparkle") :: ParticleEmitter?
	if sparkle then
		sparkle.Enabled = tier >= 4
		sparkle.Color = ColorSequence.new(look.Bar)
	end
end

local function pullUpBar(parent: Instance, cf: CFrame, index: number): Model
	local m = model("PullUpBar", parent)
	for _, side in ipairs({ -1, 1 }) do
		local post = P({ Size = Vector3.new(0.8, 10.4, 0.8), CFrame = cf * CFrame.new(side * 3.4, 5.2, 0), Parent = m })
		post.Name = "Post"
		local foot = P({ Size = Vector3.new(1.8, 0.6, 1.8), CFrame = cf * CFrame.new(side * 3.4, 0.3, 0), Parent = m })
		foot.Name = "Post"
	end
	local bar = P({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(7.6, 0.5, 0.5), CFrame = cf * CFrame.new(0, 9.8, 0), Parent = m })
	bar.Name = "Bar"
	bar:SetAttribute("BarId", index)
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Name = "TierSparkle"
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.LightEmission = 1
	sparkle.Size = NumberSequence.new(0.4, 0)
	sparkle.Lifetime = NumberRange.new(0.6, 1)
	sparkle.Rate = 10
	sparkle.Speed = NumberRange.new(1, 2)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Enabled = false
	sparkle.Parent = bar
	local mat = P({ Size = Vector3.new(6.6, 0.25, 4.4), CFrame = cf * CFrame.new(0, 0.12, 0), Color = rgb(255, 120, 60), CanCollide = false, Parent = m })
	mat.Name = "Mat"
	local att = Instance.new("Attachment")
	att.Position = Vector3.new(0, -5, 0)
	att.Parent = bar
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "TrainPrompt"
	prompt.ActionText = "Train"
	prompt.ObjectText = "Pull-up Bar"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = att
	local bb = billboard(bar, UDim2.fromOffset(170, 44), Vector3.new(0, 2.4, 0), 70)
	label(bb, "💪 TRAIN", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), rgb(255, 230, 90))
	World.SetBarTier(m, 1)
	return m
end

-- ===== Аквариум (5 уровней вида) =====
local TANK_FRAMES = {
	{ Color = WOOD_DARK, Mat = Enum.Material.Wood },
	{ Color = rgb(150, 105, 65), Mat = Enum.Material.WoodPlanks },
	{ Color = rgb(255, 200, 60), Mat = Enum.Material.Foil },
	{ Color = rgb(80, 220, 255), Mat = Enum.Material.Neon },
	{ Color = rgb(255, 120, 230), Mat = Enum.Material.Neon },
}

local function buildTank(parent: Instance, cf: CFrame, tier: number, accent: Color3)
	local m = Instance.new("Model")
	m.Name = "Tank"
	local W = 18 + tier * 4
	local H = 9 + tier * 0.7
	local D = 8 + tier * 0.6
	local baseH = 1.6
	local frame = TANK_FRAMES[tier + 1] or TANK_FRAMES[1]
	P({ Size = Vector3.new(W + 2, baseH, D + 2), CFrame = cf * CFrame.new(0, baseH / 2, 0), Color = rgb(80, 85, 100), Material = Enum.Material.Slate, Parent = m })
	if tier >= 2 then
		P({ Size = Vector3.new(W + 2.4, 0.35, D + 2.4), CFrame = cf * CFrame.new(0, baseH - 0.15, 0), Color = accent, Material = Enum.Material.Neon, CanCollide = false, Parent = m })
	end
	local glassY = baseH + H / 2
	local function wall(size: Vector3, offset: Vector3)
		P({ Size = size, CFrame = cf * CFrame.new(offset), Color = rgb(200, 240, 255), Material = Enum.Material.Glass, Transparency = 0.82, Parent = m })
	end
	wall(Vector3.new(W, H, 0.3), Vector3.new(0, glassY, -D / 2))
	wall(Vector3.new(W, H, 0.3), Vector3.new(0, glassY, D / 2))
	wall(Vector3.new(0.3, H, D), Vector3.new(-W / 2, glassY, 0))
	wall(Vector3.new(0.3, H, D), Vector3.new(W / 2, glassY, 0))
	for _, z in ipairs({ -D / 2, D / 2 }) do
		P({ Size = Vector3.new(W + 0.8, 0.6, 0.6), CFrame = cf * CFrame.new(0, baseH + H, z), Color = frame.Color, Material = frame.Mat, Parent = m })
	end
	for _, x in ipairs({ -W / 2, W / 2 }) do
		P({ Size = Vector3.new(0.6, 0.6, D + 0.8), CFrame = cf * CFrame.new(x, baseH + H, 0), Color = frame.Color, Material = frame.Mat, Parent = m })
		for _, z in ipairs({ -D / 2, D / 2 }) do
			P({ Size = Vector3.new(0.6, H, 0.6), CFrame = cf * CFrame.new(x, glassY, z), Color = frame.Color, Material = frame.Mat, Parent = m })
		end
	end
	P({ Size = Vector3.new(W - 0.4, 1, D - 0.4), CFrame = cf * CFrame.new(0, baseH + 0.5, 0), Color = rgb(240, 220, 160), Material = Enum.Material.Sand, CanCollide = false, Parent = m })
	local water = P({
		Size = Vector3.new(W - 0.6, H - 1.6, D - 0.6),
		CFrame = cf * CFrame.new(0, baseH + 1 + (H - 1.6) / 2, 0),
		Color = rgb(70, 190, 230),
		Transparency = 0.8,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = m,
	})
	water.Name = "Water"
	local light = Instance.new("PointLight")
	light.Color = rgb(120, 220, 255)
	light.Range = 14 + tier * 3
	light.Brightness = 1.4
	light.Parent = water
	local coralColors = { rgb(255, 110, 150), rgb(255, 170, 80), rgb(170, 110, 255), rgb(90, 220, 200) }
	for i = 1, 5 + tier * 3 do
		local x = rng:NextNumber(-W / 2 + 1.5, W / 2 - 1.5)
		local z = rng:NextNumber(0.5, D / 2 - 1.2)
		local h = rng:NextNumber(1.2, 3.2)
		local c = coralColors[(i % #coralColors) + 1]
		P({ Size = Vector3.new(0.5, h, 0.5), CFrame = cf * CFrame.new(x, baseH + 1 + h / 2, z) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), 0, rng:NextNumber(-0.3, 0.3)), Color = c, CanCollide = false, Parent = m })
		P({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9), CFrame = cf * CFrame.new(x, baseH + 1 + h, z), Color = c, Material = Enum.Material.Neon, CanCollide = false, Parent = m })
	end
	if tier >= 1 then
		for _ = 1, 3 + tier * 2 do
			local x = rng:NextNumber(-W / 2 + 1, W / 2 - 1)
			local h = rng:NextNumber(3, H - 2)
			P({ Size = Vector3.new(0.35, h, 0.35), CFrame = cf * CFrame.new(x, baseH + 1 + h / 2, rng:NextNumber(1, D / 2 - 0.8)) * CFrame.Angles(0, 0, rng:NextNumber(-0.15, 0.15)), Color = rgb(60, 190, 90), Material = Enum.Material.Grass, CanCollide = false, Parent = m })
		end
	end
	if tier >= 4 then
		local chest = cf * CFrame.new(W / 2 - 3, baseH + 1.7, 0)
		P({ Size = Vector3.new(2.4, 1.4, 1.6), CFrame = chest, Color = rgb(140, 90, 50), Material = Enum.Material.Wood, CanCollide = false, Parent = m })
		local gold = P({ Size = Vector3.new(2, 0.5, 1.2), CFrame = chest * CFrame.new(0, 0.9, 0), Color = rgb(255, 210, 60), Material = Enum.Material.Neon, CanCollide = false, Parent = m })
		local gl = Instance.new("PointLight")
		gl.Color = rgb(255, 200, 80)
		gl.Range = 8
		gl.Parent = gold
	end
	local bubbles = Instance.new("ParticleEmitter")
	bubbles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	bubbles.Color = ColorSequence.new(rgb(220, 250, 255))
	bubbles.Size = NumberSequence.new(0.25)
	bubbles.Transparency = NumberSequence.new(0.3)
	bubbles.Lifetime = NumberRange.new(2, 3)
	bubbles.Rate = 6 + tier * 3
	bubbles.Speed = NumberRange.new(2.5, 4)
	bubbles.EmissionDirection = Enum.NormalId.Top
	bubbles.SpreadAngle = Vector2.new(10, 10)
	bubbles.LightEmission = 0.5
	bubbles.Parent = water
	local prompt = nil
	local fish = folder("Fish", m)
	m:SetAttribute("Tier", tier)
	m.Parent = parent
	return m, water, fish, prompt
end

-- Пересобрать аквариум под новый уровень, рыб перенести
function World.RebuildTank(plot, tier: number)
	local oldFish = plot.FishFolder:GetChildren()
	local tank, water, fish, prompt = buildTank(plot.Model, plot.TankCf, tier, plot.Color)
	for _, f in ipairs(oldFish) do
		f.Parent = fish
		local len = f:GetAttribute("Length") or 2
		local half = water.Size / 2 - Vector3.new(len * 0.6, len * 0.35, len * 0.45)
		f:PivotTo(water.CFrame * CFrame.new(rng:NextNumber(-half.X, half.X), rng:NextNumber(-math.max(0.1, half.Y), math.max(0.1, half.Y)), 0))
	end
	plot.Tank:Destroy()
	plot.Tank, plot.Water, plot.FishFolder, plot.TankPrompt = tank, water, fish, prompt
	plot.TankTier = tier
end

-- ===== База игрока =====
local function buildBase(root: Instance, index: number)
	local angle = (index - 0.5) / Config.PlotCount * math.pi * 2
	local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
	local center = dir * PLOT_R + Vector3.new(0, GROUND_Y, 0)
	-- -Z (LookVector) смотрит в центр острова: там ворота
	local cf = CFrame.lookAt(center, center - dir)
	local color = PLOT_COLORS[index]
	local m = model("Plot" .. index, root)
	local W, D = 46, 42

	P({ Size = Vector3.new(W, 1, D), CFrame = cf * CFrame.new(0, 0.1, 0), Color = rgb(215, 190, 150), Material = Enum.Material.WoodPlanks, Parent = m })
	-- неоновая окантовка цвета игрока
	for _, e in ipairs({ { 0, -D / 2, W, 0.5 }, { 0, D / 2, W, 0.5 }, { -W / 2, 0, 0.5, D }, { W / 2, 0, 0.5, D } }) do
		P({ Size = Vector3.new(e[3], 0.3, e[4]), CFrame = cf * CFrame.new(e[1], 0.7, e[2]), Color = color, Material = Enum.Material.Neon, CanCollide = false, Parent = m })
	end
	-- забор: бока, зад, перед с проёмом под ворота
	local function L(x, z)
		return (cf * CFrame.new(x, 0.6, z)).Position
	end
	fence(m, L(-W / 2, -D / 2), L(-W / 2, D / 2))
	fence(m, L(W / 2, -D / 2), L(W / 2, D / 2))
	fence(m, L(-W / 2, D / 2), L(W / 2, D / 2))
	fence(m, L(-W / 2, -D / 2), L(-7.5, -D / 2))
	fence(m, L(7.5, -D / 2), L(W / 2, -D / 2))
	-- ворота
	for _, x in ipairs({ -7.5, 7.5 }) do
		P({ Size = Vector3.new(1.6, 13, 1.6), CFrame = cf * CFrame.new(x, 7, -D / 2), Color = WOOD_DARK, Material = Enum.Material.Wood, Parent = m })
		P({ Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2), CFrame = cf * CFrame.new(x, 13.8, -D / 2), Color = color, Material = Enum.Material.Neon, CanCollide = false, Parent = m })
	end
	local beam = P({ Size = Vector3.new(17, 3, 1.2), CFrame = cf * CFrame.new(0, 12.2, -D / 2), Color = rgb(70, 50, 35), Material = Enum.Material.Wood, Parent = m })
	local gateFront = surfaceSign(beam, Enum.NormalId.Front, "EMPTY BASE", rgb(255, 255, 255))
	local gateBack = surfaceSign(beam, Enum.NormalId.Back, "EMPTY BASE", rgb(255, 255, 255))
	-- флаг
	local poleCf = cf * CFrame.new(-W / 2 + 2.5, 0.6, D / 2 - 2.5)
	P({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(18, 0.5, 0.5), CFrame = poleCf * CFrame.new(0, 9, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(230, 230, 235), Material = Enum.Material.Metal, Parent = m })
	local flag = P({ Size = Vector3.new(6, 3.6, 0.2), CFrame = poleCf * CFrame.new(3.1, 16, 0), Color = color, Material = Enum.Material.Fabric, CanCollide = false, Parent = m })
	flag.Name = "Flag"
	-- аквариум в глубине базы
	local tankCf = cf * CFrame.new(0, 0.6, 9)
	local tank, water, fishFolder, tankPrompt = buildTank(m, tankCf, 0, color)
	-- табличка дохода над аквариумом
	local signAnchor = P({ Size = Vector3.new(1, 1, 1), CFrame = tankCf * CFrame.new(0, 15, 0), Transparency = 1, CanCollide = false, CanQuery = false, Parent = m })
	signAnchor.Name = "Sign"
	local bb = billboard(signAnchor, UDim2.fromOffset(300, 100), Vector3.zero, 250)
	local ownerLabel = label(bb, "", UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0), rgb(255, 255, 255))
	ownerLabel.Name = "Owner"
	local incomeLabel = label(bb, "", UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0.5), rgb(120, 255, 120))
	incomeLabel.Name = "Income"
	-- турник
	local barModel = pullUpBar(m, cf * CFrame.new(15, 0.6, -10), index * 10 + 1)
	-- фонари у ворот
	lantern(m, L(-10.5, -D / 2 - 1.5), 6)
	lantern(m, L(10.5, -D / 2 - 1.5), 6)

	local plot = {
		Index = index,
		Model = m,
		CFrame = cf,
		Dir = dir,
		Color = color,
		TankCf = tankCf,
		Tank = tank,
		TankTier = 0,
		Water = water,
		FishFolder = fishFolder,
		TankPrompt = tankPrompt,
		OwnerLabel = ownerLabel,
		IncomeLabel = incomeLabel,
		GateLabels = { gateFront, gateBack },
		BarModel = barModel,
		BarPrompt = barModel:FindFirstChild("BarUpgrade", true),
		Bars = { barModel:FindFirstChild("Bar") },
		SpawnCf = cf * CFrame.new(0, 3.5, -12),
		Owner = nil :: Player?,
	}
	m:SetAttribute("PlotIndex", index)
	World.Plots[index] = plot
end

-- ===== Общий пирс =====
local function buoy(parent: Instance, pos: Vector3, zone: any, withLabel: boolean)
	local m = model("Buoy_" .. zone.Name, parent)
	P({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.6, 3.4, 3.4), CFrame = CFrame.new(pos + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = zone.Color, Parent = m })
	P({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 3.6, 3.6), CFrame = CFrame.new(pos + Vector3.new(0, 1.9, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(255, 255, 255), Parent = m })
	P({ Size = Vector3.new(0.4, 4, 0.4), Position = pos + Vector3.new(0, 4, 0), Color = rgb(60, 60, 70), Material = Enum.Material.Metal, Parent = m })
	local lamp = P({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), Position = pos + Vector3.new(0, 6.3, 0), Color = zone.Color, Material = Enum.Material.Neon, CanCollide = false, Parent = m })
	local light = Instance.new("PointLight")
	light.Color = zone.Color
	light.Range = 14
	light.Brightness = 2
	light.Parent = lamp
	if withLabel then
		local bb = billboard(lamp, UDim2.fromOffset(260, 80), Vector3.new(0, 4, 0), 900)
		label(bb, zone.Name, UDim2.fromScale(1, 0.6), UDim2.fromScale(0, 0), zone.Color)
		label(bb, "💪 " .. tostring(Config.PowerForDistance(zone.Dist)) .. " Power", UDim2.fromScale(1, 0.4), UDim2.fromScale(0, 0.6), rgb(255, 255, 255), Enum.Font.FredokaOne)
	end
end

local function buildPier(root: Instance)
	local m = model("Pier", root)
	local dir = Vector3.new(1, 0, 0)
	local right = Vector3.new(0, 0, 1)
	local function at(r: number, side: number, y: number): CFrame
		local p = dir * r + right * side + Vector3.new(0, y, 0)
		return CFrame.lookAt(p, p + dir)
	end
	-- дорожка от площади к пирсу
	local pathLen = PIER_START - 34
	P({ Size = Vector3.new(10, 0.6, pathLen), CFrame = at(34 + pathLen / 2, 0, GROUND_Y + 0.2), Color = rgb(200, 160, 110), Material = Enum.Material.WoodPlanks, Parent = m })
	for r = 48, PIER_START - 6, 28 do
		lantern(m, (at(r, -6.5, GROUND_Y)).Position, 6)
		lantern(m, (at(r, 6.5, GROUND_Y)).Position, 6)
	end
	for r = 40, PIER_START - 4, 9 do
		for _, side in ipairs({ -1, 1 }) do
			grassTuft(m, (at(r + rng:NextNumber(-2, 2), side * rng:NextNumber(5.5, 8), GROUND_Y)).Position)
		end
	end
	-- арка «FISHING PIER»
	for _, s in ipairs({ -10.5, 10.5 }) do
		P({ Size = Vector3.new(1.8, 16, 1.8), CFrame = at(PIER_START, s, DECK_Y + 7), Color = WOOD_DARK, Material = Enum.Material.Wood, Parent = m })
	end
	local arch = P({ Size = Vector3.new(24, 3.6, 1.4), CFrame = at(PIER_START, 0, DECK_Y + 15), Color = rgb(60, 40, 30), Material = Enum.Material.Wood, Parent = m })
	surfaceSign(arch, Enum.NormalId.Front, "🎣 FISHING PIER", rgb(120, 230, 255))
	surfaceSign(arch, Enum.NormalId.Back, "🎣 FISHING PIER", rgb(120, 230, 255))
	-- настил
	local len = PIER_END - PIER_START
	P({ Size = Vector3.new(PIER_W, 1, len), CFrame = at(PIER_START + len / 2, 0, DECK_Y - 0.5), Color = WOOD, Material = Enum.Material.WoodPlanks, Parent = m })
	for r = PIER_START + 4, PIER_END, 11 do
		for _, s in ipairs({ -PIER_W / 2 + 0.5, PIER_W / 2 - 0.5 }) do
			P({ Size = Vector3.new(1.1, 18, 1.1), CFrame = at(r, s, DECK_Y - 9.5), Color = WOOD_DARK, Material = Enum.Material.Wood, Parent = m })
		end
	end
	-- перила из досок
	for _, s in ipairs({ -PIER_W / 2 + 0.4, PIER_W / 2 - 0.4 }) do
		fence(m, (at(PIER_START, s, DECK_Y)).Position, (at(PIER_END, s, DECK_Y)).Position, 3.4)
	end
	for r = PIER_START + 20, PIER_END - 6, 36 do
		lantern(m, (at(r, -PIER_W / 2 + 1.2, DECK_Y)).Position, 6)
		lantern(m, (at(r, PIER_W / 2 - 1.2, DECK_Y)).Position, 6)
	end
	-- бочки, ящики и лодки у пирса
	barrel(m, (at(PIER_START + 6, -PIER_W / 2 + 2, DECK_Y)).Position)
	barrel(m, (at(PIER_START + 8.5, -PIER_W / 2 + 2.3, DECK_Y)).Position)
	crate(m, (at(PIER_START + 7, PIER_W / 2 - 2.2, DECK_Y)).Position)
	crate(m, (at(PIER_END - 4, PIER_W / 2 - 2.2, DECK_Y)).Position, 2)
	barrel(m, (at(PIER_END + 3, -END_W / 2 + 3, DECK_Y)).Position)
	crate(m, (at(PIER_END + 3, END_W / 2 - 3, DECK_Y)).Position)
	rowboat(m, at(PIER_START + 50, PIER_W / 2 + 4, Config.WaterY + 0.2) * CFrame.Angles(0, 0.15, 0))
	rowboat(m, at(PIER_START + 85, -PIER_W / 2 - 4, Config.WaterY + 0.2) * CFrame.Angles(0, -0.2, 0))
	-- широкая площадка на конце
	local endR = PIER_END + END_DEPTH / 2
	P({ Size = Vector3.new(END_W, 1, END_DEPTH), CFrame = at(endR, 0, DECK_Y - 0.5), Color = WOOD, Material = Enum.Material.WoodPlanks, Parent = m })
	for _, s in ipairs({ -END_W / 2 + 1, -END_W / 4, 0, END_W / 4, END_W / 2 - 1 }) do
		for _, r in ipairs({ PIER_END + 1, PIER_END + END_DEPTH - 1 }) do
			P({ Size = Vector3.new(1.2, 18, 1.2), CFrame = at(r, s, DECK_Y - 9.5), Color = WOOD_DARK, Material = Enum.Material.Wood, Parent = m })
		end
	end
	-- перила площадки: бока, перед (низкий), задние крылья
	fence(m, (at(PIER_END, -END_W / 2 + 0.4, DECK_Y)).Position, (at(PIER_END + END_DEPTH, -END_W / 2 + 0.4, DECK_Y)).Position, 3.4)
	fence(m, (at(PIER_END, END_W / 2 - 0.4, DECK_Y)).Position, (at(PIER_END + END_DEPTH, END_W / 2 - 0.4, DECK_Y)).Position, 3.4)
	fence(m, (at(PIER_END + END_DEPTH - 0.4, -END_W / 2, DECK_Y)).Position, (at(PIER_END + END_DEPTH - 0.4, END_W / 2, DECK_Y)).Position, 2.4)
	fence(m, (at(PIER_END + 0.4, -END_W / 2, DECK_Y)).Position, (at(PIER_END + 0.4, -PIER_W / 2, DECK_Y)).Position, 3.4)
	fence(m, (at(PIER_END + 0.4, PIER_W / 2, DECK_Y)).Position, (at(PIER_END + 0.4, END_W / 2, DECK_Y)).Position, 3.4)
	for _, side in ipairs({ -END_W / 2 + 1.2, END_W / 2 - 1.2 }) do
		lantern(m, (at(PIER_END + END_DEPTH - 1.5, side, DECK_Y)).Position, 7)
	end
	-- места для заброса
	local spots = {}
	local castR = PIER_END + END_DEPTH - 5
	for i = 0, 7 do
		local s = -END_W / 2 + 5 + i * ((END_W - 10) / 7)
		local spot = P({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.1, 5.5, 5.5),
			CFrame = CFrame.new(dir * castR + right * s + Vector3.new(0, DECK_Y + 0.05, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			Parent = m,
		})
		spot.Name = "CastSpot"
		table.insert(spots, spot)
	end
	local zonePart = P({
		Size = Vector3.new(END_W, 12, END_DEPTH),
		CFrame = at(endR, 0, DECK_Y + 5.5),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = m,
	})
	zonePart.Name = "CastZone"
	local signAnchor = P({ Size = Vector3.new(1, 1, 1), CFrame = at(endR, 0, DECK_Y + 11), Transparency = 1, CanCollide = false, CanQuery = false, Parent = m })
	local bb = billboard(signAnchor, UDim2.fromOffset(300, 70), Vector3.zero, 200)
	label(bb, "🎣 CAST HERE", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), rgb(120, 240, 255))

	local edge = dir * (PIER_END + END_DEPTH) + Vector3.new(0, Config.WaterY, 0)
	for z = 2, #GameData.Zones do
		local zone = GameData.Zones[z]
		local pos = edge + dir * zone.Dist
		buoy(m, pos - right * 42, zone, true)
		buoy(m, pos + right * 42, zone, false)
	end

	World.Pier = {
		Model = m,
		Dir = dir,
		Right = right,
		CastZone = zonePart,
		Spots = spots,
		Edge = edge,
	}
end

-- ===== Центр острова =====
local function kiosk(parent: Instance, cf: CFrame, title: string, color: Color3, promptName: string)
	local m = model(promptName, parent)
	P({ Size = Vector3.new(12, 3.5, 4), CFrame = cf * CFrame.new(0, 1.75, 0), Color = WOOD, Material = Enum.Material.WoodPlanks, Parent = m })
	P({ Size = Vector3.new(12.6, 0.4, 4.6), CFrame = cf * CFrame.new(0, 3.7, 0), Color = rgb(235, 225, 210), Material = Enum.Material.Wood, Parent = m })
	for _, x in ipairs({ -5.8, 5.8 }) do
		P({ Size = Vector3.new(0.6, 9, 0.6), CFrame = cf * CFrame.new(x, 4.5, 1.6), Color = WOOD_DARK, Material = Enum.Material.Wood, Parent = m })
	end
	for i = 0, 5 do
		P({ Class = "WedgePart", Size = Vector3.new(2.2, 1.4, 6), CFrame = cf * CFrame.new(-5.5 + i * 2.2, 9.6, -0.4) * CFrame.Angles(0, math.pi, 0), Color = (i % 2 == 0) and color or rgb(255, 255, 255), Parent = m })
	end
	local signPart = P({ Size = Vector3.new(10, 2.4, 0.4), CFrame = cf * CFrame.new(0, 11.6, 1.6), Color = rgb(60, 45, 35), Material = Enum.Material.Wood, Parent = m })
	surfaceSign(signPart, Enum.NormalId.Front, title, color)
	local lampPart = P({ Size = Vector3.new(0.6, 0.6, 0.6), CFrame = cf * CFrame.new(0, 8, -1), Transparency = 1, CanCollide = false, Parent = m })
	local light = Instance.new("PointLight")
	light.Color = rgb(255, 200, 130)
	light.Range = 14
	light.Brightness = 1.5
	light.Parent = lampPart
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = promptName
	prompt.ActionText = "Open"
	prompt.ObjectText = title
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = signPart
	return m
end

local function lighthouse(parent: Instance, pos: Vector3)
	local m = model("Lighthouse", parent)
	for i = 0, 7 do
		P({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 9 - i * 0.5, 9 - i * 0.5), CFrame = CFrame.new(pos + Vector3.new(0, 2 + i * 4, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = (i % 2 == 0) and rgb(240, 240, 240) or rgb(220, 60, 60), Parent = m })
	end
	local top = pos + Vector3.new(0, 34, 0)
	P({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 8, 8), CFrame = CFrame.new(top - Vector3.new(0, 1.8, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(50, 50, 60), Parent = m })
	local lamp = P({ Shape = Enum.PartType.Ball, Size = Vector3.new(3.4, 3.4, 3.4), Position = top, Color = rgb(255, 240, 170), Material = Enum.Material.Neon, CanCollide = false, Parent = m })
	lamp.Name = "Lamp"
	P({ Size = Vector3.new(6, 1.4, 6), Position = top + Vector3.new(0, 2.4, 0), Color = rgb(220, 60, 60), Parent = m })
	local spot = Instance.new("SpotLight")
	spot.Color = rgb(255, 240, 180)
	spot.Range = 60
	spot.Angle = 25
	spot.Brightness = 5
	spot.Face = Enum.NormalId.Front
	spot.Parent = lamp
	local pl = Instance.new("PointLight")
	pl.Color = rgb(255, 230, 160)
	pl.Range = 24
	pl.Parent = lamp
	return m
end

local function buildCenter(root: Instance)
	local m = model("Center", root)
	P({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 70, 70), CFrame = CFrame.new(0, GROUND_Y + 0.1, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(215, 200, 180), Material = Enum.Material.Pavement, Parent = m })
	P({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(6, 20, 20), CFrame = CFrame.new(0, GROUND_Y + 3, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(150, 150, 160), Material = Enum.Material.Slate, Parent = m })
	P({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 22, 22), CFrame = CFrame.new(0, GROUND_Y + 6.2, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(255, 205, 60), Material = Enum.Material.Foil, Parent = m })
	local statue = FishBuilder.Build("Megalodon", "Golden", 26, { static = true })
	statue:PivotTo(CFrame.new(0, GROUND_Y + 19, 0) * CFrame.Angles(0.35, math.rad(30), 0))
	statue.Name = "MegalodonStatue"
	statue.Parent = m
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + math.pi / 4
		lantern(m, Vector3.new(math.cos(a) * 30, GROUND_Y, math.sin(a) * 30), 7)
	end
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		flowerPatch(m, Vector3.new(math.cos(a) * 15, GROUND_Y + 0.6, math.sin(a) * 15), 6)
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(-26, GROUND_Y + 1.2, 0)
	spawn.Anchored = true
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = m
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
	kiosk(m, CFrame.lookAt(Vector3.new(-16, GROUND_Y, -30), Vector3.new(0, GROUND_Y, 0)), "SHOP", rgb(255, 140, 60), "ShopPrompt")
	kiosk(m, CFrame.lookAt(Vector3.new(-16, GROUND_Y, 30), Vector3.new(0, GROUND_Y, 0)), "SELL FISH", rgb(80, 220, 120), "SellPrompt")
	kiosk(m, CFrame.lookAt(Vector3.new(-34, GROUND_Y, 0), Vector3.new(0, GROUND_Y, 0)), "ROBUX SHOP", rgb(255, 210, 60), "StorePrompt")
	World.GymBars = {}
end

local function buildDecor(root: Instance)
	local m = model("Decor", root)
	local grass = model("Grass", root)
	for i = 1, Config.PlotCount - 1 do
		-- между базами (угол 0 — пирс, там пусто)
		local a = i / Config.PlotCount * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local side = Vector3.new(-dir.Z, 0, dir.X)
		for _, r in ipairs({ 78, 106, 126, 148 }) do
			local jitter = side * rng:NextNumber(-4, 4) + dir * rng:NextNumber(-3, 3)
			local y = r > 128 and 2 or GROUND_Y
			palm(m, dir * r + jitter + Vector3.new(0, y - 0.5, 0), rng:NextNumber(14, 22))
		end
		bush(m, dir * 92 + side * rng:NextNumber(-3, 3) + Vector3.new(0, GROUND_Y, 0))
		bush(m, dir * 64 + side * rng:NextNumber(-3, 3) + Vector3.new(0, GROUND_Y, 0), 3)
		flowerPatch(m, dir * 115 + side * 3 + Vector3.new(0, GROUND_Y, 0), 7)
		flowerPatch(m, dir * 70 - side * 4 + Vector3.new(0, GROUND_Y, 0), 5)
		rocks(m, dir * 158 + side * rng:NextNumber(-6, 6) + Vector3.new(0, 1.5, 0), 1.2)
		if i % 2 == 0 then
			beachSet(m, dir * 150 + side * 9 + Vector3.new(0, 2, 0), dir)
		end
		for _ = 1, 3 do
			starfish(m, dir * rng:NextNumber(138, 160) + side * rng:NextNumber(-14, 14) + Vector3.new(0, 2, 0))
		end
	end
	-- трава по всему острову (не на базах, не на площади и не на дорожке)
	local placed = 0
	local tries = 0
	while placed < 420 and tries < 4000 do
		tries += 1
		local a = rng:NextNumber(0, math.pi * 2)
		local r = math.sqrt(rng:NextNumber(0.1, 1)) * 128
		local p = Vector3.new(math.cos(a) * r, GROUND_Y, math.sin(a) * r)
		local ok = r > 38 and not (p.X > 30 and math.abs(p.Z) < 9)
		if ok then
			for _, plot in ipairs(World.Plots) do
				local rel = plot.CFrame:PointToObjectSpace(p)
				if math.abs(rel.X) < 25 and math.abs(rel.Z) < 23 then
					ok = false
					break
				end
			end
		end
		if ok then
			grassTuft(grass, p)
			placed += 1
		end
	end
	for _, s in ipairs({ -1, 1 }) do
		palm(m, Vector3.new(150, 1.5, s * 26), 20)
		palm(m, Vector3.new(135, 1.5, s * 34), 17)
		rocks(m, Vector3.new(162, 0.5, s * 22), 1.4)
	end
	World.Lighthouse = lighthouse(m, Vector3.new(-158, 0, 0))
end

function World.Build()
	setupLighting()
	pcall(function()
		(workspace.Terrain :: any).Decoration = true
	end)
	buildTerrain()
	local root = folder("Map", workspace)
	local plots = folder("Plots", workspace)
	for i = 1, Config.PlotCount do
		buildBase(plots, i)
	end
	buildPier(root)
	buildCenter(root)
	buildDecor(root)

	task.spawn(function()
		local lamp = World.Lighthouse and World.Lighthouse:FindFirstChild("Lamp") :: BasePart?
		if not lamp then
			return
		end
		local base = lamp.CFrame
		local t = 0
		while true do
			t += task.wait(0.05)
			lamp.CFrame = base * CFrame.Angles(0, t * 0.8, 0)
		end
	end)
end

function World.PlotOf(player: Player)
	for _, plot in ipairs(World.Plots) do
		if plot.Owner == player then
			return plot
		end
	end
	return nil
end

-- Стоит ли игрок на площадке заброса
function World.InCastZone(pos: Vector3): boolean
	local zone = World.Pier and World.Pier.CastZone
	if not zone then
		return false
	end
	local rel = zone.CFrame:PointToObjectSpace(pos)
	local half = zone.Size / 2
	return math.abs(rel.X) <= half.X + 1 and math.abs(rel.Y) <= half.Y + 2 and math.abs(rel.Z) <= half.Z + 1
end

return World
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000001E"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000001D"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000018"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">ClientState</string><ProtectedString name="Source"><![CDATA[-- Последний снимок данных игрока с сервера + сигнал об изменении.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)

local ClientState = {}
ClientState.Data = nil :: any

local changed = Instance.new("BindableEvent")
ClientState.Changed = changed.Event

function ClientState.Init()
	Remotes.Get("State").OnClientEvent:Connect(function(snap)
		ClientState.Data = snap
		changed:Fire(snap)
	end)
	task.spawn(function()
		for _ = 1, 20 do
			local ok, snap = pcall(function()
				return Remotes.Get("GetState"):InvokeServer()
			end)
			if ok and snap then
				if not ClientState.Data then
					ClientState.Data = snap
					changed:Fire(snap)
				end
				return
			end
			task.wait(1)
		end
	end)
end

function ClientState.Cash(): number
	return Players.LocalPlayer:GetAttribute("Cash") or (ClientState.Data and ClientState.Data.Cash) or 0
end

function ClientState.Power(): number
	return Players.LocalPlayer:GetAttribute("Power") or (ClientState.Data and ClientState.Data.Power) or 0
end

function ClientState.HasPass(key: string): boolean
	return Players.LocalPlayer:GetAttribute("Pass_" .. key) == true
end

-- Мой участок (модель) или nil
function ClientState.MyPlot(): Model?
	local idx = Players.LocalPlayer:GetAttribute("PlotIndex")
	local plots = workspace:FindFirstChild("Plots")
	if idx and plots then
		return plots:FindFirstChild("Plot" .. idx) :: Model?
	end
	return nil
end

-- Общий пирс
function ClientState.Pier(): Model?
	local map = workspace:FindFirstChild("Map")
	return map and map:FindFirstChild("Pier") :: Model?
end

function ClientState.CastZone(): BasePart?
	local pier = ClientState.Pier()
	return pier and pier:FindFirstChild("CastZone") :: BasePart?
end

function ClientState.InCastZone(pos: Vector3): boolean
	local zone = ClientState.CastZone()
	if not zone then
		return false
	end
	local rel = zone.CFrame:PointToObjectSpace(pos)
	local half = zone.Size / 2
	return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y + 1 and math.abs(rel.Z) <= half.Z
end

-- Ближайшее светящееся место для заброса
function ClientState.NearestSpot(pos: Vector3): BasePart?
	local pier = ClientState.Pier()
	if not pier then
		return nil
	end
	local best, bestD = nil, math.huge
	for _, c in ipairs(pier:GetChildren()) do
		if c.Name == "CastSpot" and c:IsA("BasePart") then
			local d = (c.Position - pos).Magnitude
			if d < bestD then
				best, bestD = c, d
			end
		end
	end
	return best
end

return ClientState
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- Визуальные эффекты на клиенте: брызги, круги, поплавок с леской, плавание рыб в аквариумах,
-- радужные рыбы, погода событий, чужие забросы, всплывающий доход над своим аквариумом.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local GameData = require(Shared.GameData)
local Format = require(Shared.Format)
local FishBuilder = require(Shared.FishBuilder)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer
local Effects = {}

local fxFolder = Instance.new("Folder")
fxFolder.Name = "LocalFx"
fxFolder.Parent = workspace

local rng = Random.new()

local function anchoredPart(props: { [string]: any }): BasePart
	local p = Instance.new(props.Class or "Part") :: BasePart
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Class" and k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	p.Parent = props.Parent or fxFolder
	return p
end

-- ===== Брызги и круги =====
function Effects.Splash(pos: Vector3, scale: number?, color: Color3?)
	local s = scale or 1
	local holder = anchoredPart({ Size = Vector3.new(1, 1, 1), Position = pos, Transparency = 1 })
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(color or Color3.fromRGB(230, 250, 255))
	pe.LightEmission = 0.6
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6 * s), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.6) })
	pe.Lifetime = NumberRange.new(0.5, 0.9)
	pe.Speed = NumberRange.new(10 * s, 22 * s)
	pe.SpreadAngle = Vector2.new(35, 35)
	pe.Acceleration = Vector3.new(0, -60, 0)
	pe.EmissionDirection = Enum.NormalId.Top
	pe.Rate = 0
	pe.Parent = holder
	pe:Emit(math.floor(24 * s))
	Debris:AddItem(holder, 1.5)

	local ring = anchoredPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.15, 1.5 * s, 1.5 * s),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(235, 250, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.2,
	})
	TweenService:Create(ring, TweenInfo.new(0.7, Enum.EasingStyle.Quad), { Size = Vector3.new(0.15, 11 * s, 11 * s), Transparency = 1 }):Play()
	Debris:AddItem(ring, 0.8)
end

function Effects.Ripple(pos: Vector3, size: number?)
	local ring = anchoredPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.1, 1, 1),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(240, 250, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.4,
	})
	local s = size or 5
	TweenService:Create(ring, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { Size = Vector3.new(0.1, s, s), Transparency = 1 }):Play()
	Debris:AddItem(ring, 1)
end

function Effects.Burst(pos: Vector3, color: Color3, count: number?)
	local holder = anchoredPart({ Size = Vector3.new(1, 1, 1), Position = pos, Transparency = 1 })
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(color)
	pe.LightEmission = 1
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	pe.Lifetime = NumberRange.new(0.5, 1)
	pe.Speed = NumberRange.new(8, 18)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Drag = 3
	pe.Rate = 0
	pe.Parent = holder
	pe:Emit(count or 30)
	Debris:AddItem(holder, 1.5)
end

-- ===== Поплавок =====
function Effects.MakeBobber(color: Color3?): (Model, Attachment)
	local m = Instance.new("Model")
	m.Name = "Bobber"
	local top = anchoredPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9), Color = color or Color3.fromRGB(255, 60, 60), Parent = m })
	top.Name = "Top"
	local bottom = anchoredPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.86, 0.86, 0.86), Color = Color3.fromRGB(250, 250, 250), Parent = m })
	bottom.Name = "Bottom"
	local stick = anchoredPart({ Size = Vector3.new(0.12, 0.6, 0.12), Color = Color3.fromRGB(255, 220, 60), Material = Enum.Material.Neon, Parent = m })
	stick.Name = "Stick"
	m.PrimaryPart = top
	local att = Instance.new("Attachment")
	att.Name = "LineAttach"
	att.Position = Vector3.new(0, 0.45, 0)
	att.Parent = top
	-- след
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.3, 0)
	a0.Parent = top
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.3, 0)
	a1.Parent = top
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.35
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(140, 220, 255))
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.LightEmission = 0.6
	trail.FaceCamera = true
	trail.Name = "Trail"
	trail.Parent = top
	m.Parent = fxFolder
	return m, att
end

function Effects.PlaceBobber(m: Model, pos: Vector3)
	local top = m:FindFirstChild("Top") :: BasePart
	local bottom = m:FindFirstChild("Bottom") :: BasePart
	local stick = m:FindFirstChild("Stick") :: BasePart
	top.CFrame = CFrame.new(pos + Vector3.new(0, 0.18, 0))
	bottom.CFrame = CFrame.new(pos - Vector3.new(0, 0.2, 0))
	stick.CFrame = CFrame.new(pos + Vector3.new(0, 0.85, 0))
end

function Effects.MakeLine(from: Attachment, to: Attachment): Beam
	local beam = Instance.new("Beam")
	beam.Attachment0 = from
	beam.Attachment1 = to
	beam.Width0 = 0.06
	beam.Width1 = 0.06
	beam.Color = ColorSequence.new(Color3.fromRGB(245, 245, 255))
	beam.Transparency = NumberSequence.new(0.1)
	beam.LightEmission = 0.4
	beam.FaceCamera = true
	beam.Segments = 24
	beam.Parent = fxFolder
	return beam
end

-- Траектория дуги
function Effects.Arc(a: Vector3, b: Vector3, height: number, t: number): Vector3
	return a:Lerp(b, t) + Vector3.new(0, 4 * height * t * (1 - t), 0)
end

function Effects.RodTip(character: Model?): Attachment?
	local rod = character and character:FindFirstChild("Rod")
	local shaft = rod and rod:FindFirstChild("Shaft")
	return shaft and shaft:FindFirstChild("RodTip") :: Attachment?
end

-- ===== Чужие забросы =====
local function otherCast(userId: number, landing: Vector3, flight: number, total: number)
	local other = Players:GetPlayerByUserId(userId)
	local character = other and other.Character
	local tip = Effects.RodTip(character)
	if not tip then
		return
	end
	local cam = workspace.CurrentCamera
	if cam and (cam.CFrame.Position - tip.WorldPosition).Magnitude > 400 then
		return
	end
	local bobber, att = Effects.MakeBobber()
	local line = Effects.MakeLine(tip, att)
	local from = tip.WorldPosition
	local height = 6 + (landing - from).Magnitude * 0.18
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < flight do
			local t = (os.clock() - t0) / flight
			Effects.PlaceBobber(bobber, Effects.Arc(from, landing, height, t))
			RunService.RenderStepped:Wait()
		end
		Effects.Splash(landing, 0.7)
		local t1 = os.clock()
		while os.clock() - t1 < total - flight and bobber.Parent do
			local bob = math.sin(os.clock() * 4) * 0.15
			Effects.PlaceBobber(bobber, landing + Vector3.new(0, bob, 0))
			RunService.RenderStepped:Wait()
		end
		Effects.Splash(landing, 1)
		bobber:Destroy()
		line:Destroy()
	end)
end

-- ===== Аквариумы =====
local fishStates = setmetatable({}, { __mode = "k" }) :: { [Model]: any }

local function animateTanks(dt: number)
	local plots = workspace:FindFirstChild("Plots")
	local cam = workspace.CurrentCamera
	if not plots or not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local t = os.clock()
	for _, plot in ipairs(plots:GetChildren()) do
		local tank = plot:FindFirstChild("Tank")
		local water = tank and tank:FindFirstChild("Water") :: BasePart?
		local folder = tank and tank:FindFirstChild("Fish")
		if water and folder and (water.Position - camPos).Magnitude < 320 then
			local half = water.Size / 2
			for _, m in ipairs(folder:GetChildren()) do
				local body = m:IsA("Model") and m.PrimaryPart
				if body then
					local st = fishStates[m]
					local len = m:GetAttribute("Length") or 2
					local margin = Vector3.new(math.min(half.X - 0.2, len * 0.6), math.min(half.Y - 0.2, len * 0.35), math.min(half.Z - 0.2, len * 0.45))
					local function newTarget()
						local r = half - margin
						return Vector3.new(rng:NextNumber(-r.X, r.X), rng:NextNumber(-r.Y, r.Y), rng:NextNumber(-r.Z, r.Z))
					end
					if not st then
						st = {
							pos = water.CFrame:PointToObjectSpace(body.Position),
							target = newTarget(),
							speed = rng:NextNumber(1.2, 2.6),
							yaw = rng:NextNumber(0, math.pi * 2),
							phase = rng:NextNumber(0, 10),
						}
						fishStates[m] = st
					end
					local toT = st.target - st.pos
					if toT.Magnitude < 0.4 then
						st.target = newTarget()
					else
						local step = math.min(toT.Magnitude, st.speed * dt)
						st.pos += toT.Unit * step
						local wantYaw = math.atan2(-toT.X, -toT.Z)
						local diff = (wantYaw - st.yaw + math.pi) % (math.pi * 2) - math.pi
						st.yaw += diff * math.min(1, dt * 2.5)
					end
					local wiggle = math.sin(t * 6 + st.phase) * 0.12
					local bob = math.sin(t * 1.7 + st.phase) * 0.12
					body.CFrame = water.CFrame * CFrame.new(st.pos + Vector3.new(0, bob, 0)) * CFrame.Angles(0, st.yaw + wiggle, 0)
				end
			end
		end
	end
end

-- ===== Радужные детали =====
local rainbowParts = {} :: { [BasePart]: boolean }
local function trackRainbow(p: Instance)
	if p:IsA("BasePart") then
		rainbowParts[p] = true
	end
end

-- ===== Погода событий =====
local rainPart: BasePart? = nil
local flash: ColorCorrectionEffect? = nil
local currentEvent = ""

local function setRain(on: boolean)
	if on and not rainPart then
		local p = anchoredPart({ Size = Vector3.new(120, 1, 120), Transparency = 1 })
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Color = ColorSequence.new(Color3.fromRGB(190, 210, 235))
		pe.Size = NumberSequence.new(0.18)
		pe.Transparency = NumberSequence.new(0.35)
		pe.Lifetime = NumberRange.new(0.9, 1.2)
		pe.Rate = 600
		pe.Speed = NumberRange.new(70, 85)
		pe.EmissionDirection = Enum.NormalId.Bottom
		pe.SpreadAngle = Vector2.new(4, 4)
		pe.LightEmission = 0.2
		pe.Parent = p
		rainPart = p
	elseif not on and rainPart then
		rainPart:Destroy()
		rainPart = nil
	end
end

local function lightning()
	if not flash then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "LightningFlash"
		cc.Parent = Lighting
		flash = cc
	end
	local f = flash :: ColorCorrectionEffect
	f.Brightness = 0.55
	TweenService:Create(f, TweenInfo.new(0.35), { Brightness = 0 }):Play()
end

local function meteor()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local center = cam.CFrame.Position
	local a = rng:NextNumber(0, math.pi * 2)
	local land = center + Vector3.new(math.cos(a), 0, math.sin(a)) * rng:NextNumber(120, 400)
	land = Vector3.new(land.X, Config.WaterY, land.Z)
	local start = land + Vector3.new(rng:NextNumber(-150, 150), 260, rng:NextNumber(-150, 150))
	local rock = anchoredPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(4, 4, 4), Position = start, Color = Color3.fromRGB(255, 140, 50), Material = Enum.Material.Neon })
	local fire = Instance.new("Fire")
	fire.Size = 12
	fire.Heat = 20
	fire.Color = Color3.fromRGB(255, 120, 40)
	fire.SecondaryColor = Color3.fromRGB(255, 220, 80)
	fire.Parent = rock
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 60)
	light.Range = 40
	light.Brightness = 3
	light.Parent = rock
	local tw = TweenService:Create(rock, TweenInfo.new(1.6, Enum.EasingStyle.Linear), { Position = land })
	tw:Play()
	tw.Completed:Connect(function()
		Effects.Splash(land, 3, Color3.fromRGB(255, 200, 150))
		rock:Destroy()
	end)
end

local jumpers = { "Guppy", "Clownfish", "Blue Tang", "Tuna", "Mahi-Mahi", "Parrotfish" }
local function jumpingFish()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local a = rng:NextNumber(0, math.pi * 2)
	local r = rng:NextNumber(185, 320)
	local from = Vector3.new(math.cos(a) * r, Config.WaterY - 1, math.sin(a) * r)
	local dir = Vector3.new(-math.sin(a), 0, math.cos(a)) * rng:NextNumber(6, 12)
	local to = from + dir
	local m = FishBuilder.Build(jumpers[rng:NextInteger(1, #jumpers)], "None", rng:NextNumber(1.5, 2.5))
	m.Parent = fxFolder
	local body = m.PrimaryPart :: BasePart
	Effects.Splash(from + Vector3.new(0, 1, 0), 0.6)
	task.spawn(function()
		local t0 = os.clock()
		local dur = 0.9
		local prev = from
		while os.clock() - t0 < dur do
			local t = (os.clock() - t0) / dur
			local p = Effects.Arc(from, to, 5, t)
			if (p - prev).Magnitude > 0.01 then
				body.CFrame = CFrame.lookAt(p, p + (p - prev))
			end
			prev = p
			RunService.RenderStepped:Wait()
		end
		Effects.Splash(to + Vector3.new(0, 1, 0), 0.6)
		m:Destroy()
	end)
end

-- ===== Доход над своим аквариумом =====
local function incomePopup()
	local plot = ClientState.MyPlot()
	local tank = plot and plot:FindFirstChild("Tank")
	local water = tank and tank:FindFirstChild("Water") :: BasePart?
	local income = player:GetAttribute("Income") or 0
	if not water or income <= 0 then
		return
	end
	local cam = workspace.CurrentCamera
	if cam and (cam.CFrame.Position - water.Position).Magnitude > 120 then
		return
	end
	local anchor = anchoredPart({ Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, Position = water.Position + Vector3.new(rng:NextNumber(-8, 8), water.Size.Y / 2 + 1, 0) })
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(160, 40)
	bb.LightInfluence = 0
	bb.AlwaysOnTop = true
	bb.MaxDistance = 120
	bb.Parent = anchor
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = "+" .. Format.Money(income * 2)
	t.TextColor3 = Color3.fromRGB(120, 255, 120)
	t.TextStrokeTransparency = 0
	t.Parent = bb
	TweenService:Create(anchor, TweenInfo.new(1.6, Enum.EasingStyle.Quad), { Position = anchor.Position + Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(t, TweenInfo.new(1.6), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 1.7)
end

-- ===== Сцена улучшения базы =====
local function upgradeBanner(parent: BasePart, line1: string, line2: string, color: Color3)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(520, 150)
	bb.StudsOffset = Vector3.new(0, 6, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Parent = parent
	local function line(text: string, y: number, h: number, col: Color3)
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, h, 0)
		t.Position = UDim2.fromScale(0, y)
		t.Font = Enum.Font.LuckiestGuy
		t.TextScaled = true
		t.Text = text
		t.TextColor3 = col
		t.TextStrokeTransparency = 0
		t.Parent = bb
		local sc = Instance.new("UIScale")
		sc.Scale = 0.1
		sc.Parent = t
		TweenService:Create(sc, TweenInfo.new(0.45, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	line(line1, 0, 0.55, color)
	line(line2, 0.58, 0.42, Color3.fromRGB(255, 255, 255))
	return bb
end

function Effects.UpgradeCutscene(kind: string, title: string, oldTank: Instance?)
	local plot = ClientState.MyPlot()
	local cam = workspace.CurrentCamera
	if not plot or not cam then
		return
	end
	-- дождаться новой модели аквариума с сервера
	local target: Instance? = nil
	local t0 = os.clock()
	if kind == "Tank" then
		repeat
			local t = plot:FindFirstChild("Tank")
			if t and t ~= oldTank then
				target = t
			end
			task.wait(0.05)
		until target or os.clock() - t0 > 2
	else
		target = plot:FindFirstChild("PullUpBar")
	end
	if not target then
		return
	end
	local cf, size = (target :: Model):GetBoundingBox()
	local center = cf.Position
	local color = kind == "Tank" and Color3.fromRGB(90, 220, 255) or Color3.fromRGB(255, 190, 60)

	-- спрятать детали, чтобы потом «собрать»
	local parts = {}
	for _, d in ipairs(target:GetDescendants()) do
		if d:IsA("BasePart") and d.Anchored and not d:FindFirstAncestor("Fish") then
			table.insert(parts, { part = d, cf = d.CFrame })
			d.LocalTransparencyModifier = 1
		end
	end
	table.sort(parts, function(a, b)
		return a.cf.Position.Y < b.cf.Position.Y
	end)

	-- камера облетает базу
	local savedType = cam.CameraType
	cam.CameraType = Enum.CameraType.Scriptable
	local radius = math.max(22, size.Magnitude * 1.1)
	local baseYaw = math.atan2((cam.CFrame.Position - center).X, (cam.CFrame.Position - center).Z)
	local duration = 3.4
	local running = true
	task.spawn(function()
		local s0 = os.clock()
		while running do
			local k = math.min(1, (os.clock() - s0) / duration)
			local yaw = baseYaw + k * 1.6
			local pos = center + Vector3.new(math.sin(yaw) * radius, radius * 0.45, math.cos(yaw) * radius)
			cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(pos, center + Vector3.new(0, 2, 0)), 0.12)
			RunService.RenderStepped:Wait()
		end
	end)

	task.wait(0.5)
	-- столб света и вспышка
	local pillar = anchoredPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(200, 2, 2), CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2), Color = color, Material = Enum.Material.Neon, Transparency = 0.2 })
	TweenService:Create(pillar, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Size = Vector3.new(200, size.X * 0.9, size.X * 0.9), Transparency = 0.75 }):Play()
	local flashCc = Instance.new("ColorCorrectionEffect")
	flashCc.Brightness = 0.6
	flashCc.TintColor = color
	flashCc.Parent = Lighting
	TweenService:Create(flashCc, TweenInfo.new(0.8), { Brightness = 0, TintColor = Color3.new(1, 1, 1) }):Play()
	Debris:AddItem(flashCc, 1)

	-- детали падают на место по очереди
	local stagger = math.min(0.03, 1.2 / math.max(1, #parts))
	for i, p in ipairs(parts) do
		local part = p.part :: BasePart
		if part.Parent then
			part.CFrame = p.cf * CFrame.new(0, 10 + (i % 5), 0) * CFrame.Angles(0, (i % 2 == 0) and 0.6 or -0.6, 0)
			TweenService:Create(part, TweenInfo.new(0.45, Enum.EasingStyle.Bounce), { CFrame = p.cf, LocalTransparencyModifier = 0 }):Play()
		end
		if i % 6 == 0 then
			task.wait(stagger * 6)
		end
	end
	task.wait(0.4)
	Effects.Burst(center + Vector3.new(0, 4, 0), color, 120)
	Effects.Burst(center + Vector3.new(0, 8, 0), Color3.fromRGB(255, 255, 255), 60)
	local banner = upgradeBanner(pillar, kind == "Tank" and "AQUARIUM UPGRADED!" or "NEW PULL-UP BAR!", title, color)
	TweenService:Create(pillar, TweenInfo.new(1.6), { Transparency = 1 }):Play()
	task.wait(1.8)
	banner:Destroy()
	pillar:Destroy()
	for _, p in ipairs(parts) do
		if p.part.Parent then
			p.part.CFrame = p.cf
			p.part.LocalTransparencyModifier = 0
		end
	end
	running = false
	cam.CameraType = savedType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or savedType
	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if hum then
		cam.CameraSubject = hum
	end
end

function Effects.Init()
	Remotes.Get("CastFx").OnClientEvent:Connect(otherCast)

	for _, p in ipairs(CollectionService:GetTagged("RainbowPart")) do
		trackRainbow(p)
	end
	CollectionService:GetInstanceAddedSignal("RainbowPart"):Connect(trackRainbow)
	CollectionService:GetInstanceRemovedSignal("RainbowPart"):Connect(function(p)
		rainbowParts[p :: BasePart] = nil
	end)

	local timers = { income = 0, weather = 0 }
	RunService.RenderStepped:Connect(function(dt)
		animateTanks(dt)
		local t = os.clock()
		for p in pairs(rainbowParts) do
			if p.Parent then
				local h = ((p:GetAttribute("Hue") or 0) + t * 0.25) % 1
				p.Color = Color3.fromHSV(h, 0.75, 1)
			else
				rainbowParts[p] = nil
			end
		end
		local cam = workspace.CurrentCamera
		if rainPart and cam then
			rainPart.CFrame = CFrame.new(cam.CFrame.Position + Vector3.new(0, 45, 0))
		end
		timers.income += dt
		if timers.income >= 2 then
			timers.income = 0
			incomePopup()
		end
		timers.weather += dt
		if timers.weather >= 0.5 then
			timers.weather = 0
			local ev = workspace:GetAttribute("Event") or ""
			local ends = workspace:GetAttribute("EventEnds") or 0
			if ev ~= "" and workspace:GetServerTimeNow() >= ends then
				ev = ""
			end
			if ev ~= currentEvent then
				currentEvent = ev
				setRain(ev == "Storm")
			end
			if ev == "Storm" and rng:NextNumber() < 0.06 then
				lightning()
			elseif ev == "MeteorShower" and rng:NextNumber() < 0.45 then
				meteor()
			elseif ev == "Frenzy" then
				jumpingFish()
			elseif ev == "" and rng:NextNumber() < 0.08 then
				jumpingFish()
			end
		end
	end)
end

Effects.Folder = fxFolder
local _ = GameData

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">Fishing</string><ProtectedString name="Source"><![CDATA[-- Рыбалка на клиенте с мини-катсценой:
-- камера за плечом при замахе -> полёт за поплавком -> наезд при клёве ->
-- рыба выпрыгивает в замедлении, камера облетает её -> рыба летит к игроку -> карточка улова.
-- Тело игрока анимируется суставами: замах, хлёст, держит удочку, крутит катушку, подсекает.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local GameData = require(Shared.GameData)
local FishBuilder = require(Shared.FishBuilder)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local Effects = require(script.Parent.Effects)

local player = Players.LocalPlayer
local Fishing = {}

local state = "Idle" -- Idle | Charging | Busy
local chargeStart = 0
local reelProgress = 0
local reeling = false
local cinematic = true

local UP = Vector3.new(0, 1, 0)

local function root(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function humanoid(): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function pierDir(): Vector3
	local zone = ClientState.CastZone()
	return zone and zone.CFrame.LookVector or Vector3.new(1, 0, 0)
end

-- ===== Позы тела =====
local JOINTS = {
	RightShoulder = "RightUpperArm",
	LeftShoulder = "LeftUpperArm",
	RightElbow = "RightLowerArm",
	LeftElbow = "LeftLowerArm",
	Waist = "UpperTorso",
}
local joints = {} :: { [string]: { motor: Motor6D, base: CFrame, cur: CFrame, goal: CFrame } }
local poseSpeed = 12
local poseName = "Rest"
local poseCharge = 0

local function bindJoints()
	joints = {}
	local character = player.Character
	if not character then
		return
	end
	for jointName, partName in pairs(JOINTS) do
		local part = character:FindFirstChild(partName)
		local motor = part and part:FindFirstChild(jointName)
		if motor and motor:IsA("Motor6D") then
			joints[jointName] = { motor = motor, base = motor.C0, cur = CFrame.identity, goal = CFrame.identity }
		end
	end
end

local function rad(d: number): number
	return math.rad(d)
end

-- Цели суставов для каждой позы
local function poseGoals(name: string, t: number): { [string]: CFrame }
	local A = CFrame.Angles
	if name == "Windup" then
		local c = poseCharge
		return {
			RightShoulder = A(rad(-155 * c), 0, 0.25 * c),
			RightElbow = A(rad(25 * c), 0, 0),
			LeftShoulder = A(rad(45 * c), 0, 0.35 * c),
			Waist = A(0, -0.65 * c, 0) * A(-0.12 * c, 0, 0),
		}
	elseif name == "Whip" then
		return {
			RightShoulder = A(rad(85), 0, 0),
			RightElbow = A(rad(5), 0, 0),
			LeftShoulder = A(rad(30), 0, 0.2),
			Waist = A(0, 0.4, 0) * A(0.15, 0, 0),
		}
	elseif name == "Hold" then
		local breathe = math.sin(t * 2) * 0.03
		return {
			RightShoulder = A(rad(40) + breathe, 0, 0),
			RightElbow = A(rad(35), 0, 0),
			LeftShoulder = A(rad(50) + breathe, 0, 0.35),
			LeftElbow = A(rad(55), 0, 0),
			Waist = A(0, 0.1, 0),
		}
	elseif name == "Reel" then
		local crank = t * 16
		local tug = math.sin(t * 9) * 0.06
		return {
			RightShoulder = A(rad(58) + tug, 0, 0),
			RightElbow = A(rad(45), 0, 0),
			LeftShoulder = A(rad(48) + math.sin(crank) * 0.22, 0, 0.35 + math.cos(crank) * 0.1),
			LeftElbow = A(rad(60) + math.cos(crank) * 0.25, 0, 0),
			Waist = A(-0.12 + tug, 0.08, 0),
		}
	elseif name == "Hook" then
		return {
			RightShoulder = A(rad(160), 0, 0.1),
			RightElbow = A(rad(20), 0, 0),
			LeftShoulder = A(rad(120), 0, 0.3),
			LeftElbow = A(rad(30), 0, 0),
			Waist = A(-0.3, 0, 0),
		}
	end
	return {}
end

local function setPose(name: string, speed: number?)
	poseName = name
	poseSpeed = speed or 12
end

local function updatePose(dt: number)
	if player:GetAttribute("Training") then
		return -- позой на турнике управляет сервер
	end
	local character = player.Character
	if not character then
		return
	end
	local any = next(joints)
	if not any or not joints[any].motor.Parent or not joints[any].motor:IsDescendantOf(character) then
		bindJoints()
	end
	local goals = poseGoals(poseName, os.clock())
	local a = 1 - math.exp(-dt * poseSpeed)
	for name, j in pairs(joints) do
		j.goal = goals[name] or CFrame.identity
		j.cur = j.cur:Lerp(j.goal, a)
		if j.motor.Parent then
			j.motor.C0 = j.base * j.cur
		end
	end
end

-- ===== Камера =====
local cam = {
	active = false,
	fn = nil :: ((number) -> (CFrame, number))?,
	speed = 6,
	shake = 0,
	t0 = 0,
}

local function camStart()
	if not cinematic then
		return
	end
	local c = workspace.CurrentCamera
	if c then
		c.CameraType = Enum.CameraType.Scriptable
		cam.active = true
	end
end

local function camShot(fn: (number) -> (CFrame, number), speed: number?)
	cam.fn = fn
	cam.speed = speed or 6
	cam.t0 = os.clock()
end

local function camStop()
	cam.active = false
	cam.fn = nil
	local c = workspace.CurrentCamera
	if c then
		c.CameraType = Enum.CameraType.Custom
		local hum = humanoid()
		if hum then
			c.CameraSubject = hum
		end
		TweenService:Create(c, TweenInfo.new(0.4), { FieldOfView = 70 }):Play()
	end
end

local function camShake(power: number)
	cam.shake = math.max(cam.shake, power)
end

local function updateCamera(dt: number)
	if not cam.active or not cam.fn then
		return
	end
	local c = workspace.CurrentCamera
	if not c then
		return
	end
	local cf, fov = cam.fn(os.clock() - cam.t0)
	local a = 1 - math.exp(-dt * cam.speed)
	local nextCf = c.CFrame:Lerp(cf, a)
	if cam.shake > 0.01 then
		nextCf = nextCf * CFrame.Angles((math.random() - 0.5) * cam.shake * 0.05, (math.random() - 0.5) * cam.shake * 0.05, 0)
		cam.shake *= math.exp(-dt * 6)
	end
	c.CFrame = nextCf
	c.FieldOfView += (fov - c.FieldOfView) * a
end

local function overShoulder(): CFrame
	local r = root()
	local dir = pierDir()
	if not r then
		return workspace.CurrentCamera.CFrame
	end
	local right = dir:Cross(UP)
	local pos = r.Position - dir * 10 + right * 4 + UP * 4.5
	return CFrame.lookAt(pos, r.Position + dir * 40 + UP * 6)
end

-- ===== Вспомогательное =====
local function flashScreen(color: Color3, strength: number)
	local cc = Instance.new("ColorCorrectionEffect")
	cc.TintColor = color
	cc.Brightness = strength
	cc.Parent = Lighting
	local tw = TweenService:Create(cc, TweenInfo.new(0.6), { Brightness = 0, TintColor = Color3.new(1, 1, 1) })
	tw:Play()
	tw.Completed:Connect(function()
		cc:Destroy()
	end)
end

local function bigText(parent: BasePart, text: string, color: Color3)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(420, 90)
	bb.StudsOffset = Vector3.new(0, 4, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Parent = parent
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.LuckiestGuy
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = color
	t.TextStrokeTransparency = 0
	t.Parent = bb
	local s = Instance.new("UIScale")
	s.Scale = 0.2
	s.Parent = t
	TweenService:Create(s, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	return bb
end

local function exclamation(parent: BasePart, rarity: number)
	local col = rarity >= GameData.RarityIndex.Epic and GameData.Rarities[rarity].Color or Color3.fromRGB(255, 230, 60)
	return bigText(parent, rarity >= GameData.RarityIndex.Legendary and "!!!" or "!", col)
end

local function lockMovement(lock: boolean)
	local hum = humanoid()
	if not hum then
		return
	end
	if lock then
		if not hum:GetAttribute("SavedSpeed") then
			hum:SetAttribute("SavedSpeed", hum.WalkSpeed)
			hum:SetAttribute("SavedJump", hum.JumpHeight)
		end
		hum.WalkSpeed = 0
		hum.JumpHeight = 0
		local r = root()
		if r then
			local dir = pierDir()
			r.CFrame = CFrame.lookAt(r.Position, r.Position + dir)
		end
	else
		local ws = hum:GetAttribute("SavedSpeed")
		if ws then
			hum.WalkSpeed = ws
			hum.JumpHeight = hum:GetAttribute("SavedJump") or 7.2
			hum:SetAttribute("SavedSpeed", nil)
			hum:SetAttribute("SavedJump", nil)
		end
	end
end

local guideBeam: Beam? = nil
local function showGuide()
	local r = root()
	local spot = r and ClientState.NearestSpot(r.Position)
	if not spot or not r then
		return
	end
	if guideBeam then
		guideBeam:Destroy()
	end
	local a0 = Instance.new("Attachment")
	a0.Parent = r
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, 1, 0)
	a1.Parent = spot
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0 = 1.2
	beam.Width1 = 1.2
	beam.Color = ColorSequence.new(Color3.fromRGB(120, 240, 255))
	beam.LightEmission = 1
	beam.FaceCamera = true
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureSpeed = 2
	beam.TextureLength = 3
	beam.Parent = r
	guideBeam = beam
	task.delay(8, function()
		beam:Destroy()
		a0:Destroy()
		a1:Destroy()
	end)
end

-- ===== Катсцена улова =====
local function catchCutscene(res, from: Vector3)
	local def = GameData.FishById[res.fish]
	local r = root()
	if not def or not r then
		return
	end
	local rarity = GameData.Rarities[def.Rarity]
	local big = def.Rarity >= GameData.RarityIndex.Legendary
	local fancy = def.Rarity >= GameData.RarityIndex.Rare
	local len = math.min(7, FishBuilder.DisplayLength(res.fish, res.size) * 1.4)
	local m = FishBuilder.Build(res.fish, res.mutation, len)
	m.Parent = Effects.Folder
	local body = m.PrimaryPart :: BasePart
	-- шлейф и свет цвета редкости
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, len * 0.15, 0)
	a0.Parent = body
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -len * 0.15, 0)
	a1.Parent = body
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.6
	trail.Color = ColorSequence.new(rarity.Color)
	trail.LightEmission = 1
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.Parent = body
	local glow = Instance.new("PointLight")
	glow.Color = rarity.Color
	glow.Range = 14
	glow.Brightness = fancy and 3 or 1.5
	glow.Parent = body

	-- 1) прыжок из воды
	local dir = pierDir()
	local right = dir:Cross(UP)
	local apex = from + UP * (7 + def.Rarity * 1.2)
	local start = from - UP * 2
	Effects.Splash(from, 1.8)
	setPose("Hook", 18)
	camShake(fancy and 1.2 or 0.6)
	camShot(function(t)
		local p = body.Position
		return CFrame.lookAt(p - dir * 16 + right * 8 + UP * 2, p), 55
	end, 7)
	local t0 = os.clock()
	local leap = 0.35
	while os.clock() - t0 < leap do
		local k = (os.clock() - t0) / leap
		local e = 1 - (1 - k) ^ 2
		local p = start:Lerp(apex, e)
		body.CFrame = CFrame.new(p) * CFrame.Angles(-math.pi / 2 * (1 - k), k * 2, 0)
		RunService.RenderStepped:Wait()
	end

	-- 2) замедление в верхней точке, камера облетает рыбу
	local hover = big and 1.9 or (fancy and 1.1 or 0.45)
	local label: BillboardGui? = nil
	if fancy then
		Effects.Burst(apex, rarity.Color, big and 90 or 45)
		flashScreen(rarity.Color, big and 0.45 or 0.2)
		if big then
			label = bigText(body, string.upper(rarity.Name) .. "!", rarity.Color)
		end
	end
	local orbitFrom = math.random() < 0.5 and -1 or 1
	camShot(function(t)
		local k = math.clamp(t / hover, 0, 1)
		local ang = orbitFrom * (0.9 - k * 1.6)
		local offset = (CFrame.Angles(0, ang, 0) * CFrame.new(0, 1.5, 9 + len)).Position
		local camPos = apex + (CFrame.lookAt(Vector3.zero, -dir)).Rotation * offset
		return CFrame.lookAt(camPos, apex), big and 40 or 48
	end, 5)
	local h0 = os.clock()
	while os.clock() - h0 < hover do
		local k = (os.clock() - h0) / hover
		local bob = math.sin(k * math.pi) * 0.8
		body.CFrame = CFrame.new(apex + UP * bob) * CFrame.Angles(0, 2 + k * math.pi * 2, math.sin(k * 12) * 0.15)
		RunService.RenderStepped:Wait()
	end
	if label then
		label:Destroy()
	end

	-- 3) полёт к игроку
	local target = r.Position + UP * 3.5 + dir * 2
	local dist = (target - apex).Magnitude
	local dur = 0.7 + math.min(0.9, dist / 600)
	local height = 6 + dist * 0.1
	camShot(function()
		local p = body.Position
		local toPlayer = (r.Position - p)
		local back = toPlayer.Magnitude > 1 and -toPlayer.Unit or dir
		return CFrame.lookAt(p + back * 14 + UP * 5 + right * 4, p), 65
	end, 9)
	setPose("Hold", 10)
	local f0 = os.clock()
	local prev = apex
	local spin = 0
	while os.clock() - f0 < dur do
		local k = (os.clock() - f0) / dur
		local e = k < 0.5 and 2 * k * k or 1 - (-2 * k + 2) ^ 2 / 2
		local p = Effects.Arc(apex, target, height, e)
		spin += 0.3
		if (p - prev).Magnitude > 0.001 then
			body.CFrame = CFrame.lookAt(p, p + (p - prev)) * CFrame.Angles(0, 0, spin)
		end
		prev = p
		RunService.RenderStepped:Wait()
	end
	Effects.Burst(target, rarity.Color, big and 80 or 30)
	camShake(0.4)
	m:Destroy()
end

-- ===== Сам заброс =====
local function finish()
	state = "Idle"
	reeling = false
	setPose("Rest", 8)
	UI.SetReel(false)
	camStop()
	lockMovement(false)
end

local function doCast(charge: number)
	state = "Busy"
	UI.SetCharge(false)
	setPose("Whip", 28)
	camShake(0.3)
	local res = Remotes.Get("Cast"):InvokeServer(charge)
	if not res or not res.ok then
		finish()
		local reason = res and res.reason
		if reason == "far" then
			UI.Toast("🎣 Go to the FISHING PIER to cast!", Color3.fromRGB(255, 200, 80))
			showGuide()
			UI.FlashPier()
		elseif reason == "training" then
			UI.Toast("Stop training first!", Color3.fromRGB(255, 120, 90))
		end
		return
	end
	if res.lucky then
		UI.Toast("🍀 LUCKY CAST! x" .. Config.LuckyCastLuck .. " luck", Color3.fromRGB(120, 255, 120))
	end
	local tip = Effects.RodTip(player.Character)
	local r = root()
	local from = tip and tip.WorldPosition or ((r and r.Position or Vector3.zero) + UP * 3)
	local bobber, att = Effects.MakeBobber()
	local line = tip and Effects.MakeLine(tip, att) or nil
	local landing: Vector3 = res.land
	local height = 8 + res.dist * 0.22
	local top = bobber.PrimaryPart :: BasePart
	local dir = pierDir()
	local right = dir:Cross(UP)

	-- полёт: камера летит за поплавком
	camShot(function()
		local p = top.Position
		return CFrame.lookAt(p - dir * 22 + UP * 8 + right * 7, p + dir * 6), 78
	end, 7)
	if line then
		line.CurveSize0 = 0
		line.CurveSize1 = 0
	end
	local t0 = os.clock()
	while os.clock() - t0 < res.flight do
		local t = (os.clock() - t0) / res.flight
		Effects.PlaceBobber(bobber, Effects.Arc(from, landing, height, t))
		if t > 0.25 then
			setPose("Hold", 6)
		end
		RunService.RenderStepped:Wait()
	end
	Effects.PlaceBobber(bobber, landing)
	Effects.Splash(landing, 1.2)
	camShake(0.25)
	local zone = GameData.Zones[res.zone]
	UI.Toast("🌊 " .. zone.Name .. "  •  " .. math.floor(res.dist) .. "m", zone.Color, 2)
	if line then
		line.CurveSize0 = -2
		line.CurveSize1 = 3
	end

	-- ожидание поклёвки: спокойный общий план
	camShot(function(t)
		local sway = math.sin(t * 0.6) * 3
		return CFrame.lookAt(landing - dir * 26 + UP * 11 + right * (10 + sway), landing + UP * 1), 58
	end, 3)
	local t1 = os.clock()
	local nextRipple = 0
	while os.clock() - t1 < res.bite do
		local bob = math.sin(os.clock() * 3.5) * 0.15
		Effects.PlaceBobber(bobber, landing + Vector3.new(0, bob, 0))
		if os.clock() > nextRipple then
			nextRipple = os.clock() + 1.2
			Effects.Ripple(landing, 4)
		end
		RunService.RenderStepped:Wait()
	end

	-- клюёт! наезд камеры
	local bb = exclamation(top, res.rarity)
	Effects.Splash(landing, 0.8)
	camShake(res.rarity >= GameData.RarityIndex.Legendary and 1.5 or 0.7)
	camShot(function(t)
		local push = math.min(1, t / 3) * 3
		return CFrame.lookAt(landing - dir * (14 - push) + UP * 5 + right * 5, landing), 48
	end, 6)
	reelProgress = 0
	reeling = true
	setPose("Reel", 14)
	if line then
		line.CurveSize0 = 0
		line.CurveSize1 = 0
	end
	UI.SetReel(true, 0, res.rarity)
	local autoTime = res.reel * 1.7
	local nextSplash = 0
	while reelProgress < 1 do
		local dt = RunService.RenderStepped:Wait()
		reelProgress += dt / autoTime
		UI.SetReel(true, reelProgress, res.rarity)
		local jitter = Vector3.new(math.random() - 0.5, -0.3, math.random() - 0.5) * 0.6
		Effects.PlaceBobber(bobber, landing + jitter)
		if os.clock() > nextSplash then
			nextSplash = os.clock() + 0.3
			Effects.Ripple(landing, 3)
		end
	end
	reeling = false
	UI.SetReel(false)
	bb:Destroy()

	-- забрать рыбу с сервера
	local catch = nil
	for _ = 1, 6 do
		catch = Remotes.Get("Reel"):InvokeServer()
		if catch and catch.ok then
			break
		elseif catch and catch.reason == "early" then
			task.wait(math.max(0.05, catch.wait or 0.2))
		else
			break
		end
	end
	bobber:Destroy()
	if line then
		line:Destroy()
	end
	if catch and catch.ok then
		local ok, err = pcall(catchCutscene, catch, landing)
		if not ok then
			warn("[Fishing] cutscene: " .. tostring(err))
		end
		finish()
		UI.ShowCatch(catch)
	else
		finish()
		UI.Toast("The fish got away... 🐟", Color3.fromRGB(200, 200, 220))
	end
end

-- ===== Ввод =====
local function nearPier(): boolean
	local r = root()
	return r ~= nil and ClientState.InCastZone(r.Position)
end

local function beginCharge(auto: boolean?)
	if state ~= "Idle" or player:GetAttribute("Training") or not ClientState.Data then
		return
	end
	if not nearPier() then
		UI.Toast("🎣 Go to the FISHING PIER to cast!", Color3.fromRGB(255, 200, 80))
		showGuide()
		UI.FlashPier()
		return
	end
	-- в автозабросе камера не дёргается (игрок может быть АФК)
	cinematic = not auto
	state = "Charging"
	chargeStart = os.clock()
	poseCharge = 0
	setPose("Windup", 14)
	lockMovement(true)
	camStart()
	camShot(function()
		return overShoulder(), 62
	end, 6)
end

local function releaseCharge()
	if state ~= "Charging" then
		return
	end
	local charge = math.clamp((os.clock() - chargeStart) / Config.ChargeTime, 0.05, 1)
	task.spawn(function()
		local ok, err = pcall(doCast, charge)
		if not ok then
			warn("[Fishing] " .. tostring(err))
			finish()
		end
	end)
end

local function reelClick()
	if reeling then
		reelProgress += 0.12
		camShake(0.15)
	end
end

function Fishing.Init()
	UI.Callbacks.CastDown = function()
		beginCharge(false)
	end
	UI.Callbacks.CastUp = releaseCharge

	UserInputService.InputBegan:Connect(function(input, processed)
		local isClick = input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
		if not isClick then
			if input.KeyCode == Enum.KeyCode.E and not processed then
				if reeling then
					reelClick()
				else
					beginCharge(false)
				end
			end
			return
		end
		if reeling then
			reelClick()
			return
		end
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 and nearPier() then
			beginCharge(false)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.E then
			releaseCharge()
		end
	end)

	player.CharacterAdded:Connect(function()
		joints = {}
		if state == "Charging" then
			state = "Idle"
			UI.SetCharge(false)
			camStop()
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		if state == "Charging" then
			local charge = math.clamp((os.clock() - chargeStart) / Config.ChargeTime, 0, 1)
			poseCharge = charge
			UI.SetCharge(true, charge, Config.MaxDistance(ClientState.Power()))
		end
		updatePose(dt)
		updateCamera(dt)
	end)

	-- Автозаброс (геймпасс)
	task.spawn(function()
		while true do
			task.wait(0.5)
			if UI.AutoCast and ClientState.HasPass("AutoCast") and state == "Idle" and not player:GetAttribute("Training") and nearPier() then
				beginCharge(true)
				task.wait(Config.ChargeTime + 0.1)
				if state == "Charging" then
					releaseCharge()
				end
			end
		end
	end)
end

return Fishing
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX00000015"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Точка входа клиента.

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer

while not workspace:GetAttribute("WorldReady") do
	task.wait(0.2)
end

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local Effects = require(script.Parent.Effects)
local Fishing = require(script.Parent.Fishing)
local Training = require(script.Parent.Training)

ClientState.Init()
UI.Init()
Effects.Init()
Fishing.Init()
Training.Init()
UI.Callbacks.UpgradeCutscene = Effects.UpgradeCutscene

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- подсказка новичку
task.delay(4, function()
	local data = ClientState.Data
	if data and (data.TotalCaught or 0) == 0 then
		UI.Toast("👋 Go to the FISHING PIER and HOLD the CAST button!", Color3.fromRGB(120, 240, 255), 7)
		task.wait(2)
		UI.Toast("💪 Train on the pull-up bars to throw farther!", Color3.fromRGB(255, 220, 90), 7)
	end
end)

local _ = player
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Training</string><ProtectedString name="Source"><![CDATA[-- Турник на клиенте: панель, клики для ускорения, «+N 💪», выход прыжком.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local Training = {}

local lastClick = 0

function Training.Init()
	local function onChanged()
		UI.SetTraining(player:GetAttribute("Training") == true)
	end
	player:GetAttributeChangedSignal("Training"):Connect(onChanged)
	onChanged()

	Remotes.Get("Rep").OnClientEvent:Connect(function(gain)
		UI.RepPop(gain)
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not player:GetAttribute("Training") then
			return
		end
		local isClick = input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.E
		if isClick and not processed then
			local now = os.clock()
			if now - lastClick > 0.12 then
				lastClick = now
				Remotes.Get("Rep"):FireServer()
			end
		end
	end)

	UserInputService.JumpRequest:Connect(function()
		if player:GetAttribute("Training") then
			Remotes.Get("StopTraining"):InvokeServer()
		end
	end)
end

return Training
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- Весь интерфейс игры, создаётся кодом.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local GameData = require(Shared.GameData)
local Format = require(Shared.Format)
local FishBuilder = require(Shared.FishBuilder)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer

local UI = {}
UI.Callbacks = {} :: { [string]: (...any) -> () }
UI.AutoCast = false

local gui: ScreenGui
local scaled = {} :: { UIScale }
local spinning = {} :: { { vp: ViewportFrame, model: Model, cf: CFrame } }
local rainbowGradients = {} :: { UIGradient }

-- ===== Палитра =====
local C = {
	Panel = Color3.fromRGB(55, 150, 255),
	Panel2 = Color3.fromRGB(28, 88, 200),
	Stroke = Color3.fromRGB(12, 12, 18),
	White = Color3.fromRGB(255, 255, 255),
	Green = Color3.fromRGB(80, 220, 100),
	Green2 = Color3.fromRGB(35, 160, 70),
	Blue = Color3.fromRGB(70, 180, 255),
	Blue2 = Color3.fromRGB(30, 110, 220),
	Orange = Color3.fromRGB(255, 170, 60),
	Orange2 = Color3.fromRGB(235, 110, 30),
	Red = Color3.fromRGB(255, 90, 90),
	Red2 = Color3.fromRGB(200, 45, 60),
	Gold = Color3.fromRGB(255, 220, 70),
	Gold2 = Color3.fromRGB(235, 160, 20),
	Purple = Color3.fromRGB(190, 110, 255),
	Purple2 = Color3.fromRGB(120, 60, 220),
	Gray = Color3.fromRGB(150, 155, 170),
	Gray2 = Color3.fromRGB(95, 100, 115),
}

-- ===== Конструктор =====
local function new(class: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = inst
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(r: number?)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 12) })
end

local function stroke(th: number?, color: Color3?)
	return new("UIStroke", { Thickness = th or 3, Color = color or C.Stroke, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function grad(c1: Color3, c2: Color3, rot: number?)
	return new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rot or 90 })
end

local function text(props: { [string]: any }): TextLabel
	local t = new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		TextColor3 = C.White,
		TextScaled = true,
		Text = "",
	})
	for k, v in pairs(props) do
		if k ~= "Parent" and k ~= "StrokeThickness" and k ~= "MaxText" then
			(t :: any)[k] = v
		end
	end
	new("UIStroke", { Thickness = props.StrokeThickness or 2.5, Color = C.Stroke, LineJoinMode = Enum.LineJoinMode.Round, Parent = t })
	new("UITextSizeConstraint", { MaxTextSize = props.MaxText or 60, Parent = t })
	t.Parent = props.Parent
	return t
end

local function scaleable(obj: GuiObject)
	local s = new("UIScale", { Parent = obj })
	table.insert(scaled, s)
	return s
end

local function panel(props: { [string]: any }): Frame
	local f = new("Frame", { BackgroundColor3 = C.Panel, BorderSizePixel = 0 })
	for k, v in pairs(props) do
		if k ~= "Parent" and k ~= "Corner" then
			(f :: any)[k] = v
		end
	end
	corner(props.Corner or 16).Parent = f
	stroke(3.5).Parent = f
	grad(C.White, Color3.fromRGB(185, 200, 235)).Parent = f
	f.Parent = props.Parent
	return f
end

local function button(props: { [string]: any }, onClick: (() -> ())?): TextButton
	local c1, c2 = props.C1 or C.Green, props.C2 or C.Green2
	local b = new("TextButton", {
		BackgroundColor3 = C.White,
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		Size = props.Size,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.LayoutOrder,
		ZIndex = props.ZIndex,
	})
	corner(props.Corner or 12).Parent = b
	stroke(3.5).Parent = b
	local g = grad(c1, c2)
	g.Parent = b
	local us = new("UIScale", { Parent = b })
	local label = text({
		Text = props.Text or "",
		Size = UDim2.new(1, -10, 1, -6),
		Position = UDim2.fromOffset(5, 3),
		MaxText = props.MaxText or 32,
		ZIndex = props.ZIndex,
		Font = Enum.Font.LuckiestGuy,
		StrokeThickness = 3,
		Parent = b,
	})
	label.Name = "Label"
	b.MouseEnter:Connect(function()
		TweenService:Create(us, TweenInfo.new(0.12), { Scale = 1.06 }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(us, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	b.MouseButton1Down:Connect(function()
		TweenService:Create(us, TweenInfo.new(0.06), { Scale = 0.93 }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		TweenService:Create(us, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end)
	if onClick then
		b.Activated:Connect(onClick)
	end
	b:SetAttribute("C1", c1)
	return b
end

local function setButtonColors(b: TextButton, c1: Color3, c2: Color3)
	local g = b:FindFirstChildOfClass("UIGradient")
	if g then
		g.Color = ColorSequence.new(c1, c2)
	end
end

local function rarityGradient(label: TextLabel, rarity: number)
	if rarity == GameData.RarityIndex.Secret then
		local g = new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
				ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 220, 60)),
				ColorSequenceKeypoint.new(0.4, Color3.fromRGB(80, 255, 120)),
				ColorSequenceKeypoint.new(0.6, Color3.fromRGB(80, 200, 255)),
				ColorSequenceKeypoint.new(0.8, Color3.fromRGB(190, 100, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 80, 80)),
			}),
			Parent = label,
		})
		table.insert(rainbowGradients, g)
	elseif rarity == GameData.RarityIndex.Mythic then
		new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 120, 140), Color3.fromRGB(255, 40, 80)), Rotation = 90, Parent = label })
	end
end

-- 3D-превью рыбы
local function fishViewport(parent: Instance, fishId: string, mutation: string, silhouette: boolean, spin: boolean, props: { [string]: any }?): ViewportFrame
	local vp = new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(170, 175, 190),
		LightColor = Color3.fromRGB(255, 255, 250),
		LightDirection = Vector3.new(-0.6, -1, -0.4),
	})
	if props then
		for k, v in pairs(props) do
			(vp :: any)[k] = v
		end
	end
	if silhouette then
		vp.ImageColor3 = Color3.fromRGB(0, 0, 0)
		vp.ImageTransparency = 0.25
	end
	local model = FishBuilder.Build(fishId, mutation, 2, { static = true })
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Light") or d:IsA("ParticleEmitter") then
			d:Destroy()
		end
	end
	local cf, size = model:GetBoundingBox()
	local center = cf.Position
	model:PivotTo(CFrame.new(-center) * model:GetPivot())
	model.Parent = vp
	local cam = new("Camera", { FieldOfView = 30, Parent = vp })
	local dist = size.Magnitude * 1.65
	cam.CFrame = CFrame.lookAt(Vector3.new(dist * 0.82, dist * 0.22, -dist * 0.5), Vector3.zero)
	vp.CurrentCamera = cam
	vp.Parent = parent
	if spin then
		table.insert(spinning, { vp = vp, model = model, cf = model:GetPivot() })
	end
	return vp
end

-- ===== Тосты (уведомления) =====
local toastList: Frame

function UI.Toast(msg: string, color: Color3?, duration: number?)
	if not toastList then
		return
	end
	local f = panel({ Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = C.Panel2, Parent = toastList, BackgroundTransparency = 0.05 })
	f.LayoutOrder = -math.floor(os.clock() * 100)
	local t = text({ Text = msg, Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), TextColor3 = color or C.White, MaxText = 22, Parent = f })
	t.TextXAlignment = Enum.TextXAlignment.Left
	local us = new("UIScale", { Scale = 0.6, Parent = f })
	TweenService:Create(us, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(duration or 3.5, function()
		local tw = TweenService:Create(us, TweenInfo.new(0.2), { Scale = 0 })
		tw:Play()
		tw.Completed:Wait()
		f:Destroy()
	end)
	local children = toastList:GetChildren()
	local count = 0
	for _, c in ipairs(children) do
		if c:IsA("Frame") then
			count += 1
		end
	end
	if count > 5 then
		local oldest, oldestOrder = nil, -math.huge
		for _, c in ipairs(children) do
			if c:IsA("Frame") and c.LayoutOrder > oldestOrder then
				oldest, oldestOrder = c, c.LayoutOrder
			end
		end
		if oldest then
			oldest:Destroy()
		end
	end
end

-- ===== Покупки за Robux =====
local function buy(kind: string, key: string, id: number)
	if id == 0 then
		if RunService:IsStudio() then
			local ok = Remotes.Get("DevGrant"):InvokeServer(key)
			UI.Toast(ok and ("🧪 Studio test: got " .. key) or "Test grant failed", C.Gold)
		else
			UI.Toast("This item is not set up yet", C.Red)
		end
		return
	end
	if kind == "pass" then
		MarketplaceService:PromptGamePassPurchase(player, id)
	else
		MarketplaceService:PromptProductPurchase(player, id)
	end
end
UI.Buy = buy

local function nextTrainingPass()
	for _, p in ipairs(Config.TrainingPasses) do
		if not ClientState.HasPass(p.Key) then
			return p
		end
	end
	return nil
end
UI.NextTrainingPass = nextTrainingPass

-- ===== Окна =====
local windowHolder: Frame
local currentWindow: Frame? = nil
local currentName: string? = nil
local renderers = {} :: { [string]: (Frame) -> () }

local function closeWindow()
	if currentWindow then
		local w = currentWindow
		currentWindow = nil
		currentName = nil
		local us = w:FindFirstChild("PopScale") :: UIScale
		local tw = TweenService:Create(us, TweenInfo.new(0.15), { Scale = 0.5 })
		tw:Play()
		tw.Completed:Connect(function()
			w:Destroy()
		end)
	end
end
UI.CloseWindow = closeWindow

local function openWindow(name: string, title: string, c1: Color3, c2: Color3)
	if currentName == name then
		closeWindow()
		return
	end
	if currentWindow then
		currentWindow:Destroy()
		currentWindow = nil
	end
	local w = panel({
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(860, 580),
		BackgroundColor3 = C.Panel,
		Parent = windowHolder,
	})
	local pop = new("UIScale", { Name = "PopScale", Scale = 0.5, Parent = w })
	TweenService:Create(pop, TweenInfo.new(0.28, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	local header = new("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = C.White, BorderSizePixel = 0, Parent = w })
	corner(14).Parent = header
	grad(c1, c2).Parent = header
	text({ Text = title, Size = UDim2.new(1, -120, 0, 44), Position = UDim2.fromOffset(18, 6), MaxText = 38, Font = Enum.Font.LuckiestGuy, StrokeThickness = 3.5, TextXAlignment = Enum.TextXAlignment.Left, Parent = header })
	button({ Text = "X", Size = UDim2.fromOffset(46, 46), Position = UDim2.new(1, -52, 0, 5), C1 = C.Red, C2 = C.Red2 }, closeWindow).Parent = header
	local body = new("Frame", { Name = "Body", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 64), Size = UDim2.new(1, -24, 1, -76), Parent = w })
	currentWindow = w
	currentName = name
	renderers[name](body)
end

local function rerenderWindow()
	if currentWindow and currentName and renderers[currentName] then
		local body = currentWindow:FindFirstChild("Body") :: Frame
		local scroll = body:FindFirstChildWhichIsA("ScrollingFrame", true)
		local pos = scroll and scroll.CanvasPosition
		for _, c in ipairs(body:GetChildren()) do
			c:Destroy()
		end
		renderers[currentName](body)
		local newScroll = body:FindFirstChildWhichIsA("ScrollingFrame", true)
		if newScroll and pos then
			newScroll.CanvasPosition = pos
		end
	end
end

local function scroller(parent: Instance, size: UDim2, pos: UDim2?): ScrollingFrame
	return new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = size,
		Position = pos or UDim2.new(),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.White,
		Parent = parent,
	})
end

-- Магазин наживок + расширение аквариума
renderers.Shop = function(body: Frame)
	local data = ClientState.Data
	if not data then
		return
	end
	local cash = ClientState.Cash()
	-- наживки
	local list = scroller(body, UDim2.fromScale(1, 1))
	new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	new("UIPadding", { PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2), Parent = list })
	for i, bait in ipairs(GameData.Baits) do
		local row = panel({ Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = C.Panel2, LayoutOrder = i, Parent = list })
		local dot = new("Frame", { Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(12, 12), BackgroundColor3 = bait.Color, Parent = row })
		corner(20).Parent = dot
		stroke(3).Parent = dot
		text({ Text = bait.Name, Size = UDim2.new(0.45, 0, 0, 32), Position = UDim2.fromOffset(64, 4), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 26, Parent = row })
		text({ Text = "🍀 x" .. bait.Luck .. " Luck", Size = UDim2.new(0.45, 0, 0, 22), Position = UDim2.fromOffset(64, 36), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Green, MaxText = 18, Parent = row })
		local owned = data.Baits[bait.Id]
		local equipped = data.Bait == bait.Id
		local label, c1, c2
		if equipped then
			label, c1, c2 = "EQUIPPED", C.Gray, C.Gray2
		elseif owned then
			label, c1, c2 = "EQUIP", C.Blue, C.Blue2
		else
			local can = cash >= bait.Price
			label, c1, c2 = Format.Money(bait.Price), can and C.Green or C.Gray, can and C.Green2 or C.Gray2
		end
		button({ Text = label, Size = UDim2.fromOffset(170, 48), Position = UDim2.new(1, -180, 0, 8), C1 = c1, C2 = c2 }, function()
			if equipped then
				return
			end
			local res = Remotes.Get("BuyBait"):InvokeServer(bait.Id)
			if res and not res.ok then
				UI.Toast(res.msg, C.Red)
			elseif res and res.bought then
				UI.Toast("🪱 Bought " .. bait.Name .. "!", C.Green)
			end
		end).Parent = row
	end
end

-- Аквариум: список рыб и продажа
renderers.Aquarium = function(body: Frame)
	local data = ClientState.Data
	if not data then
		return
	end
	local top = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 50), Parent = body })
	text({ Text = #data.Fish .. "/" .. data.Capacity .. " fish", Size = UDim2.new(0.3, 0, 1, -10), Position = UDim2.fromOffset(4, 5), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 26, Parent = top })
	button({ Text = "Sell all Common", Size = UDim2.fromOffset(200, 44), Position = UDim2.new(1, -412, 0, 3), C1 = C.Orange, C2 = C.Orange2, MaxText = 20 }, function()
		local res = Remotes.Get("SellBulk"):InvokeServer(1)
		if res and res.ok then
			UI.Toast("💰 Sold " .. res.count .. " fish for " .. Format.Money(res.cash), C.Gold)
		elseif res then
			UI.Toast(res.msg, C.Red)
		end
	end).Parent = top
	button({ Text = "Sell ≤ Rare", Size = UDim2.fromOffset(200, 44), Position = UDim2.new(1, -204, 0, 3), C1 = C.Red, C2 = C.Red2, MaxText = 20 }, function()
		local res = Remotes.Get("SellBulk"):InvokeServer(3)
		if res and res.ok then
			UI.Toast("💰 Sold " .. res.count .. " fish for " .. Format.Money(res.cash), C.Gold)
		elseif res then
			UI.Toast(res.msg, C.Red)
		end
	end).Parent = top
	local grid = scroller(body, UDim2.new(1, 0, 1, -58), UDim2.fromOffset(0, 58))
	new("UIGridLayout", { CellSize = UDim2.fromOffset(142, 186), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	new("UIPadding", { PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2), Parent = grid })
	local fishList = table.clone(data.Fish)
	table.sort(fishList, function(a, b)
		return GameData.FishIncome(a.Id, a.M, a.S) > GameData.FishIncome(b.Id, b.M, b.S)
	end)
	if #fishList == 0 then
		text({ Text = "No fish yet — go cast from the Fishing Pier! 🎣", Size = UDim2.new(1, 0, 0, 40), MaxText = 24, Parent = grid })
	end
	for i, f in ipairs(fishList) do
		local def = GameData.FishById[f.Id]
		if def then
			local rarity = GameData.Rarities[def.Rarity]
			local card = panel({ BackgroundColor3 = C.Panel2, LayoutOrder = i, Parent = grid })
			local holder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 78), Position = UDim2.fromOffset(0, 4), Parent = card })
			fishViewport(holder, f.Id, f.M, false, false)
			local nameLabel = text({ Text = GameData.FullName(f.Id, f.M, f.S), Size = UDim2.new(1, -8, 0, 34), Position = UDim2.fromOffset(4, 82), TextColor3 = rarity.Color, MaxText = 18, TextWrapped = true, Parent = card })
			rarityGradient(nameLabel, def.Rarity)
			text({ Text = Format.Money(GameData.FishIncome(f.Id, f.M, f.S)) .. "/s", Size = UDim2.new(1, -8, 0, 20), Position = UDim2.fromOffset(4, 116), TextColor3 = C.Green, MaxText = 18, Parent = card })
			local price = math.floor(GameData.FishIncome(f.Id, f.M, f.S) * Config.SellSeconds)
			button({ Text = "Sell " .. Format.Money(price), Size = UDim2.new(1, -12, 0, 38), Position = UDim2.fromOffset(6, 142), C1 = C.Orange, C2 = C.Orange2, MaxText = 18 }, function()
				local res = Remotes.Get("SellFish"):InvokeServer(f.U)
				if res and res.ok then
					UI.Toast("💰 +" .. Format.Money(res.cash), C.Gold)
				end
			end).Parent = card
		end
	end
end

-- Коллекция (индекс)
renderers.Index = function(body: Frame)
	local data = ClientState.Data
	if not data then
		return
	end
	local found = 0
	for _, f in ipairs(GameData.Fish) do
		if data.Index[f.Id] then
			found += 1
		end
	end
	text({ Text = "Discovered: " .. found .. "/" .. #GameData.Fish, Size = UDim2.new(1, 0, 0, 34), MaxText = 26, Parent = body })
	local list = scroller(body, UDim2.new(1, 0, 1, -42), UDim2.fromOffset(0, 42))
	new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	new("UIPadding", { PaddingRight = UDim.new(0, 12), PaddingLeft = UDim.new(0, 2), Parent = list })
	for z, zone in ipairs(GameData.Zones) do
		local section = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = z, Parent = list })
		new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = section })
		text({ Text = zone.Name, Size = UDim2.new(1, 0, 0, 30), TextColor3 = zone.Color, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 26, LayoutOrder = 0, Parent = section })
		local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = section })
		new("UIGridLayout", { CellSize = UDim2.fromOffset(110, 128), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
		for i, f in ipairs(GameData.FishByZone[z]) do
			local known = data.Index[f.Id] == true
			local rarity = GameData.Rarities[f.Rarity]
			local card = panel({ BackgroundColor3 = C.Panel2, LayoutOrder = i, Parent = row })
			local holder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 70), Position = UDim2.fromOffset(0, 2), Parent = card })
			fishViewport(holder, f.Id, "None", not known, false)
			local nameLabel = text({ Text = known and f.Name or "???", Size = UDim2.new(1, -6, 0, 24), Position = UDim2.fromOffset(3, 74), TextColor3 = known and C.White or C.Gray, MaxText = 16, Parent = card })
			nameLabel.TextWrapped = true
			local rl = text({ Text = rarity.Name, Size = UDim2.new(1, -6, 0, 20), Position = UDim2.fromOffset(3, 100), TextColor3 = rarity.Color, MaxText = 15, Parent = card })
			rarityGradient(rl, f.Rarity)
		end
	end
end

-- Магазин за Robux
renderers.Store = function(body: Frame)
	local list = scroller(body, UDim2.fromScale(1, 1))
	new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	new("UIPadding", { PaddingRight = UDim.new(0, 12), PaddingLeft = UDim.new(0, 2), PaddingTop = UDim.new(0, 2), Parent = list })

	-- лесенка тренировки
	local train = panel({ Size = UDim2.new(1, 0, 0, 120), BackgroundColor3 = C.Panel2, LayoutOrder = 1, Parent = list })
	local data = ClientState.Data
	local curMult = 1
	for _, p in ipairs(Config.TrainingPasses) do
		if ClientState.HasPass(p.Key) then
			curMult = math.max(curMult, p.Mult)
		end
	end
	text({ Text = "💪 TRAINING SPEED", Size = UDim2.new(0.6, 0, 0, 34), Position = UDim2.fromOffset(12, 8), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Gold, MaxText = 28, Parent = train })
	text({ Text = "Now: x" .. curMult .. " power per pull-up", Size = UDim2.new(0.6, 0, 0, 24), Position = UDim2.fromOffset(12, 44), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Parent = train })
	local ladder = {}
	for _, p in ipairs(Config.TrainingPasses) do
		table.insert(ladder, (ClientState.HasPass(p.Key) and "✅ x" or "x") .. p.Mult)
	end
	text({ Text = table.concat(ladder, "  →  "), Size = UDim2.new(0.6, 0, 0, 22), Position = UDim2.fromOffset(12, 76), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Gray, MaxText = 18, Parent = train })
	local nextPass = nextTrainingPass()
	if nextPass then
		local b = button({ Text = "x" .. nextPass.Mult .. "  for  " .. nextPass.Price .. " R$", Size = UDim2.fromOffset(220, 70), Position = UDim2.new(1, -230, 0, 25), C1 = C.Gold, C2 = C.Gold2, MaxText = 26 }, function()
			buy("pass", nextPass.Key, nextPass.Id)
		end)
		b.Parent = train
	else
		button({ Text = "MAXED!", Size = UDim2.fromOffset(220, 70), Position = UDim2.new(1, -230, 0, 25), C1 = C.Gray, C2 = C.Gray2 }).Parent = train
	end

	text({ Text = "⭐ Game Passes", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 26, LayoutOrder = 2, Parent = list })
	local passGrid = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = list })
	new("UIGridLayout", { CellSize = UDim2.new(0.5, -5, 0, 118), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = passGrid })
	local passOrder = { "AutoCast", "Cash2", "Luck2", "BigTank" }
	for i, key in ipairs(passOrder) do
		local p = Config.Passes[key]
		local owned = ClientState.HasPass(key)
		local card = panel({ BackgroundColor3 = C.Panel2, LayoutOrder = i, Parent = passGrid })
		text({ Text = p.Name, Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 6), TextColor3 = C.Gold, MaxText = 24, Parent = card })
		local d = text({ Text = p.Desc, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.fromOffset(8, 36), MaxText = 15, TextWrapped = true, Parent = card })
		d.TextColor3 = C.Gray
		button({ Text = owned and "OWNED" or (p.Price .. " R$"), Size = UDim2.new(1, -16, 0, 38), Position = UDim2.fromOffset(8, 74), C1 = owned and C.Gray or C.Green, C2 = owned and C.Gray2 or C.Green2, MaxText = 22 }, function()
			if not owned then
				buy("pass", key, p.Id)
			end
		end).Parent = card
	end

	text({ Text = "🍀 Boosts", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 26, LayoutOrder = 4, Parent = list })
	local prodGrid = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = list })
	new("UIGridLayout", { CellSize = UDim2.new(0.333, -7, 0, 128), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = prodGrid })
	for key, p in pairs(Config.Products) do
		local card = panel({ BackgroundColor3 = C.Panel2, LayoutOrder = p.Order, Parent = prodGrid })
		text({ Text = p.Name, Size = UDim2.new(1, -12, 0, 30), Position = UDim2.fromOffset(6, 6), TextColor3 = C.Green, MaxText = 20, Parent = card })
		local d = text({ Text = p.Desc, Size = UDim2.new(1, -12, 0, 40), Position = UDim2.fromOffset(6, 36), MaxText = 14, TextWrapped = true, Parent = card })
		d.TextColor3 = C.Gray
		button({ Text = p.Price .. " R$", Size = UDim2.new(1, -12, 0, 38), Position = UDim2.fromOffset(6, 84), C1 = C.Green, C2 = C.Green2, MaxText = 22 }, function()
			buy("product", key, p.Id)
		end).Parent = card
	end
	local _ = data
end

-- Улучшения базы: редкие, дорогие, с эффектной сценой
local function upgradeCard(parent: Instance, order: number, title: string, icon: string, color1: Color3, color2: Color3, current: string, nextText: string?, bonus: string, price: number?, onBuy: () -> ())
	local card = panel({ BackgroundColor3 = C.Panel2, LayoutOrder = order, Parent = parent })
	local head = new("Frame", { Size = UDim2.new(1, 0, 0, 54), BackgroundColor3 = C.White, BorderSizePixel = 0, Parent = card })
	corner(16).Parent = head
	grad(color1, color2).Parent = head
	text({ Text = title, Size = UDim2.new(1, -20, 1, -10), Position = UDim2.fromOffset(10, 5), Font = Enum.Font.LuckiestGuy, MaxText = 34, StrokeThickness = 3.5, Parent = head })
	text({ Text = icon, Size = UDim2.new(1, 0, 0, 110), Position = UDim2.fromOffset(0, 62), MaxText = 96, StrokeThickness = 0, Parent = card })
	text({ Text = current, Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 176), Font = Enum.Font.LuckiestGuy, MaxText = 30, StrokeThickness = 3, Parent = card })
	text({ Text = nextText and ("NEXT: " .. nextText) or "MAX LEVEL!", Size = UDim2.new(1, -20, 0, 28), Position = UDim2.fromOffset(10, 214), Font = Enum.Font.LuckiestGuy, TextColor3 = C.Gold, MaxText = 24, StrokeThickness = 3, Parent = card })
	text({ Text = bonus, Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 246), TextColor3 = Color3.fromRGB(170, 255, 170), MaxText = 22, Parent = card })
	if price then
		local can = ClientState.Cash() >= price
		button({ Text = "UPGRADE  " .. Format.Money(price), Size = UDim2.new(1, -24, 0, 66), Position = UDim2.new(0, 12, 1, -78), C1 = can and C.Green or C.Gray, C2 = can and C.Green2 or C.Gray2, MaxText = 32 }, onBuy).Parent = card
	else
		button({ Text = "MAXED", Size = UDim2.new(1, -24, 0, 66), Position = UDim2.new(0, 12, 1, -78), C1 = C.Gray, C2 = C.Gray2, MaxText = 32 }).Parent = card
	end
end

renderers.Upgrade = function(body: Frame)
	local data = ClientState.Data
	if not data then
		return
	end
	local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = body })
	new("UIGridLayout", { CellSize = UDim2.new(0.5, -8, 1, 0), CellPadding = UDim2.fromOffset(16, 0), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
	local lvl = data.TankLevel or 0
	local maxed = lvl >= Config.MaxTankUpgrades
	upgradeCard(row, 1, "AQUARIUM", "🐠", C.Blue, C.Blue2,
		Config.TankUpgradeNames[lvl + 1] .. "  •  " .. data.Capacity .. " slots",
		(not maxed) and Config.TankUpgradeNames[lvl + 2] or nil,
		maxed and "Your tank is legendary!" or ("+" .. Config.SlotsPerUpgrade .. " slots + brand new look"),
		(not maxed) and Config.TankUpgradeCost(lvl) or nil,
		function()
			local myPlot = ClientState.MyPlot()
			local oldTank = myPlot and myPlot:FindFirstChild("Tank")
			local res = Remotes.Get("UpgradeTank"):InvokeServer()
			if res and res.ok then
				closeWindow()
				if UI.Callbacks.UpgradeCutscene then
					task.spawn(UI.Callbacks.UpgradeCutscene, "Tank", Config.TankUpgradeNames[lvl + 2], oldTank)
				end
			elseif res then
				UI.Toast(res.msg, C.Red)
			end
		end)
	local gear = GameData.Gear[data.Gear or 1]
	local nextGear = GameData.Gear[(data.Gear or 1) + 1]
	upgradeCard(row, 2, "PULL-UP BAR", "🏋️", C.Orange, C.Orange2,
		gear.Id .. "  •  x" .. gear.Mult .. " power",
		nextGear and nextGear.Id or nil,
		nextGear and ("x" .. nextGear.Mult .. " power per pull-up!") or "Strongest bar in the ocean!",
		nextGear and nextGear.Price or nil,
		function()
			local res = Remotes.Get("BuyGear"):InvokeServer()
			if res and res.ok then
				closeWindow()
				if UI.Callbacks.UpgradeCutscene then
					task.spawn(UI.Callbacks.UpgradeCutscene, "Bar", tostring(res.name))
				end
			elseif res then
				UI.Toast(res.msg, C.Red)
			end
		end)
end

function UI.OpenWindow(name: string)
	if name == "Shop" then
		openWindow("Shop", "🛒 Shop", C.Orange, C.Orange2)
	elseif name == "Aquarium" then
		openWindow("Aquarium", "🐠 My Aquarium", C.Blue, C.Blue2)
	elseif name == "Index" then
		openWindow("Index", "📖 Fish Index", C.Purple, C.Purple2)
	elseif name == "Upgrade" then
		openWindow("Upgrade", "⬆️ Base Upgrades", C.Green, C.Green2)
	elseif name == "Store" then
		openWindow("Store", "💎 Store", C.Gold, C.Gold2)
	end
end

