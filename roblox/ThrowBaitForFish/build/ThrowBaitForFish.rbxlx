	end

	-- сила внизу
	local powerFrame = panel({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.fromOffset(500, 76), BackgroundColor3 = C.Panel, Parent = gui })
