		end
		if it[2] == "UPGRADE" then
			upgradeButton = b
		end
		if it[2] == "STORE" then
			task.spawn(function()
				local us = b:FindFirstChildOfClass("UIScale")
				while b.Parent do
					task.wait(4)
					if us then
						TweenService:Create(us, TweenInfo.new(0.18, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 3, true), { Scale = 1.12 }):Play()
					end
