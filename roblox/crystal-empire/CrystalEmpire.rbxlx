			bb.BackgroundColor3 = mm == buyMode and GOLD or PANEL
			bb.TextColor3 = mm == buyMode and Color3.fromRGB(40, 30, 10) or WHITE
		end
	end)
end
modeButtons[1].BackgroundColor3 = GOLD
modeButtons[1].TextColor3 = Color3.fromRGB(40, 30, 10)

