<Item class="Script" referent="RBX00000000000000000000000000000007"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- Сервер: экономика, покупка узлов, перерождения, автопокупка, падающие звёзды, сохранение.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local World = require(script:WaitForChild("World"))

type Data = Config.Data

local store: DataStore? = nil
local topStore: OrderedDataStore? = nil
do
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore("LightTree_v1")
		topStore = DataStoreService:GetOrderedDataStore("LightTree_Top_v1")
	end)
	if not ok then
		warn("DataStore недоступен:", err)
	end
end

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remote(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end
local R = {
	Buy = remote("Buy"),
	Teleport = remote("Teleport"),
	Claim = remote("Claim"),
	State = remote("State"),
	Event = remote("Event"),
}
remotes.Parent = ReplicatedStorage

local world = World.build()

--------------------------------------------------------------------------------
-- Сессии
--------------------------------------------------------------------------------
type Session = {
	player: Player,
	data: Data,
	lps: number,
	golden: string?,
	goldenPos: Vector3?,
	goldenExpire: number,
	nextGolden: number,
	autoTimer: number,
	lastAction: number,
	actions: number,
	loaded: boolean,
	ready: boolean,
	bestLayer: string,
}
local sessions: { [Player]: Session } = {}

local function num(v: any): number
	local n = tonumber(v)
	if n == nil or n ~= n or n == math.huge then
		return 0
	end
	return math.max(0, n)
end

local CUR = { "L", "Z", "S", "E" }

local function sanitize(saved: any): Data
	local d = Config.newData()
	if type(saved) ~= "table" then
		return d
	end
	for _, key in ipairs({ "cur", "run", "total" }) do
		local src = saved[key]
		if type(src) == "table" then
			for _, c in ipairs(CUR) do
				(d :: any)[key][c] = num(src[c])
			end
		end
	end
	if type(saved.nodes) == "table" then
		for id, lvl in pairs(saved.nodes) do
			local n = Config.NodeById[id]
			if n then
				local v = math.min(n.max, math.floor(num(lvl)))
				if v > 0 then
					d.nodes[id] = v
				end
			end
		end
	end
	if type(saved.resets) == "table" then
		for _, c in ipairs({ "Z", "S", "E" }) do
			d.resets[c] = math.floor(num(saved.resets[c]))
		end
	end
	d.golden = math.floor(num(saved.golden))
	d.playTime = num(saved.playTime)
	d.lastOnline = tonumber(saved.lastOnline)
	return d
end

local function event(s: Session, kind: string, ...)
	R.Event:FireClient(s.player, kind, ...)
end

local function recompute(s: Session)
	s.lps = Config.Lps(s.data)
end

local function sendState(s: Session)
	local d = s.data
	R.State:FireClient(s.player, {
		cur = d.cur,
		run = d.run,
		total = d.total,
		nodes = d.nodes,
		resets = d.resets,
		golden = d.golden,
		playTime = d.playTime,
		lps = s.lps,
	})
end

local function add(s: Session, c: string, amount: number)
	if amount ~= amount or amount <= 0 then
		return
	end
	local d = s.data
	d.cur[c] += amount
	d.run[c] += amount
	d.total[c] += amount
end

local function highestLayer(d: Data): string
	if (d.resets.E or 0) > 0 then
		return "E"
	elseif (d.resets.S or 0) > 0 then
		return "S"
	elseif (d.resets.Z or 0) > 0 then
		return "Z"
	end
	return "L"
end

local function updateTag(s: Session)
	local char = s.player.Character
	local head = char and char:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local bb = head:FindFirstChild("LayerTag") :: BillboardGui?
	if not bb then
		local nb = Instance.new("BillboardGui")
		nb.Name = "LayerTag"
		nb.Size = UDim2.fromOffset(200, 30)
		nb.StudsOffset = Vector3.new(0, 2.7, 0)
		nb.MaxDistance = 90
		nb.LightInfluence = 0
		local t = Instance.new("TextLabel")
		t.Name = "Text"
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.TextScaled = true
		t.Font = Enum.Font.FredokaOne
		t.TextStrokeTransparency = 0.2
		t.Parent = nb
		nb.Parent = head
		bb = nb
	end
	local label = (bb :: BillboardGui):FindFirstChild("Text") :: TextLabel
	local layer = highestLayer(s.data)
	local isl = Config.IslandById[layer]
	if layer == "L" then
		label.Text = ""
	else
		label.Text = string.format("[%s %s ×%d]", isl.icon, isl.tag, s.data.resets[layer])
		label.TextColor3 = isl.color
	end
	s.bestLayer = layer
end

local function setLeaderstats(s: Session)
	local ls = s.player:FindFirstChild("leaderstats")
	if not ls then
		return
	end
	local l = ls:FindFirstChild("💡 Свет") :: StringValue?
	if l then
		l.Value = Config.format(s.data.total.L)
	end
	local layer = ls:FindFirstChild("Слой") :: StringValue?
	if layer then
		local h = highestLayer(s.data)
		layer.Value = h == "L" and "—" or Config.IslandById[h].tag
	end
end

--------------------------------------------------------------------------------
-- Сохранение
--------------------------------------------------------------------------------
local function save(player: Player)
	local s = sessions[player]
	if not s or not s.loaded or not store then
		return
	end
	local d = s.data
	local payload = {
		cur = d.cur,
		run = d.run,
		total = d.total,
		nodes = d.nodes,
		resets = d.resets,
		golden = d.golden,
		playTime = d.playTime,
		lastOnline = os.time(),
	}
	local ok, err = pcall(function()
		(store :: DataStore):SetAsync("p_" .. player.UserId, payload)
	end)
	if not ok then
		warn("Не удалось сохранить", player.Name, err)
	end
	if topStore and d.total.L > 0 then
		local score = math.floor(math.log10(d.total.L + 1) * 100)
		pcall(function()
			(topStore :: OrderedDataStore):SetAsync("u_" .. player.UserId, score)
		end)
	end
end

local nameCache: { [number]: string } = {}
local function refreshLeaderboard()
	if not topStore then
		World.setLeaderboard({})
		return
	end
	local ok, pages = pcall(function()
		return (topStore :: OrderedDataStore):GetSortedAsync(false, 10)
	end)
	if not ok or not pages then
		return
	end
	local rows = {}
	for _, entry in ipairs((pages :: DataStorePages):GetCurrentPage()) do
		local uid = tonumber(string.sub(entry.key, 3))
		if uid then
			local name = nameCache[uid]
			if not name then
				local okName, n = pcall(function()
					return Players:GetNameFromUserIdAsync(uid)
				end)
				name = okName and n or ("Игрок " .. uid)
				nameCache[uid] = name
			end
			table.insert(rows, { name = name :: string, value = 10 ^ (entry.value / 100) })
		end
	end
	World.setLeaderboard(rows)
end

--------------------------------------------------------------------------------
-- Вход / выход
--------------------------------------------------------------------------------
local function onPlayerAdded(player: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local l = Instance.new("StringValue")
	l.Name = "💡 Свет"
	l.Parent = ls
	local layer = Instance.new("StringValue")
	layer.Name = "Слой"
	layer.Parent = ls
	ls.Parent = player

	local s: Session = {
		player = player,
		data = Config.newData(),
		lps = 1,
		golden = nil,
		goldenPos = nil,
		goldenExpire = 0,
		nextGolden = os.clock() + 30,
		autoTimer = 0,
		lastAction = 0,
		actions = 0,
		loaded = false,
		ready = false,
		bestLayer = "L",
	}
	sessions[player] = s
	player.CharacterAdded:Connect(function(char)
		char:WaitForChild("Head", 10)
		updateTag(s)
	end)

	local saved = nil
	local loadedOk = true
	if store then
		local ok, result = pcall(function()
			return (store :: DataStore):GetAsync("p_" .. player.UserId)
		end)
		if ok then
			saved = result
		else
			loadedOk = false
			warn("Не удалось загрузить", player.Name, result)
		end
	end
	if not player.Parent then
		return
	end
	s.data = sanitize(saved)
	s.loaded = loadedOk
	recompute(s)
	s.ready = true
	updateTag(s)
	setLeaderstats(s)

	local d = s.data
	if d.lastOnline then
		local away = math.clamp(os.time() - d.lastOnline, 0, Config.OFFLINE_MAX)
		if away >= 60 then
			local earned = s.lps * away * Config.OFFLINE_RATE
			add(s, "L", earned)
			local z = Config.passiveZ(d) * Config.gainZ(d) * away * Config.OFFLINE_RATE
			add(s, "Z", z)
			task.delay(2, function()
				if player.Parent then
					event(s, "offline", earned, os.time() - (d.lastOnline or os.time()), z)
				end
			end)
		end
	else
		task.delay(1.5, function()
			if player.Parent then
				event(s, "welcome")
			end
		end)
	end
	if not loadedOk then
		event(s, "message", "⚠ Не удалось загрузить сохранение — прогресс этой сессии не сохранится. Перезайди позже.")
	end
	sendState(s)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end
Players.PlayerRemoving:Connect(function(player)
	save(player)
	sessions[player] = nil
end)
game:BindToClose(function()
	local pending = 0
	for _, player in ipairs(Players:GetPlayers()) do
		pending += 1
		task.spawn(function()
			save(player)
			pending -= 1
		end)
	end
	local t = os.clock()
	while pending > 0 and os.clock() - t < 25 do
		task.wait(0.1)
	end
end)

local function allow(s: Session?): boolean
	if not s or not s.ready then
		return false
	end
	local now = os.clock()
	if now - s.lastAction > 1 then
		s.lastAction = now
		s.actions = 0
	end
	s.actions += 1
	return s.actions <= 30
end

--------------------------------------------------------------------------------
-- Покупка узлов
--------------------------------------------------------------------------------
local function buyNode(s: Session, n: Config.Node): boolean
	local d = s.data
	if not Config.canBuy(d, n) then
		return false
	end
	d.cur[n.island] -= Config.nodeCost(d, n)
	d.nodes[n.id] = Config.lvl(d, n.id) + 1
	return true
end

R.Buy.OnServerEvent:Connect(function(player, id)
	local s = sessions[player]
	local n = type(id) == "string" and Config.NodeById[id] or nil
	if not allow(s) or not n then
		return
	end
	local ses = s :: Session
	-- покупать можно, только стоя у плитки
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or (root.Position - Config.nodePosition(n)).Magnitude > 14 then
		return
	end
	if buyNode(ses, n) then
		recompute(ses)
		event(ses, "bought", n.id, Config.lvl(ses.data, n.id))
		if n.kind == "unlock" then
			event(ses, "islandOpen", Config.Islands[n.value].id)
		end
		sendState(ses)
	end
end)

-- Автопокупка: уровень 1 — Маяк, 2 — Заря, 3 — Звёзды
local AUTO_ISLANDS = { "L", "Z", "S" }
local function autobuy(s: Session)
	local level = Config.autoLevel(s.data)
	if level <= 0 then
		return
	end
	local any = false
	for i = 1, level do
		local island = AUTO_ISLANDS[i]
		for _ = 1, 30 do
			local best, bestCost = nil, math.huge
			for _, n in ipairs(Config.Nodes) do
				if n.island == island and n.kind ~= "unlock" and Config.canBuy(s.data, n) then
					local c = Config.nodeCost(s.data, n)
					if c < bestCost then
						best, bestCost = n, c
					end
				end
			end
			if not best or not buyNode(s, best) then
				break
			end
			any = true
		end
	end
	if any then
		recompute(s)
	end
end

--------------------------------------------------------------------------------
-- Перерождения
--------------------------------------------------------------------------------
local GAIN = { Z = Config.gainZ, S = Config.gainS, E = Config.gainE }

local function prestige(s: Session, layer: string)
	local d = s.data
	local fn = GAIN[layer]
	if not fn then
		return
	end
	local gain = fn(d)
	if gain < 1 then
		event(s, "message", "Пока слишком мало — копи дальше")
		return
	end
	local before = highestLayer(d)
	d.resets[layer] += 1
	add(s, layer, gain)
	Config.applyReset(d, layer)
	recompute(s)
	event(s, "prestige", layer, gain)
	if highestLayer(d) ~= before then
		event(s, "newLayer", layer)
	end
	updateTag(s)
	setLeaderstats(s)
	sendState(s)
	task.spawn(save, s.player)
end

for _, altar in ipairs(world.altars) do
	altar.prompt.Triggered:Connect(function(player)
		local s = sessions[player]
		if allow(s) then
			prestige(s :: Session, altar.layer)
		end
	end)
end

--------------------------------------------------------------------------------
-- Телепорт
--------------------------------------------------------------------------------
R.Teleport.OnServerEvent:Connect(function(player, id)
	local s = sessions[player]
	if not allow(s) or type(id) ~= "string" or not Config.IslandById[id] then
		return
	end
	if not Config.islandOpen((s :: Session).data, id) then
		return
	end
	local char = player.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		char:PivotTo(World.islandSpawn(id))
	end
end)

--------------------------------------------------------------------------------
-- Падающие звёзды
--------------------------------------------------------------------------------
local function nearestIsland(pos: Vector3): Config.Island
	local best, bd = Config.Islands[1], math.huge
	for _, isl in ipairs(Config.Islands) do
		local dist = (isl.center - pos).Magnitude
		if dist < bd then
			best, bd = isl, dist
		end
	end
	return best
end

local function spawnGolden(s: Session)
	local char = s.player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local isl = nearestIsland(root.Position)
	local a = math.random() * math.pi * 2
	local r = math.random(10, math.floor(isl.radius * 0.8))
	local pos = isl.center + Vector3.new(math.cos(a) * r, 2.5, math.sin(a) * r)
	s.golden = HttpService:GenerateGUID(false)
	s.goldenPos = pos
	s.goldenExpire = os.clock() + 25
	event(s, "goldenSpawn", s.golden, pos)
end

R.Claim.OnServerEvent:Connect(function(player, token)
	local s = sessions[player]
	if not allow(s) then
		return
	end
	local ses = s :: Session
	if not ses.golden or token ~= ses.golden or os.clock() > ses.goldenExpire or not ses.goldenPos then
		return
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or (root.Position - (ses.goldenPos :: Vector3)).Magnitude > 14 then
		return
	end
	ses.golden = nil
	ses.data.golden += 1
	local amount = ses.lps * Config.GOLDEN_SECONDS * Config.goldenMult(ses.data)
	add(ses, "L", amount)
	ses.nextGolden = os.clock() + math.random(Config.GOLDEN_MIN, Config.GOLDEN_MAX)
	event(ses, "golden", amount)
	sendState(ses)
end)

--------------------------------------------------------------------------------
-- Главный цикл
--------------------------------------------------------------------------------
local TICK = 0.2
local stateTimer, slowTimer = 0, 0
task.spawn(function()
	while true do
		local dt = task.wait(TICK)
		stateTimer += dt
		slowTimer += dt
		local now = os.clock()
		for _, s in pairs(sessions) do
			if s.ready then
				local d = s.data
				d.playTime += dt
				recompute(s) -- 💡/с зависит от текущих 💡, 🌅 и ✦
				add(s, "L", s.lps * dt)
				local pz = Config.passiveZ(d)
				if pz > 0 then
					add(s, "Z", pz * Config.gainZ(d) * dt)
				end
				local psv = Config.passiveS(d)
				if psv > 0 then
					add(s, "S", psv * Config.gainS(d) * dt)
				end
				s.autoTimer += dt
				if s.autoTimer >= 0.5 then
					s.autoTimer = 0
					autobuy(s)
				end
				if s.golden and now > s.goldenExpire then
					s.golden = nil
					s.nextGolden = now + math.random(Config.GOLDEN_MIN, Config.GOLDEN_MAX)
					event(s, "goldenGone")
				elseif not s.golden and now >= s.nextGolden then
					spawnGolden(s)
				end
			end
		end
		if stateTimer >= 0.25 then
			stateTimer = 0
			for _, s in pairs(sessions) do
				if s.ready then
					sendState(s)
				end
			end
		end
		if slowTimer >= 60 then
			slowTimer = 0
			for player, s in pairs(sessions) do
				setLeaderstats(s)
				task.spawn(save, player)
			end
			task.spawn(refreshLeaderboard)
		end
	end
end)
task.delay(5, refreshLeaderboard)
task.spawn(function()
	while true do
		task.wait(3)
		for _, s in pairs(sessions) do
			if s.ready then
				setLeaderstats(s)
			end
		end
	end
end)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000006"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- Общий мир: парящие острова, плитки дерева, связи, алтари, табло.
-- Состояние плиток (куплено/доступно/цена) каждый клиент раскрашивает сам.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))

local World = {}

local function A(x: number, y: number, z: number): CFrame
	return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z))
end

local function part(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

local function disc(parent: Instance, pos: Vector3, height: number, diameter: number, props: { [string]: any }): Part
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(height, diameter, diameter)
	props.CFrame = CFrame.new(pos) * A(0, 0, 90)
	return part(parent, props)
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.4
	for k, v in pairs(props) do
		(t :: any)[k] = v
	end
	t.Parent = parent
	return t
end

--------------------------------------------------------------------------------
-- Остров
--------------------------------------------------------------------------------
local TOP_MAT = { Enum.Material.Grass, Enum.Material.Sand, Enum.Material.Slate, Enum.Material.Basalt }
local TOP_COLOR = {
	Color3.fromRGB(84, 130, 72),
	Color3.fromRGB(205, 140, 110),
	Color3.fromRGB(70, 68, 110),
	Color3.fromRGB(35, 34, 44),
}

local function buildIsland(isl: Config.Island, root: Instance): Model
	local m = Instance.new("Model")
	m.Name = "Island_" .. isl.id
	local c = isl.center
	local R = isl.radius
	-- Верх
	disc(m, c + Vector3.new(0, -1, 0), 2, R * 2, { Name = "Top", Color = TOP_COLOR[isl.index], Material = TOP_MAT[isl.index] })
	disc(m, c + Vector3.new(0, -3.2, 0), 2.6, R * 2 + 1.5, { Name = "Edge", Color = Color3.fromRGB(110, 92, 75), Material = Enum.Material.Ground })
	disc(m, c + Vector3.new(0, -0.05, 0), 0.25, R * 2 + 2.2, { Name = "Rim", Color = isl.color, Material = Enum.Material.Neon, Transparency = 0.35, CanCollide = false })
	-- Скала снизу: сужающиеся слои
	local rng = Random.new(isl.index * 31)
	local y = -4.5
	local r = R * 0.98
	local rockColor = Color3.fromRGB(95, 85, 80):Lerp(isl.dark, 0.35)
	for i = 1, 7 do
		local h = 5 + i * 1.5
		disc(m, c + Vector3.new(rng:NextNumber(-3, 3), y - h / 2, rng:NextNumber(-3, 3)), h, r * 2, { Name = "Rock", Color = rockColor:Lerp(Color3.new(0, 0, 0), i * 0.06), Material = Enum.Material.Rock, CastShadow = false })
		y -= h * 0.8
		r *= 0.72
	end
	-- Каменные выступы по краю
	for i = 1, 14 do
		local a = i / 14 * math.pi * 2 + rng:NextNumber(-0.1, 0.1)
		local s = rng:NextNumber(6, 13)
		part(m, {
			Name = "Crag",
			Size = Vector3.new(s, s * 1.6, s),
			CFrame = CFrame.new(c + Vector3.new(math.cos(a) * (R - s * 0.3), -s * 0.9, math.sin(a) * (R - s * 0.3))) * A(rng:NextNumber(-20, 20), rng:NextNumber(0, 90), rng:NextNumber(150, 210)),
			Color = rockColor,
			Material = Enum.Material.Rock,
			CastShadow = false,
		})
	end
	-- Висящие кристаллы-огоньки снизу
	for i = 1, 6 do
		local a = rng:NextNumber(0, math.pi * 2)
		local rr = rng:NextNumber(5, R * 0.5)
		local cr = part(m, {
			Name = "Hanging",
			Size = Vector3.new(1.4, rng:NextNumber(3, 6), 1.4),
			CFrame = CFrame.new(c + Vector3.new(math.cos(a) * rr, -18 - rng:NextNumber(0, 10), math.sin(a) * rr)) * A(0, 45, 0),
			Color = isl.color,
			Material = Enum.Material.Neon,
			CanCollide = false,
			CastShadow = false,
		})
		local l = Instance.new("PointLight")
		l.Color = isl.color
		l.Range = 14
		l.Brightness = 1
		l.Parent = cr
	end
	-- Фонарики по краю
	for i = 1, 16 do
		local a = (i + 0.5) / 16 * math.pi * 2
		local pos = c + Vector3.new(math.cos(a) * (R - 3), 0, math.sin(a) * (R - 3))
		part(m, { Name = "Post", Size = Vector3.new(0.4, 4, 0.4), CFrame = CFrame.new(pos + Vector3.new(0, 2, 0)), Color = Color3.fromRGB(45, 42, 50), Material = Enum.Material.Metal })
		local b = part(m, {
			Name = "PostLamp",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1, 1, 1),
			CFrame = CFrame.new(pos + Vector3.new(0, 4.3, 0)),
			Color = isl.color,
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
		if i % 2 == 0 then
			local l = Instance.new("PointLight")
			l.Color = isl.color
			l.Range = 16
			l.Brightness = 0.8
			l.Parent = b
		end
	end
	-- Название острова
	local sign = part(m, { Name = "Sign", Size = Vector3.new(1, 1, 1), Transparency = 1, CanCollide = false, CFrame = CFrame.new(c + Vector3.new(0, 40, 0)) })
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(40, 0, 8, 0)
	bb.LightInfluence = 0
	bb.MaxDistance = 1000
	bb.Parent = sign
	text(bb, { Size = UDim2.fromScale(1, 1), Text = isl.icon .. " " .. string.upper(isl.name), TextColor3 = isl.color })
	m.Parent = root
	return m
end

--------------------------------------------------------------------------------
-- Плитки дерева и связи
--------------------------------------------------------------------------------
local function buildTree(root: Instance)
	local tiles = Instance.new("Folder")
	tiles.Name = "Tiles"
	local links = Instance.new("Folder")
	links.Name = "Links"
	for _, n in ipairs(Config.Nodes) do
		local pos = Config.nodePosition(n)
		local tile = part(tiles, {
			Name = "Tile_" .. n.id,
			Size = Vector3.new(Config.TILE_SIZE, 0.8, Config.TILE_SIZE),
			CFrame = CFrame.new(pos + Vector3.new(0, 0.4, 0)),
			Color = Color3.fromRGB(60, 60, 70),
			Material = Enum.Material.SmoothPlastic,
		})
		tile:SetAttribute("Node", n.id)
		-- Неоновая окантовка (её цвет меняет клиент)
		local border = part(tile, {
			Name = "Border",
			Size = Vector3.new(Config.TILE_SIZE + 0.6, 0.6, Config.TILE_SIZE + 0.6),
			CFrame = CFrame.new(pos + Vector3.new(0, 0.3, 0)),
			Color = Color3.fromRGB(80, 80, 90),
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
		border.CastShadow = false
		-- Карточка над плиткой (размер в метрах, как вывеска)
		local bb = Instance.new("BillboardGui")
		bb.Name = "Card"
		bb.Size = UDim2.new(8, 0, 5.2, 0)
		bb.StudsOffsetWorldSpace = Vector3.new(0, 4.2, 0)
		bb.LightInfluence = 0
		bb.MaxDistance = 140
		bb.Adornee = tile
		bb.Parent = tile
		local card = Instance.new("Frame")
		card.Name = "Bg"
		card.Size = UDim2.fromScale(1, 1)
		card.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
		card.BackgroundTransparency = 0.15
		card.Parent = bb
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.12, 0)
		corner.Parent = card
		local stroke = Instance.new("UIStroke")
		stroke.Name = "Stroke"
		stroke.Thickness = 3
		stroke.Color = Color3.fromRGB(90, 90, 100)
		stroke.Parent = card
		text(card, { Name = "Icon", Size = UDim2.fromScale(0.3, 0.42), Position = UDim2.fromScale(0.03, 0.05), Text = n.icon })
		text(card, { Name = "Title", Size = UDim2.fromScale(0.64, 0.24), Position = UDim2.fromScale(0.34, 0.06), Text = n.name, TextXAlignment = Enum.TextXAlignment.Left })
		text(card, { Name = "Level", Size = UDim2.fromScale(0.64, 0.18), Position = UDim2.fromScale(0.34, 0.3), Text = "", Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(190, 190, 210) })
		text(card, { Name = "Desc", Size = UDim2.fromScale(0.94, 0.2), Position = UDim2.fromScale(0.03, 0.5), Text = n.desc, Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(220, 220, 235) })
		text(card, { Name = "Cost", Size = UDim2.fromScale(0.94, 0.24), Position = UDim2.fromScale(0.03, 0.72), Text = "" })

		-- Связи с родителями
		for _, pid in ipairs(n.parents) do
			local p = Config.NodeById[pid]
			local a = Config.nodePosition(p)
			local b = pos
			local mid = (a + b) / 2
			local len = (b - a).Magnitude - Config.TILE_SIZE
			if len > 0.5 then
				local link = part(links, {
					Name = "Link_" .. pid .. "_" .. n.id,
					Size = Vector3.new(1.2, 0.3, len),
					CFrame = CFrame.lookAt(mid + Vector3.new(0, 0.15, 0), b + Vector3.new(0, 0.15, 0)),
					Color = Color3.fromRGB(70, 70, 80),
					Material = Enum.Material.Neon,
					CanCollide = false,
				})
				link.CastShadow = false
				link:SetAttribute("From", pid)
				link:SetAttribute("To", n.id)
			end
		end
	end
	tiles.Parent = root
	links.Parent = root
end

--------------------------------------------------------------------------------
-- Алтари перерождения
--------------------------------------------------------------------------------
export type Altar = { layer: string, part: BasePart, prompt: ProximityPrompt }

local ALTARS = {
	{ on = "L", layer = "Z" },
	{ on = "Z", layer = "S" },
	{ on = "S", layer = "E" },
}

local function maxZ(island: string): number
	local m = 0
	for _, n in ipairs(Config.Nodes) do
		if n.island == island then
			m = math.max(m, n.z)
		end
	end
	return m
end

local function buildAltars(root: Instance): { Altar }
	local list = {}
	for _, a in ipairs(ALTARS) do
		local isl = Config.IslandById[a.on]
		local target = Config.IslandById[a.layer]
		-- справа от последнего ряда дерева
		local z = isl.radius * -0.55 + (maxZ(a.on) - 1) * Config.TILE_STEP
		local pos = isl.center + Vector3.new(3.2 * Config.TILE_STEP, 0, z)
		local m = Instance.new("Model")
		m.Name = "Altar_" .. a.layer
		disc(m, pos + Vector3.new(0, 0.5, 0), 1, 12, { Color = Color3.fromRGB(50, 48, 60), Material = Enum.Material.Marble })
		disc(m, pos + Vector3.new(0, 1.05, 0), 0.2, 10, { Name = "Glow", Color = target.color, Material = Enum.Material.Neon, CanCollide = false })
		local orb = part(m, {
			Name = "Orb",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(3, 3, 3),
			CFrame = CFrame.new(pos + Vector3.new(0, 5, 0)),
			Color = target.color,
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
		local l = Instance.new("PointLight")
		l.Color = target.color
		l.Range = 20
		l.Brightness = 2
		l.Parent = orb
		local bb = Instance.new("BillboardGui")
		bb.Name = "Info"
		bb.Size = UDim2.new(14, 0, 4.5, 0)
		bb.StudsOffsetWorldSpace = Vector3.new(0, 4.5, 0)
		bb.LightInfluence = 0
		bb.MaxDistance = 160
		bb.Parent = orb
		text(bb, { Name = "Title", Size = UDim2.fromScale(1, 0.5), Text = target.icon .. " " .. target.name, TextColor3 = target.color })
		text(bb, { Name = "Sub", Size = UDim2.fromScale(1, 0.4), Position = UDim2.fromScale(0, 0.55), Text = "", Font = Enum.Font.GothamBold })
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Переродиться"
		prompt.ObjectText = target.name
		prompt.HoldDuration = 1
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = orb
		m.Parent = root
		table.insert(list, { layer = a.layer, part = orb, prompt = prompt })
	end
	return list
end

--------------------------------------------------------------------------------
-- Облака и табло
--------------------------------------------------------------------------------
local function buildClouds(root: Instance)
	local f = Instance.new("Folder")
	f.Name = "Clouds"
	local rng = Random.new(5)
	for _ = 1, 45 do
		local center = Vector3.new(rng:NextNumber(-500, 300), rng:NextNumber(-90, -40), rng:NextNumber(-500, 250))
		for _ = 1, rng:NextInteger(3, 6) do
			local s = rng:NextNumber(18, 40)
			part(f, {
				Name = "Cloud",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(s, s, s),
				CFrame = CFrame.new(center + Vector3.new(rng:NextNumber(-25, 25), rng:NextNumber(-5, 5), rng:NextNumber(-25, 25))),
				Color = Color3.fromRGB(200, 195, 230),
				Material = Enum.Material.SmoothPlastic,
				Transparency = 0.35,
				CanCollide = false,
				CastShadow = false,
			})
		end
	end
	f.Parent = root
end

local leaderRows: { TextLabel } = {}

local function buildBoard(root: Instance)
	local isl = Config.Islands[1]
	local pos = isl.center + Vector3.new(44, 10, -30)
	local board = part(root, {
		Name = "Leaderboard",
		Size = Vector3.new(20, 17, 0.8),
		CFrame = CFrame.lookAt(pos, isl.center + Vector3.new(0, 10, -20)),
		Color = Color3.fromRGB(20, 20, 28),
	})
	part(root, { Size = Vector3.new(0.8, 10, 0.8), CFrame = CFrame.new(pos + Vector3.new(0, -9, 0)), Color = Color3.fromRGB(45, 42, 50), Material = Enum.Material.Metal })
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 36
	sg.LightInfluence = 0
	sg.Parent = board
	text(sg, { Size = UDim2.new(1, 0, 0, 80), Text = "🏆 Самый яркий свет", TextColor3 = Color3.fromRGB(255, 215, 110) })
	for i = 1, 10 do
		leaderRows[i] = text(sg, { Size = UDim2.new(1, -40, 0, 46), Position = UDim2.fromOffset(20, 84 + (i - 1) * 52), Text = "", TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold })
	end
	leaderRows[1].Text = "Загрузка…"
end

function World.setLeaderboard(rows: { { name: string, value: number } })
	for i = 1, 10 do
		local r = rows[i]
		if r then
			local medal = i == 1 and "🥇" or i == 2 and "🥈" or i == 3 and "🥉" or (i .. ".")
			leaderRows[i].Text = string.format("%s %s — 💡 %s", medal, r.name, Config.format(r.value))
		else
			leaderRows[i].Text = i == 1 and "Пока пусто — стань первым!" or ""
		end
	end
end

--------------------------------------------------------------------------------
-- Маяк (основание; этажи надстраивает клиент)
--------------------------------------------------------------------------------
World.LIGHTHOUSE_POS = Config.Islands[1].center + Config.LIGHTHOUSE_POS

local function buildLighthouseBase(root: Instance)
	local p = World.LIGHTHOUSE_POS
	local m = Instance.new("Model")
	m.Name = "LighthouseBase"
	disc(m, p + Vector3.new(0, 0.4, 0), 0.8, 20, { Color = Color3.fromRGB(150, 140, 130), Material = Enum.Material.Cobblestone })
	disc(m, p + Vector3.new(0, 3, 0), 5, 12, { Color = Color3.fromRGB(235, 232, 222), Material = Enum.Material.Plaster })
	part(m, { Name = "Door", Size = Vector3.new(0.6, 4, 2.6), CFrame = CFrame.new(p + Vector3.new(6, 2.4, 0)), Color = Color3.fromRGB(110, 70, 45), Material = Enum.Material.WoodPlanks })
	m.Parent = root
end

--------------------------------------------------------------------------------
function World.build(): { altars: { Altar }, spawnCFrame: CFrame }
	Lighting.ClockTime = 20.6
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(70, 65, 95)
	Lighting.OutdoorAmbient = Color3.fromRGB(110, 100, 140)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GeographicLatitude = 30
	local atmo = Instance.new("Atmosphere")
	atmo.Density = 0.32
	atmo.Offset = 0.15
	atmo.Color = Color3.fromRGB(170, 140, 200)
	atmo.Decay = Color3.fromRGB(90, 70, 140)
	atmo.Glare = 0.4
	atmo.Haze = 1.4
	atmo.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.7
	bloom.Size = 24
	bloom.Threshold = 1.2
	bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.12
	cc.Contrast = 0.08
	cc.TintColor = Color3.fromRGB(255, 245, 240)
	cc.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting

	local root = Instance.new("Folder")
	root.Name = "World"
	for _, isl in ipairs(Config.Islands) do
		buildIsland(isl, root)
	end
	buildTree(root)
	local altars = buildAltars(root)
	buildClouds(root)
	buildBoard(root)
	buildLighthouseBase(root)

	local c = Config.Islands[1].center
	local spawnPos = c + Vector3.new(0, 0.5, Config.Islands[1].radius * -0.55 - 14)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 0.4, 8)
	spawn.CFrame = CFrame.new(spawnPos)
	spawn.Color = Config.Islands[1].color
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.3
	spawn.Duration = 0
	spawn.Parent = root
	root.Parent = workspace
	return { altars = altars, spawnCFrame = CFrame.lookAt(spawnPos + Vector3.new(0, 3, 0), c + Vector3.new(0, 3, 30)) }
end

-- Точка прибытия на остров (перед корнем дерева)
function World.islandSpawn(id: string): CFrame
	local isl = Config.IslandById[id]
	local pos = isl.center + Vector3.new(0, 3.5, isl.radius * -0.55 - 12)
	return CFrame.lookAt(pos, isl.center + Vector3.new(0, 3.5, 30))
end

return World
