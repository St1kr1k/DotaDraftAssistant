local Moves = {
	Dodge = { Key = Enum.KeyCode.Q, Cooldown = 2, Name = "Dodge", Icon = "💨" },
	CloneCombo = { Key = Enum.KeyCode.One, Cooldown = 8, Name = "Clone Combo", Icon = "👥", Damage = { 6, 6, 6, 6, 22 } },
	Super = { Key = Enum.KeyCode.G, Cooldown = 20, Name = "Super: Heel Drop", Icon = "⚡", Damage = { 5, 5, 5, 5, 30 } },
}
Moves.Order = { "CloneCombo", "Super", "Dodge" }
Moves.Range = 30 -- на каком расстоянии ищем цель
return Moves
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- Сетевые события. Сервер создаёт, клиент ждёт.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}
local NAMES = {
	"Action", -- клиент -> сервер: (имя приёма, параметры)
	"Play", -- сервер -> все: (модель, клип, скорость)
	"Stop", -- сервер -> все: (модель)
	"Fx", -- сервер -> все: (эффект, ...)
	"Cine", -- сервер -> игроку: (сцена камеры, ...)
	"Cooldown", -- сервер -> игроку: (приём, секунды)
}

function Net.Init()
	assert(RunService:IsServer())
	local f = Instance.new("Folder")
	f.Name = "Net"
	for _, n in ipairs(NAMES) do
		local e = Instance.new("RemoteEvent")
		e.Name = n
		e.Parent = f
	end
	f.Parent = ReplicatedStorage
end

function Net.Get(name: string): RemoteEvent
	return ReplicatedStorage:WaitForChild("Net"):WaitForChild(name) :: RemoteEvent
end

return Net
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000010"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000009"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[-- Приёмы на сервере: цель, двойники, перемещения, урон. Анимации и эффекты играют клиенты по командам отсюда.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Moves = require(Shared.Moves)
local Clips = require(Shared.Clips)

local Combat = {}

local cooldowns = {} :: { [Player]: { [string]: number } }
local busy = {} :: { [Model]: boolean }
local clonesFolder: Folder

local function clipLen(name: string): number
	return Clips[name].Length
end

local function marker(clip: string, name: string): number
	for _, m in ipairs(Clips[clip].Markers) do
		if m.name == name then
			return m.t
		end
	end
	return 0
end

local function play(model: Model, clip: string, speed: number?)
	Net.Get("Play"):FireAllClients(model, clip, speed or 1)
end

local function stopAnim(model: Model)
	Net.Get("Stop"):FireAllClients(model)
end

local function fx(name: string, ...)
	Net.Get("Fx"):FireAllClients(name, ...)
end

local function root(model: Model): BasePart?
	return model and model:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function alive(model: Model?): boolean
	local hum = model and model:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0 and model.Parent ~= nil
end

local function groundY(pos: Vector3, ignore: { Instance }): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(pos + Vector3.new(0, 5, 0), Vector3.new(0, -200, 0), params)
	return hit and hit.Position.Y or 0
end

local function hipOffset(model: Model): number
	local hum = model:FindFirstChildOfClass("Humanoid")
	local hrp = root(model)
	if hum and hrp then
		return hum.HipHeight + hrp.Size.Y / 2
	end
	return 3
end

-- Заморозить модель (якорь), чтобы сервер двигал её сам
local function lock(model: Model, on: boolean)
	local hrp = root(model)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hrp then
		hrp.Anchored = on
	end
	if hum then
		hum.AutoRotate = not on
	end
	model:SetAttribute("Locked", on)
end

local function moveTo(model: Model, cf: CFrame, time: number, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local hrp = root(model)
	if not hrp then
		return
	end
	if time <= 0 then
		hrp.CFrame = cf
		return
	end
	TweenService:Create(hrp, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), { CFrame = cf }):Play()
end

local function damage(model: Model, amount: number, by: Model?)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 then
		hum:TakeDamage(amount)
		local hrp = root(model)
		if hrp then
			fx("Damage", hrp.Position + Vector3.new(0, 3, 0), amount)
		end
		if by then
			local attacker = Players:GetPlayerFromCharacter(by)
			if attacker then
				Net.Get("Fx"):FireClient(attacker, "Combo", 1)
			end
		end
	end
end

-- Ближайшая цель впереди
local function findTarget(attacker: Model): Model?
	local hrp = root(attacker)
	if not hrp then
		return nil
	end
	local best, bestScore = nil, math.huge
	local candidates = CollectionService:GetTagged("Fighter")
	for _, m in ipairs(candidates) do
		if m ~= attacker and alive(m) and not busy[m] and not CollectionService:HasTag(m, "Clone") then
			local r = root(m)
			if r then
				local d = r.Position - hrp.Position
				local dist = d.Magnitude
				if dist <= Moves.Range then
					local facing = hrp.CFrame.LookVector:Dot(d.Unit)
					local score = dist - facing * 8
					if score < bestScore then
						best, bestScore = m, score
					end
				end
			end
		end
	end
	return best
end

-- Двойник: копия внешности бойца
local function makeClone(char: Model, cf: CFrame): Model
	char.Archivable = true
	local c = char:Clone()
	char.Archivable = false
	c.Name = "ShadowClone"
	for _, d in ipairs(c:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") or d:IsA("Sound") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	local hum = c:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	end
	local hrp = c:FindFirstChild("HumanoidRootPart") :: BasePart
	hrp.Anchored = true
	c:PivotTo(cf)
	CollectionService:AddTag(c, "Clone")
	c.Parent = clonesFolder
	return c
end

local function poof(c: Model)
	local hrp = root(c)
	if hrp then
		fx("Smoke", hrp.Position, 1)
	end
	task.delay(0.08, function()
		c:Destroy()
	end)
end

local function faceTo(model: Model, target: Vector3)
	local hrp = root(model)
	if hrp then
		local p = hrp.Position
		local flat = Vector3.new(target.X, p.Y, target.Z)
		if (flat - p).Magnitude > 0.1 then
			hrp.CFrame = CFrame.lookAt(p, flat)
		end
	end
end

-- ===================== Уклонение =====================
local function dodge(player: Player, char: Model, dir: Vector3?)
	local hrp = root(char)
	if not hrp then
		return
	end
	local d = (typeof(dir) == "Vector3" and dir.Magnitude > 0.1) and Vector3.new(dir.X, 0, dir.Z).Unit or -hrp.CFrame.LookVector
	busy[char] = true
	lock(char, true)
	play(char, "Dodge")
	task.wait(marker("Dodge", "vanish"))
	fx("Vanish", char, true)
	fx("Dust", hrp.Position - Vector3.new(0, hipOffset(char) - 0.5, 0), 1)
	local target = hrp.Position + d * 8
	moveTo(char, CFrame.lookAt(target, target + hrp.CFrame.LookVector), 0)
	task.wait(marker("Dodge", "appear") - marker("Dodge", "vanish"))
	fx("Vanish", char, false)
	fx("Afterimage", char)
	fx("Dust", target - Vector3.new(0, hipOffset(char) - 0.5, 0), 1.2)
	task.wait(clipLen("Dodge") - marker("Dodge", "appear"))
	lock(char, false)
	busy[char] = nil
	stopAnim(char)
end

-- ===================== Комбо двойников =====================
local function cloneCombo(player: Player, char: Model, target: Model)
	local hrp, thrp = root(char), root(target)
	if not hrp or not thrp then
		return
	end
	busy[char], busy[target] = true, true
	lock(char, true)
	lock(target, true)
	faceTo(char, thrp.Position)
	faceTo(target, hrp.Position)
	local dmg = Moves.CloneCombo.Damage
	fx("Aura", char, true)
	play(char, "HandSeal", 1.4)
	task.wait(0.15)
	fx("ChakraBurst", hrp.Position + hrp.CFrame.LookVector * 1.5 + Vector3.new(0, 1, 0), 0.8)
	task.wait(0.25)
	-- два двойника у врага
	local tpos = thrp.Position
	local toAttacker = (hrp.Position - tpos) * Vector3.new(1, 0, 1)
	toAttacker = toAttacker.Magnitude > 0.1 and toAttacker.Unit or Vector3.new(0, 0, 1)
	local side = toAttacker:Cross(Vector3.yAxis).Unit
	local spots = { tpos + toAttacker * 3 + side * 2.6, tpos + toAttacker * 3 - side * 2.6 }
	local clones = {}
	for i, p in ipairs(spots) do
		local c = makeClone(char, CFrame.lookAt(p, Vector3.new(tpos.X, p.Y, tpos.Z)))
		fx("Smoke", p, 1)
		fx("Trails", c, true)
		play(c, "FightIdle")
		clones[i] = c
	end
	task.wait(0.2)
	local sequence = {
		{ clones[1], "CloneRushPunch" },
		{ clones[2], "CloneSpinKick" },
		{ clones[1], "CloneSweep" },
		{ clones[2], "CloneRushPunch" },
	}
	for i, step in ipairs(sequence) do
		local c, clip = step[1], step[2]
		local cr = root(c)
		if not alive(target) or not cr then
			break
		end
		-- двойник подскакивает вплотную
		local flatDir = (cr.Position - thrp.Position) * Vector3.new(1, 0, 1)
		flatDir = flatDir.Magnitude > 0.1 and flatDir.Unit or toAttacker
		local close = thrp.Position + flatDir * 2.6
		moveTo(c, CFrame.lookAt(close, Vector3.new(thrp.Position.X, close.Y, thrp.Position.Z)), 0.08)
		play(c, clip)
		task.wait(marker(clip, "hit"))
		local hitDir = (thrp.Position - cr.Position).Unit
		fx("Impact", thrp.Position + Vector3.new(0, 1, 0) - hitDir, hitDir, 1.1)
		fx("HitStop", c, target, 0.06)
		play(target, "Hurt")
		damage(target, dmg[i], char)
		moveTo(target, thrp.CFrame + hitDir * 0.6, 0.1)
		task.wait(math.max(0.05, clipLen(clip) - marker(clip, "hit") - 0.12))
	end
	-- добивание: рывок и удар, отбрасывающий врага
	if alive(target) then
		local dirIn = (thrp.Position - hrp.Position) * Vector3.new(1, 0, 1)
		dirIn = dirIn.Magnitude > 0.1 and dirIn.Unit or hrp.CFrame.LookVector
		local strikePos = thrp.Position - dirIn * 3.2
		strikePos = Vector3.new(strikePos.X, hrp.Position.Y, strikePos.Z)
		fx("Afterimage", char)
		fx("Trails", char, true)
		moveTo(char, CFrame.lookAt(strikePos, strikePos + dirIn), 0.12, Enum.EasingStyle.Quint)
		play(char, "FinisherPunch")
		for _, c in ipairs(clones) do
			poof(c)
		end
		task.wait(marker("FinisherPunch", "charge"))
		fx("ChakraBurst", strikePos + dirIn * 1.2 + Vector3.new(0, 1, 0), 0.6)
		task.wait(marker("FinisherPunch", "hit") - marker("FinisherPunch", "charge"))
		fx("Impact", thrp.Position + Vector3.new(0, 1, 0) - dirIn, dirIn, 2.6)
		fx("HitStop", char, target, 0.12)
		fx("Flash", 0.25)
		damage(target, dmg[5], char)
		play(target, "KnockBack")
		local back = thrp.Position + dirIn * 26
		back = Vector3.new(back.X, groundY(back, { target, char }) + hipOffset(target), back.Z)
		moveTo(target, CFrame.lookAt(back, back - dirIn), 0.55, Enum.EasingStyle.Quart)
		fx("DustTrail", target, 0.55)
		task.wait(clipLen("FinisherPunch") - marker("FinisherPunch", "hit"))
	end
	for _, c in ipairs(clones) do
		if c.Parent then
			poof(c)
		end
	end
	fx("Aura", char, false)
	fx("Trails", char, false)
	lock(char, false)
	busy[char] = nil
	stopAnim(char)
	task.wait(0.4)
	if target.Parent then
		play(target, "GetUp")
		task.wait(clipLen("GetUp"))
		lock(target, false)
		stopAnim(target)
	end
	busy[target] = nil
end

-- ===================== Суперудар: знак -> 4 подката -> удар пяткой =====================
local function super(player: Player, char: Model, target: Model)
	local hrp, thrp = root(char), root(target)
	if not hrp or not thrp then
		return
	end
	busy[char], busy[target] = true, true
	lock(char, true)
	lock(target, true)
	faceTo(char, thrp.Position)
	faceTo(target, hrp.Position)
	local dmg = Moves.Super.Damage
	Net.Get("Cine"):FireClient(player, "Super", char, target)
	-- 1) знак руками
	play(char, "HandSeal")
	task.wait(marker("HandSeal", "seal"))
	fx("Aura", char, true)
	fx("ChakraBurst", hrp.Position + hrp.CFrame.LookVector * 1.4 + Vector3.new(0, 1.2, 0), 1.2)
	fx("Flash", 0.2)
	task.wait(clipLen("HandSeal") - marker("HandSeal", "seal"))

	-- 2) четыре двойника по очереди подкатываются и бьют вверх
	local base = thrp.Position
	local floor = groundY(base, { target, char })
	local hip = hipOffset(target)
	local toAttacker = (hrp.Position - base) * Vector3.new(1, 0, 1)
	toAttacker = toAttacker.Magnitude > 0.1 and toAttacker.Unit or Vector3.new(0, 0, 1)
	local height = 0
	for i = 1, 4 do
		if not alive(target) then
			break
		end
		local a = math.rad(i * 90 + 45)
		local out = CFrame.Angles(0, a, 0):VectorToWorldSpace(toAttacker)
		local startPos = Vector3.new(base.X, floor + hipOffset(char), base.Z) + out * 9
		local c = makeClone(char, CFrame.lookAt(startPos, Vector3.new(base.X, startPos.Y, base.Z)))
		fx("Smoke", startPos, 0.9)
		fx("Trails", c, true)
		play(c, "CloneKickUp")
		-- подкат под врага (тело низко над землёй — смещение в клипе)
		local under = Vector3.new(base.X, startPos.Y, base.Z) + out * 1.6
		moveTo(c, CFrame.lookAt(under, Vector3.new(base.X, under.Y, base.Z) - out * 5), 0.2, Enum.EasingStyle.Quad)
		fx("DustTrail", c, 0.2)
		task.wait(marker("CloneKickUp", "hit"))
		-- удар вверх
		height += 4.5
		local up = Vector3.new(base.X, floor + hip + height, base.Z)
		fx("Impact", thrp.Position, Vector3.yAxis, 1.3)
		fx("UpStreak", thrp.Position)
		fx("HitStop", c, target, 0.05)
		play(target, "Launched")
		damage(target, dmg[i], char)
		moveTo(target, CFrame.lookAt(up, up + toAttacker), 0.22, Enum.EasingStyle.Quart)
		local cc = c
		task.delay(0.35, function()
			poof(cc)
		end)
		task.wait(0.16)
	end

	-- 3) трамплин из двойника и удар пяткой
	if alive(target) then
		local boostPos = Vector3.new(base.X, floor + hipOffset(char), base.Z) + toAttacker * 5
		local boost = makeClone(char, CFrame.lookAt(boostPos, Vector3.new(base.X, boostPos.Y, base.Z)))
		fx("Smoke", boostPos, 1)
		play(boost, "CloneBoost")
		-- боец исчезает и появляется у спины двойника
		fx("Smoke", hrp.Position, 1)
		local onBack = boostPos + toAttacker * 1.8 + Vector3.new(0, 2.2, 0)
		moveTo(char, CFrame.lookAt(onBack, Vector3.new(base.X, onBack.Y, base.Z)), 0)
		fx("Trails", char, true)
		play(char, "HeelDrop")
		task.wait(marker("HeelDrop", "jump"))
		fx("Dust", boostPos, 1.4)
		poof(boost)
		-- прыжок над врагом
		local above = thrp.Position + Vector3.new(0, 6, 0) + toAttacker * 1.2
		moveTo(char, CFrame.lookAt(above, Vector3.new(base.X, above.Y, base.Z)), 0.48, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.wait(marker("HeelDrop", "hit") - marker("HeelDrop", "jump"))
		-- удар пяткой — враг летит в землю
		fx("Impact", thrp.Position + Vector3.new(0, 1.5, 0), -Vector3.yAxis, 2.8)
		fx("HitStop", char, target, 0.14)
		damage(target, dmg[5], char)
		local slamPos = Vector3.new(base.X, floor + 0.2, base.Z)
		play(target, "Slammed")
		moveTo(target, CFrame.lookAt(slamPos + Vector3.new(0, hip, 0), slamPos + Vector3.new(0, hip, 0) + toAttacker), 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(0.12)
		fx("Crater", slamPos, 10)
		-- приземление рядом с кратером
		local land = Vector3.new(base.X, floor + hipOffset(char), base.Z) + toAttacker * 5
		moveTo(char, CFrame.lookAt(land, Vector3.new(base.X, land.Y, base.Z)), marker("HeelDrop", "land") - marker("HeelDrop", "hit") - 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(marker("HeelDrop", "land") - marker("HeelDrop", "hit") - 0.12)
		fx("Dust", land - Vector3.new(0, hipOffset(char) - 0.5, 0), 1.5)
		task.wait(clipLen("HeelDrop") - marker("HeelDrop", "land"))
	end
	fx("Aura", char, false)
	fx("Trails", char, false)
	lock(char, false)
	busy[char] = nil
	stopAnim(char)
	task.wait(0.8)
	if target.Parent then
		play(target, "GetUp")
		task.wait(clipLen("GetUp"))
		lock(target, false)
		stopAnim(target)
	end
	busy[target] = nil
end

-- ===================== Манекены =====================
local dummySpots = { Vector3.new(-14, 0, 0), Vector3.new(0, 0, -6), Vector3.new(14, 0, 0) }

local function spawnDummy(pos: Vector3)
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = Color3.fromRGB(200, 180, 160)
	desc.TorsoColor = Color3.fromRGB(90, 70, 60)
	desc.LeftArmColor = desc.HeadColor
	desc.RightArmColor = desc.HeadColor
	desc.LeftLegColor = Color3.fromRGB(60, 50, 45)
	desc.RightLegColor = Color3.fromRGB(60, 50, 45)
	local ok, dummy = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not dummy then
		warn("[Combat] dummy: " .. tostring(dummy))
		return
	end
	dummy.Name = "Training Dummy"
	local hum = dummy:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.MaxHealth = 600
	hum.Health = 600
	hum.WalkSpeed = 0
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	dummy:PivotTo(CFrame.lookAt(pos + Vector3.new(0, 4, 0), Vector3.new(0, 4, 40)))
	dummy.Parent = workspace
	CollectionService:AddTag(dummy, "Fighter")
	CollectionService:AddTag(dummy, "Dummy")
	hum.Died:Connect(function()
		task.wait(3)
		dummy:Destroy()
		spawnDummy(pos)
	end)
	-- медленное восстановление здоровья
	task.spawn(function()
		while dummy.Parent do
			task.wait(1)
			if hum.Health > 0 and hum.Health < hum.MaxHealth and not busy[dummy] then
				hum.Health = math.min(hum.MaxHealth, hum.Health + 20)
			end
		end
	end)
end

-- ===================== Вход =====================
local ACTIONS = {
	Dodge = function(player, char, arg)
		dodge(player, char, arg)
	end,
	CloneCombo = function(player, char)
		local target = findTarget(char)
		if not target then
			Net.Get("Fx"):FireClient(player, "Toast", "No target in range")
			return false
		end
		cloneCombo(player, char, target)
	end,
	Super = function(player, char)
		local target = findTarget(char)
		if not target then
			Net.Get("Fx"):FireClient(player, "Toast", "No target in range")
			return false
		end
		super(player, char, target)
	end,
}

function Combat.Init()
	clonesFolder = Instance.new("Folder")
	clonesFolder.Name = "Clones"
	clonesFolder.Parent = workspace

	Players.PlayerAdded:Connect(function(player)
		cooldowns[player] = {}
		player.CharacterAdded:Connect(function(char)
			CollectionService:AddTag(char, "Fighter")
			busy[char] = nil
		end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		cooldowns[player] = nil
	end)

	Net.Get("Action").OnServerEvent:Connect(function(player, name, arg)
		local move = type(name) == "string" and Moves[name]
		local fn = type(name) == "string" and ACTIONS[name]
		local char = player.Character
		if not move or not fn or not char or not alive(char) or busy[char] then
			return
		end
		local cd = cooldowns[player] or {}
		cooldowns[player] = cd
		local now = os.clock()
		if (cd[name] or 0) > now then
			return
		end
		cd[name] = now + move.Cooldown
		Net.Get("Cooldown"):FireClient(player, name, move.Cooldown)
		task.spawn(function()
			local ok, res = pcall(fn, player, char, arg)
			if not ok then
				warn("[Combat] " .. name .. ": " .. tostring(res))
				lock(char, false)
				busy[char] = nil
				fx("Aura", char, false)
			elseif res == false then
				cd[name] = 0
				Net.Get("Cooldown"):FireClient(player, name, 0)
			end
		end)
	end)

	for _, p in ipairs(dummySpots) do
		task.spawn(spawnDummy, p)
	end
end

return Combat
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX00000007"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Точка входа сервера.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared").Net)
Net.Init()

local World = require(script.Parent.World)
local Combat = require(script.Parent.Combat)

World.Build()
Combat.Init()
workspace:SetAttribute("Ready", true)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- Арена: каменная площадка в долине на закате, скалы, деревья, разрушенные стены, манекены.

local Lighting = game:GetService("Lighting")

local World = {}
local rng = Random.new(42)

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function P(props: { [string]: any }): BasePart
	local p = Instance.new(props.Class or "Part") :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Class" and k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	p.Parent = props.Parent
	return p
end

local function lighting()
	Lighting.ClockTime = 17.3
	Lighting.Brightness = 2.4
	Lighting.Ambient = rgb(70, 60, 75)
	Lighting.OutdoorAmbient = rgb(150, 125, 130)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	local atm = Instance.new("Atmosphere")
	atm.Density = 0.35
	atm.Offset = 0.1
	atm.Color = rgb(255, 200, 165)
	atm.Decay = rgb(120, 90, 140)
	atm.Glare = 0.5
	atm.Haze = 1.8
	atm.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 28
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.15
	cc.Contrast = 0.1
	cc.TintColor = rgb(255, 240, 228)
	cc.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.1
	rays.Parent = Lighting
	local clouds = Instance.new("Clouds")
	clouds.Cover = 0.45
	clouds.Color = rgb(255, 210, 190)
	clouds.Parent = workspace.Terrain
end

local function terrain()
	local t = workspace.Terrain
	t:FillBlock(CFrame.new(0, -6, 0), Vector3.new(900, 12, 900), Enum.Material.Ground)
	t:SetMaterialColor(Enum.Material.Ground, rgb(125, 105, 85))
	t:SetMaterialColor(Enum.Material.Grass, rgb(105, 130, 70))
	t:SetMaterialColor(Enum.Material.Rock, rgb(120, 110, 105))
	t:FillBlock(CFrame.new(0, -0.5, 0), Vector3.new(900, 1, 900), Enum.Material.Grass)
	-- кольцо скал вокруг долины
	for i = 0, 35 do
		local a = i / 36 * math.pi * 2
		local r = rng:NextNumber(230, 280)
		local h = rng:NextNumber(40, 90)
		t:FillBall(Vector3.new(math.cos(a) * r, h * 0.3, math.sin(a) * r), rng:NextNumber(30, 55), Enum.Material.Rock)
		t:FillBlock(CFrame.new(math.cos(a) * (r + 30), h / 2, math.sin(a) * (r + 30)) * CFrame.Angles(0, a, 0), Vector3.new(60, h, 60), Enum.Material.Rock)
	end
end

local function rockCluster(parent: Instance, pos: Vector3, k: number)
	for _ = 1, 3 do
		local s = Vector3.new(rng:NextNumber(3, 7), rng:NextNumber(2, 5), rng:NextNumber(3, 7)) * k
		P({ Size = s, CFrame = CFrame.new(pos + Vector3.new(rng:NextNumber(-3, 3) * k, s.Y * 0.35, rng:NextNumber(-3, 3) * k)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)),
			Color = rgb(130, 120, 115):Lerp(rgb(160, 150, 140), rng:NextNumber()), Material = Enum.Material.Slate, Parent = parent })
	end
end

local function tree(parent: Instance, pos: Vector3, h: number)
	P({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 2, 2), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(95, 70, 50), Material = Enum.Material.Wood, Parent = parent })
	for i = 1, 4 do
		local s = rng:NextNumber(8, 12)
		P({ Shape = Enum.PartType.Ball, Size = Vector3.one * s, Position = pos + Vector3.new(rng:NextNumber(-3, 3), h + rng:NextNumber(-1, 3) + i * 0.5, rng:NextNumber(-3, 3)),
			Color = rgb(70, 115, 60):Lerp(rgb(110, 140, 70), rng:NextNumber()), Material = Enum.Material.Grass, Parent = parent })
	end
end

local function brokenWall(parent: Instance, cf: CFrame)
	local w = 24
	for i = 0, 5 do
		local h = rng:NextNumber(4, 12)
		P({ Size = Vector3.new(w / 6, h, 2), CFrame = cf * CFrame.new(-w / 2 + (i + 0.5) * w / 6, h / 2, 0), Color = rgb(175, 160, 140), Material = Enum.Material.Brick, Parent = parent })
	end
	for _ = 1, 5 do
		local s = rng:NextNumber(1.5, 3)
		P({ Size = Vector3.new(s, s * 0.6, s), CFrame = cf * CFrame.new(rng:NextNumber(-w / 2, w / 2), s * 0.3, rng:NextNumber(2, 6)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0.2),
			Color = rgb(165, 150, 130), Material = Enum.Material.Brick, Parent = parent })
	end
end

function World.Build()
	lighting()
	terrain()
	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace
	-- круглая каменная арена
	P({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 170, 170), CFrame = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(150, 140, 130), Material = Enum.Material.Cobblestone, Parent = map })
	P({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.1, 60, 60), CFrame = CFrame.new(0, 0.02, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(170, 158, 145), Material = Enum.Material.Slate, Parent = map })
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		local h = rng:NextNumber(3, 8)
		P({ Size = Vector3.new(3, h, 3), CFrame = CFrame.new(math.cos(a) * 87, h / 2, math.sin(a) * 87) * CFrame.Angles(0, a, rng:NextNumber(-0.1, 0.1)), Color = rgb(140, 130, 120), Material = Enum.Material.Slate, Parent = map })
	end
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2 + 0.3
		brokenWall(map, CFrame.lookAt(Vector3.new(math.cos(a) * 120, 0, math.sin(a) * 120), Vector3.zero))
		rockCluster(map, Vector3.new(math.cos(a + 0.5) * 105, 0, math.sin(a + 0.5) * 105), rng:NextNumber(1, 1.8))
	end
	for _ = 1, 40 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(135, 210)
		tree(map, Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), rng:NextNumber(14, 24))
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.CFrame = CFrame.new(0, 1, 40)
	spawn.Anchored = true
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = map
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
end

return World
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000012"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000011"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX0000000C"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX0000000A"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Клиент: управление, анимации всех бойцов, эффекты, HUD, кинокамера суперудара.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Moves = require(Shared.Moves)
local Anim = require(Shared.Anim)
local VFX = require(script.Parent.VFX)

local player = Players.LocalPlayer

while not workspace:GetAttribute("Ready") do
	task.wait(0.2)
end

-- ===================== HUD =====================
local gui = Instance.new("ScreenGui")
gui.Name = "BattleHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function label(props: { [string]: any }): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.LuckiestGuy
	t.TextScaled = true
	t.TextColor3 = Color3.new(1, 1, 1)
	for k, v in pairs(props) do
		if k ~= "Stroke" then
			(t :: any)[k] = v
		end
	end
	local s = Instance.new("UIStroke")
	s.Thickness = props.Stroke or 3
	s.Color = Color3.fromRGB(10, 10, 20)
	s.Parent = t
	return t
end

local bar = Instance.new("Frame")
bar.AnchorPoint = Vector2.new(0.5, 1)
bar.Position = UDim2.new(0.5, 0, 1, -24)
bar.Size = UDim2.fromOffset(3 * 96 + 2 * 12, 96)
bar.BackgroundTransparency = 1
bar.Parent = gui
local layout = Instance.new("UIListLayout")
layout.FillDirection = Enum.FillDirection.Horizontal
layout.Padding = UDim.new(0, 12)
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.Parent = bar

local slots = {} :: { [string]: { button: TextButton, shade: Frame, timer: TextLabel, ends: number, total: number } }

local function keyName(code: Enum.KeyCode): string
	local map = { [Enum.KeyCode.One] = "1", [Enum.KeyCode.Q] = "Q", [Enum.KeyCode.G] = "G" }
	return map[code] or code.Name
end

local fire -- объявлено ниже

for i, id in ipairs(Moves.Order) do
	local m = Moves[id]
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(96, 96)
	b.Text = ""
	b.AutoButtonColor = false
	b.BackgroundColor3 = id == "Super" and Color3.fromRGB(255, 170, 40) or Color3.fromRGB(40, 120, 230)
	b.LayoutOrder = i
	b.Parent = bar
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 16)
	c.Parent = b
	local st = Instance.new("UIStroke")
	st.Thickness = 3.5
	st.Color = Color3.fromRGB(10, 10, 20)
	st.Parent = b
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(160, 170, 200))
	g.Rotation = 90
	g.Parent = b
	label({ Text = m.Icon, Size = UDim2.new(1, -16, 0.55, 0), Position = UDim2.fromOffset(8, 6), Stroke = 0, Parent = b })
	label({ Text = m.Name, Size = UDim2.new(1, -8, 0.22, 0), Position = UDim2.new(0, 4, 0.62, 0), Font = Enum.Font.FredokaOne, Stroke = 2, Parent = b })
	label({ Text = keyName(m.Key), Size = UDim2.fromOffset(28, 28), Position = UDim2.fromOffset(-6, -10), TextColor3 = Color3.fromRGB(255, 230, 80), Parent = b })
	local shade = Instance.new("Frame")
	shade.BackgroundColor3 = Color3.new(0, 0, 0)
	shade.BackgroundTransparency = 0.35
	shade.AnchorPoint = Vector2.new(0, 1)
	shade.Position = UDim2.fromScale(0, 1)
	shade.Size = UDim2.fromScale(1, 0)
	shade.ZIndex = 3
	shade.Parent = b
	local sc = Instance.new("UICorner")
	sc.CornerRadius = UDim.new(0, 16)
	sc.Parent = shade
	local timer = label({ Text = "", Size = UDim2.fromScale(0.6, 0.4), Position = UDim2.fromScale(0.2, 0.3), ZIndex = 4, Parent = b })
	slots[id] = { button = b, shade = shade, timer = timer, ends = 0, total = 1 }
	b.Activated:Connect(function()
		fire(id)
	end)
end

local comboLabel = label({ Text = "", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -40, 0.4, 0), Size = UDim2.fromOffset(260, 90),
	TextColor3 = Color3.fromRGB(255, 220, 70), Rotation = -6, Stroke = 4, Parent = gui })
local combo, comboAt = 0, 0

local toastLabel = label({ Text = "", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -140), Size = UDim2.fromOffset(420, 40),
	Font = Enum.Font.FredokaOne, Parent = gui })

local function toast(text: string)
	toastLabel.Text = text
	toastLabel.TextTransparency = 0
	task.delay(1.6, function()
		if toastLabel.Text == text then
			TweenService:Create(toastLabel, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
		end
	end)
end

local hint = label({ Text = "1 — Clone Combo    G — Super    Q — Dodge", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14),
	Size = UDim2.fromOffset(520, 30), Font = Enum.Font.FredokaOne, Parent = gui })
task.delay(12, function()
	TweenService:Create(hint, TweenInfo.new(1), { TextTransparency = 1 }):Play()
end)

-- ===================== Действия =====================
fire = function(id: string)
	local char = player.Character
	if not char or char:GetAttribute("Locked") then
		return
	end
	local s = slots[id]
	if s and os.clock() < s.ends then
		return
	end
	local arg = nil
	if id == "Dodge" then
		local hum = char:FindFirstChildOfClass("Humanoid")
		arg = hum and hum.MoveDirection or nil
	end
	Net.Get("Action"):FireServer(id, arg)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	for id, m in pairs(Moves) do
		if type(m) == "table" and m.Key == input.KeyCode then
			fire(id)
		end
	end
end)

Net.Get("Cooldown").OnClientEvent:Connect(function(id, seconds)
	local s = slots[id]
	if not s then
		return
	end
	s.total = math.max(0.01, seconds)
	s.ends = os.clock() + seconds
end)

-- ===================== Анимации =====================
local ATTACK_CLIPS = { CloneRushPunch = true, CloneSpinKick = true, CloneSweep = true, FinisherPunch = true, CloneKickUp = true, HeelDrop = true }

Net.Get("Play").OnClientEvent:Connect(function(model, clip, speed)
	if typeof(model) == "Instance" and model:IsA("Model") then
		Anim.Play(model, clip, { speed = speed, blend = ATTACK_CLIPS[clip] and 0.05 or 0.1 })
	end
end)
Net.Get("Stop").OnClientEvent:Connect(function(model)
	if typeof(model) == "Instance" and model:IsA("Model") then
		Anim.Stop(model, 0.2)
	end
end)

-- Боевая стойка, когда боец стоит на месте
RunService.Heartbeat:Connect(function()
	for _, m in ipairs(CollectionService:GetTagged("Fighter")) do
		if m:IsA("Model") and not m:GetAttribute("Locked") and not CollectionService:HasTag(m, "Dummy") then
			local hrp = m:FindFirstChild("HumanoidRootPart") :: BasePart?
			local hum = m:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local cur = Anim.Current(m)
				local moving = (hrp.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude > 1.5 or hum.FloorMaterial == Enum.Material.Air
				if moving then
					if cur == "FightIdle" then
						Anim.Stop(m, 0.12)
					end
				elseif cur == nil then
					Anim.Play(m, "FightIdle", { blend = 0.25 })
				end
			end
		end
	end
end)

-- ===================== Эффекты =====================
local function damageNumber(pos: Vector3, amount: number)
	local a = Instance.new("Part")
	a.Anchored = true
	a.CanCollide = false
	a.CanQuery = false
	a.Transparency = 1
	a.Size = Vector3.one * 0.2
	a.Position = pos + Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1)
	a.Parent = workspace
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(120, 50)
	bb.AlwaysOnTop = true
	bb.Parent = a
	local t = label({ Text = tostring(math.floor(amount)), Size = UDim2.fromScale(1, 1), TextColor3 = amount >= 20 and Color3.fromRGB(255, 120, 60) or Color3.new(1, 1, 1), Parent = bb })
	local sc = Instance.new("UIScale")
	sc.Scale = 1.8
	sc.Parent = t
	TweenService:Create(sc, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	TweenService:Create(a, TweenInfo.new(0.8), { Position = a.Position + Vector3.new(0, 3, 0) }):Play()
	TweenService:Create(t, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
	game:GetService("Debris"):AddItem(a, 0.9)
end

local FX = {}
FX.Smoke = VFX.Smoke
FX.ChakraBurst = VFX.ChakraBurst
FX.Impact = VFX.Impact
FX.UpStreak = VFX.UpStreak
FX.Crater = VFX.Crater
FX.Dust = VFX.Dust
FX.Afterimage = VFX.Afterimage
FX.Aura = VFX.Aura
FX.Trails = function(model, on)
	VFX.Trails(model, on, Color3.fromRGB(200, 235, 255))
end
FX.Flash = function(strength)
	VFX.Flash(Color3.new(1, 1, 1), strength)
end
FX.Vanish = function(model, invisible)
	VFX.SetVisible(model, not invisible)
end
FX.HitStop = function(a, b, seconds)
	if a then
		Anim.Freeze(a, seconds)
	end
	if b then
		Anim.Freeze(b, seconds)
	end
end
FX.Damage = damageNumber
FX.Combo = function(n)
	if os.clock() - comboAt > 2 then
		combo = 0
	end
	combo += n
	comboAt = os.clock()
	comboLabel.Text = combo .. " HITS!"
	comboLabel.TextTransparency = 0
	local sc = comboLabel:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", comboLabel)
	sc.Scale = 1.5
	TweenService:Create(sc, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end
FX.DustTrail = function(model, duration)
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < duration and model.Parent do
			local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hrp then
				VFX.Dust(hrp.Position - Vector3.new(0, 2.5, 0), 0.7)
			end
			task.wait(0.06)
		end
	end)
end
FX.Toast = toast

Net.Get("Fx").OnClientEvent:Connect(function(name, ...)
	local fn = FX[name]
	if fn then
		local ok, err = pcall(fn, ...)
		if not ok then
			warn("[FX] " .. tostring(name) .. ": " .. tostring(err))
		end
	end
end)

-- ===================== Кинокамера суперудара =====================
local function cineSuper(char: Model, target: Model)
	local cam = workspace.CurrentCamera
	local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local thrp = target:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not cam or not hrp or not thrp then
		return
	end
	local base = thrp.Position
	local toA = (hrp.Position - base) * Vector3.new(1, 0, 1)
	toA = toA.Magnitude > 0.1 and toA.Unit or Vector3.new(0, 0, 1)
	local side = toA:Cross(Vector3.yAxis).Unit
	cam.CameraType = Enum.CameraType.Scriptable
	local t0 = os.clock()
	local total = 4.2
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		local t = os.clock() - t0
		local goal: CFrame
		local fov = 70
		if t < 0.6 then
			-- крупно: знак руками
			local p = hrp.Position
			goal = CFrame.lookAt(p + hrp.CFrame.LookVector * 7 + Vector3.new(0, 1.5, 0) + side * 2, p + Vector3.new(0, 1, 0))
			fov = 55
		elseif t < 2.7 then
			-- общий план сбоку: враг взлетает от подкатов
			local look = thrp.Position
			goal = CFrame.lookAt(base + side * 24 + toA * 6 + Vector3.new(0, 6 + (look.Y - base.Y) * 0.5, 0), look)
			fov = 62
		else
			-- снизу: прыжок и удар пяткой
			local mid = (hrp.Position + thrp.Position) / 2
			goal = CFrame.lookAt(base + side * 14 + toA * 10 + Vector3.new(0, 2, 0), mid)
			fov = 72
		end
		cam.CFrame = cam.CFrame:Lerp(goal, 1 - math.exp(-dt * 8))
		cam.FieldOfView += (fov - cam.FieldOfView) * (1 - math.exp(-dt * 6))
		if t > total or not char.Parent then
			conn:Disconnect()
			cam.CameraType = Enum.CameraType.Custom
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then
				cam.CameraSubject = hum
			end
			TweenService:Create(cam, TweenInfo.new(0.4), { FieldOfView = 70 }):Play()
		end
	end)
end

Net.Get("Cine").OnClientEvent:Connect(function(name, a, b)
	if name == "Super" then
		cineSuper(a, b)
	end
end)

-- ===================== Перезарядки на кнопках =====================
RunService.RenderStepped:Connect(function()
	local now = os.clock()
	for _, s in pairs(slots) do
		local left = s.ends - now
		if left > 0 then
			s.shade.Size = UDim2.fromScale(1, left / s.total)
			s.timer.Text = string.format("%.1f", left)
		else
			s.shade.Size = UDim2.fromScale(1, 0)
			s.timer.Text = ""
		end
	end
	if combo > 0 and now - comboAt > 2 then
		combo = 0
		TweenService:Create(comboLabel, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">VFX</string><ProtectedString name="Source"><![CDATA[-- Визуальные эффекты (только клиент). Всё из деталей и частиц — без загрузки ассетов.

local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local VFX = {}

local folder = Instance.new("Folder")
folder.Name = "VFX"
folder.Parent = workspace

local rng = Random.new()
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local TEX_FIRE = "rbxasset://textures/particles/fire_main.dds"

local CHAKRA = Color3.fromRGB(80, 190, 255)
VFX.CHAKRA = CHAKRA

local function part(props: { [string]: any }): BasePart
	local p = Instance.new(props.Class or "Part") :: BasePart
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		if k ~= "Class" and k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	p.Parent = props.Parent or folder
	return p
end

local function tween(obj: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end

local function emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 0
	pe.LightEmission = 0.6
	for k, v in pairs(props) do
		(pe :: any)[k] = v
	end
	pe.Parent = parent
	return pe
end

local function holder(pos: Vector3): BasePart
	return part({ Size = Vector3.new(0.2, 0.2, 0.2), Position = pos, Transparency = 1 })
end

-- ===== Камера =====
local shakeAmp = 0
local fovKick = 0
function VFX.Shake(power: number)
	shakeAmp = math.max(shakeAmp, power)
end
function VFX.FovKick(amount: number)
	fovKick = amount
end

RunService:BindToRenderStep("VFXCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	if shakeAmp > 0.01 then
		cam.CFrame = cam.CFrame * CFrame.Angles((rng:NextNumber() - 0.5) * shakeAmp * 0.04, (rng:NextNumber() - 0.5) * shakeAmp * 0.04, (rng:NextNumber() - 0.5) * shakeAmp * 0.02)
		shakeAmp *= math.exp(-dt * 7)
	end
	if math.abs(fovKick) > 0.05 then
		cam.FieldOfView = 70 + fovKick
		fovKick *= math.exp(-dt * 6)
	end
end)

-- ===== Вспышка экрана =====
function VFX.Flash(color: Color3?, strength: number?)
	local cc = Instance.new("ColorCorrectionEffect")
	cc.TintColor = color or Color3.new(1, 1, 1)
	cc.Brightness = strength or 0.4
	cc.Parent = Lighting
	tween(cc, 0.35, { Brightness = 0, TintColor = Color3.new(1, 1, 1) })
	Debris:AddItem(cc, 0.4)
end

-- ===== Дым (появление/исчезновение двойника) =====
function VFX.Smoke(pos: Vector3, scale: number?)
	local s = scale or 1
	for _ = 1, 14 do
		local d = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.3, 1), rng:NextNumber(-1, 1)).Unit
		local size = rng:NextNumber(2, 3.4) * s
		local puff = part({ Shape = Enum.PartType.Ball, Size = Vector3.one * size * 0.4, Position = pos + d * s, Color = Color3.fromRGB(235, 235, 240), Material = Enum.Material.SmoothPlastic, Transparency = 0.05 })
		tween(puff, rng:NextNumber(0.45, 0.7), { Size = Vector3.one * size * 1.4, Position = pos + d * s * 3.2 + Vector3.new(0, 1.5 * s, 0), Transparency = 1 })
		Debris:AddItem(puff, 0.75)
	end
	local ring = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 2 * s, 2 * s), CFrame = CFrame.new(pos - Vector3.new(0, 2.6 * s, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(240, 240, 245), Material = Enum.Material.Neon, Transparency = 0.3 })
	tween(ring, 0.5, { Size = Vector3.new(0.2, 12 * s, 12 * s), Transparency = 1 })
	Debris:AddItem(ring, 0.55)
	local h = holder(pos)
	emitter(h, { Texture = TEX_SMOKE, Color = ColorSequence.new(Color3.fromRGB(230, 230, 235)), Size = NumberSequence.new(3 * s, 6 * s),
		Transparency = NumberSequence.new(0.2, 1), Lifetime = NumberRange.new(0.5, 0.9), Speed = NumberRange.new(4, 9), SpreadAngle = Vector2.new(180, 180),
		LightEmission = 0.1, Drag = 3 }):Emit(18)
	Debris:AddItem(h, 1.2)
end

-- ===== Удар =====
-- pos — точка удара, dir — направление удара, power 1..3
function VFX.Impact(pos: Vector3, dir: Vector3?, power: number?, color: Color3?)
	local p = power or 1
	local col = color or Color3.fromRGB(255, 245, 220)
	local d = (dir and dir.Magnitude > 0.01) and dir.Unit or Vector3.new(0, 0, -1)
	-- белая вспышка
	local flash = part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 1.2 * p, Position = pos, Color = col, Material = Enum.Material.Neon })
	tween(flash, 0.18, { Size = Vector3.one * 5 * p, Transparency = 1 })
	Debris:AddItem(flash, 0.2)
	-- кольцо ударной волны поперёк удара
	local ring = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, 1.5 * p, 1.5 * p), CFrame = CFrame.lookAt(pos, pos + d) * CFrame.Angles(0, math.pi / 2, 0), Color = col, Material = Enum.Material.Neon, Transparency = 0.1 })
	tween(ring, 0.3, { Size = Vector3.new(0.05, 9 * p, 9 * p), Transparency = 1 })
	Debris:AddItem(ring, 0.32)
	-- лучи-штрихи во все стороны
	for _ = 1, math.floor(8 * p) do
		local r = (d + Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1)) * 1.3).Unit
		local len = rng:NextNumber(2, 4) * p
		local line = part({ Size = Vector3.new(0.12, 0.12, len), CFrame = CFrame.lookAt(pos + r * 0.5, pos + r * 2), Color = col, Material = Enum.Material.Neon })
		tween(line, 0.22, { CFrame = CFrame.lookAt(pos + r * (len + 2), pos + r * (len + 4)), Size = Vector3.new(0.03, 0.03, len * 0.3), Transparency = 1 })
		Debris:AddItem(line, 0.25)
	end
	-- искры
	local h = holder(pos)
	emitter(h, { Texture = TEX_SPARK, Color = ColorSequence.new(col), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5 * p), NumberSequenceKeypoint.new(1, 0) }),
		Lifetime = NumberRange.new(0.2, 0.5), Speed = NumberRange.new(20, 45), SpreadAngle = Vector2.new(180, 180), Drag = 6, LightEmission = 1 }):Emit(math.floor(25 * p))
	local light = Instance.new("PointLight")
	light.Color = col
	light.Range = 14 * p
	light.Brightness = 4
	light.Parent = h
	tween(light, 0.25, { Brightness = 0 })
	Debris:AddItem(h, 0.6)
	VFX.Shake(0.8 * p)
end

-- ===== Чакра-вспышка у рук (знак) =====
function VFX.ChakraBurst(pos: Vector3, scale: number?)
	local s = scale or 1
	local orb = part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.5, Position = pos, Color = CHAKRA, Material = Enum.Material.Neon })
	tween(orb, 0.25, { Size = Vector3.one * 7 * s, Transparency = 1 })
	Debris:AddItem(orb, 0.3)
	for i = 1, 2 do
		local ring = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 1, 1), CFrame = CFrame.new(pos) * CFrame.Angles(i * 1.1, i * 0.7, math.pi / 2), Color = CHAKRA, Material = Enum.Material.Neon, Transparency = 0.1 })
		tween(ring, 0.4, { Size = Vector3.new(0.05, 14 * s, 14 * s), Transparency = 1 })
		Debris:AddItem(ring, 0.45)
	end
	local h = holder(pos)
	emitter(h, { Texture = TEX_SPARK, Color = ColorSequence.new(CHAKRA, Color3.new(1, 1, 1)), Size = NumberSequence.new(0.6, 0), Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(12, 26), SpreadAngle = Vector2.new(180, 180), Drag = 4, LightEmission = 1 }):Emit(40)
	Debris:AddItem(h, 1)
end

-- ===== Аура чакры на персонаже =====
local auras = {} :: { [Model]: { Instance } }
function VFX.Aura(model: Model, on: boolean)
	if auras[model] then
		for _, inst in ipairs(auras[model]) do
			inst:Destroy()
		end
		auras[model] = nil
	end
	if not on then
		return
	end
	local list = {}
	for _, name in ipairs({ "UpperTorso", "LowerTorso", "LeftLowerLeg", "RightLowerLeg", "LeftLowerArm", "RightLowerArm" }) do
		local p = model:FindFirstChild(name)
		if p then
			local flames = emitter(p, { Texture = TEX_FIRE, Color = ColorSequence.new(Color3.fromRGB(140, 220, 255), CHAKRA),
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.1), NumberSequenceKeypoint.new(1, 0) }),
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) }),
				Lifetime = NumberRange.new(0.3, 0.55), Speed = NumberRange.new(2, 4), Acceleration = Vector3.new(0, 9, 0),
				SpreadAngle = Vector2.new(25, 25), LightEmission = 1, Rate = 45 })
			table.insert(list, flames)
		end
	end
	local torso = model:FindFirstChild("UpperTorso")
	if torso then
		local l = Instance.new("PointLight")
		l.Color = CHAKRA
		l.Range = 12
		l.Brightness = 2
		l.Parent = torso
		table.insert(list, l)
	end
	auras[model] = list
end

-- ===== Следы рук и ног =====
local trails = {} :: { [Model]: { Trail } }
function VFX.Trails(model: Model, on: boolean, color: Color3?)
	if not trails[model] then
		local list = {}
		for _, name in ipairs({ "RightHand", "LeftHand", "RightFoot", "LeftFoot" }) do
			local p = model:FindFirstChild(name)
			if p then
				local a0 = Instance.new("Attachment")
				a0.Position = Vector3.new(0, 0.35, 0)
				a0.Parent = p
				local a1 = Instance.new("Attachment")
				a1.Position = Vector3.new(0, -0.35, 0)
				a1.Parent = p
				local tr = Instance.new("Trail")
				tr.Attachment0 = a0
				tr.Attachment1 = a1
				tr.Lifetime = 0.18
				tr.LightEmission = 1
				tr.FaceCamera = true
				tr.Transparency = NumberSequence.new(0.15, 1)
				tr.Enabled = false
				tr.Parent = p
				table.insert(list, tr)
			end
		end
		trails[model] = list
	end
	for _, tr in ipairs(trails[model]) do
		tr.Color = ColorSequence.new(color or Color3.new(1, 1, 1))
		tr.Enabled = on
	end
end

-- ===== Удар ногой вверх: вертикальный росчерк =====
function VFX.UpStreak(pos: Vector3)
	local beam = part({ Size = Vector3.new(0.4, 14, 0.4), Position = pos + Vector3.new(0, 7, 0), Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon, Transparency = 0.1 })
	tween(beam, 0.3, { Size = Vector3.new(0.05, 22, 0.05), Position = pos + Vector3.new(0, 12, 0), Transparency = 1 })
	Debris:AddItem(beam, 0.32)
end

-- ===== Кратер от удара в землю =====
function VFX.Crater(pos: Vector3, radius: number?)
	local r = radius or 9
	local ground = Vector3.new(pos.X, pos.Y, pos.Z)
	-- тёмный круг
	local disc = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, r * 1.6, r * 1.6), CFrame = CFrame.new(ground + Vector3.new(0, 0.07, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(70, 60, 55), Material = Enum.Material.Slate })
	-- вздыбленные плиты по краю
	for i = 0, 13 do
		local a = i / 14 * math.pi * 2 + rng:NextNumber(-0.1, 0.1)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local sz = Vector3.new(rng:NextNumber(2, 3.5), rng:NextNumber(0.6, 1.2), rng:NextNumber(2, 4))
		local slab = part({ Size = sz, CFrame = CFrame.lookAt(ground + dir * r * 0.75, ground + dir * r * 2) * CFrame.Angles(math.rad(rng:NextNumber(20, 40)), 0, 0) + Vector3.new(0, 0.3, 0), Color = Color3.fromRGB(110, 100, 95), Material = Enum.Material.Slate })
		local target = slab.CFrame
		slab.CFrame = target - Vector3.new(0, 2, 0)
		tween(slab, 0.15, { CFrame = target }, Enum.EasingStyle.Back)
		task.delay(4, function()
			tween(slab, 1, { CFrame = target - Vector3.new(0, 2.5, 0), Transparency = 1 })
		end)
		Debris:AddItem(slab, 5.2)
	end
	task.delay(4, function()
		tween(disc, 1, { Transparency = 1 })
	end)
	Debris:AddItem(disc, 5.2)
	-- летящие обломки
	for _ = 1, 16 do
		local d = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.8, 1.8), rng:NextNumber(-1, 1)).Unit
		local s = rng:NextNumber(0.5, 1.4)
		local rock = Instance.new("Part")
		rock.Size = Vector3.new(s, s * 0.8, s)
		rock.CFrame = CFrame.new(ground + Vector3.new(0, 1, 0)) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0)
		rock.Color = Color3.fromRGB(120, 110, 100)
		rock.Material = Enum.Material.Slate
		rock.CanCollide = true
		rock.CanQuery = false
		rock.CollisionGroup = "Default"
		rock.AssemblyLinearVelocity = d * rng:NextNumber(35, 60)
		rock.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-10, 10), rng:NextNumber(-10, 10), rng:NextNumber(-10, 10))
		rock.Parent = folder
		Debris:AddItem(rock, 3)
	end
	-- пыль кольцом
	local h = holder(ground + Vector3.new(0, 1, 0))
	emitter(h, { Texture = TEX_SMOKE, Color = ColorSequence.new(Color3.fromRGB(180, 165, 150)), Size = NumberSequence.new(4, 9), Transparency = NumberSequence.new(0.2, 1),
		Lifetime = NumberRange.new(0.8, 1.4), Speed = NumberRange.new(25, 40), SpreadAngle = Vector2.new(5, 180), EmissionDirection = Enum.NormalId.Top,
		Drag = 4, LightEmission = 0 }):Emit(40)
	Debris:AddItem(h, 2)
	-- огромная ударная волна
	local wave = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 4, 4), CFrame = CFrame.new(ground + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon, Transparency = 0.1 })
	tween(wave, 0.45, { Size = Vector3.new(0.1, r * 6, r * 6), Transparency = 1 })
	Debris:AddItem(wave, 0.5)
	VFX.Shake(3)
	VFX.FovKick(10)
	VFX.Flash(Color3.new(1, 1, 1), 0.5)
end

-- ===== Остаточные силуэты при рывке =====
function VFX.Afterimage(model: Model, color: Color3?)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Transparency < 1 then
			local ghost = part({ Size = p.Size, CFrame = p.CFrame, Color = color or CHAKRA, Material = Enum.Material.Neon, Transparency = 0.45 })
			if p:IsA("MeshPart") then
				ghost:Destroy()
				ghost = part({ Size = p.Size * 0.9, CFrame = p.CFrame, Color = color or CHAKRA, Material = Enum.Material.Neon, Transparency = 0.45 })
			end
			tween(ghost, 0.35, { Transparency = 1 })
			Debris:AddItem(ghost, 0.4)
		end
	end
end

-- ===== Невидимость (рывок/уклонение) =====
function VFX.SetVisible(model: Model, visible: boolean)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") or p:IsA("Decal") then
			(p :: any).LocalTransparencyModifier = visible and 0 or 1
		end
	end
end

-- ===== Пыль из-под ног =====
function VFX.Dust(pos: Vector3, scale: number?)
	local s = scale or 1
	local h = holder(pos)
	emitter(h, { Texture = TEX_SMOKE, Color = ColorSequence.new(Color3.fromRGB(190, 175, 160)), Size = NumberSequence.new(1.5 * s, 4 * s), Transparency = NumberSequence.new(0.35, 1),
		Lifetime = NumberRange.new(0.4, 0.8), Speed = NumberRange.new(6, 12), SpreadAngle = Vector2.new(70, 70), EmissionDirection = Enum.NormalId.Top, Drag = 4, LightEmission = 0 }):Emit(math.floor(12 * s))
	Debris:AddItem(h, 1.2)
end

local _ = Players
return VFX
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>